/**
 * M2 台账相关命令的中文文本输出：我在哪 / 功能卡 / 里程碑 / 待办 / sync。
 * CLI 与 MCP 共用（MCP 另做 8k 字符截断）。
 */
import type { LedgerFeature, LedgerMilestone, TodoBinding, TodoItem, TodoReport, WhereAmI } from "../types.ts";
import type { SyncResult } from "../core/sync.ts";
import { fmtShort, LINK_MARK } from "./render.ts";
import { hangingWrap, outputWidth, renderTable, truncate, truncateMiddle, type Column } from "./table.ts";

export interface RenderOpts {
  width?: number;
  wide?: boolean;
}

const fit = (s: string, W: number, wide?: boolean) => (wide ? s : truncate(s, W));
const fitMid = (s: string, W: number, wide?: boolean) => (wide ? s : truncateMiddle(s, W));

/* ───────────── 我在哪 ───────────── */

export function renderWhereami(w: WhereAmI): string {
  const out = ["合流 · 我在哪", `  目录：${w.cwd}`];
  if (!w.project) {
    out.push(...w.notes.map((n) => `  ! ${n}`));
    return out.join("\n");
  }
  out.push(`  项目：${w.project.name}`);
  if (!w.repo) {
    out.push(...w.notes.map((n) => `  ! ${n}`));
    return out.join("\n");
  }
  const place = w.isMainCheckout ? "主目录" : `worktree ${w.worktree?.split("/").pop() ?? "?"}`;
  out.push(`  仓库：${w.repo.label}（${w.repo.id}）· ${place}`);
  const roleText = w.role === "main" ? "主线" : w.role === "integration" ? "集成分支" : w.role === "feature" ? "功能分支" : "";
  out.push(`  分支：${w.branch ?? (w.detached ? "（分离 HEAD）" : "未知")}${roleText ? `（${roleText}）` : ""}`);
  if (w.feature) {
    out.push(`  功能卡：${w.feature.id}「${w.feature.title}」· ${w.feature.status} · 验收 ${w.feature.acceptance}`);
    const ms = w.milestone ? `${w.milestone.id}${w.milestone.title ? ` ${w.milestone.title}` : ""}（${w.milestone.status}）` : (w.feature.milestone ?? "未预约");
    out.push(`  预约：${ms}`);
  } else if (w.role === "feature") {
    out.push("  功能卡：无");
  }
  const behind: string[] = [];
  if (w.behindMain !== null) behind.push(`主线 ${w.behindMain} 提交`);
  if (w.behindIntegration !== null) behind.push(`集成分支 ${w.behindIntegration} 提交`);
  if (behind.length) out.push(`  落后：${behind.join(" · ")}`);
  if (w.session) {
    const t = w.session.title ? `「${w.session.title}」` : "";
    out.push(`  会话：${t}${w.session.sessionId ?? w.session.cliSessionId ?? ""}`);
  }
  for (const n of w.notes) out.push(`  ! ${n}`);
  if (w.role === "feature" && !w.feature) {
    out.push(`  提示：本分支还没有功能卡 → heliu 新点子 "<一句话需求>"（自动绑定当前分支、预约下一版）`);
  }
  return out.join("\n");
}

/* ───────────── 功能卡 ───────────── */

export function bindingText(f: LedgerFeature): string {
  if (!f.bindings.length) return "—";
  const b = f.bindings[0]!;
  return `${b.repo}/${b.branch}${f.bindings.length > 1 ? ` (+${f.bindings.length - 1})` : ""}`;
}

export function renderFeatureLine(f: LedgerFeature): string {
  const ms = f.milestone ? `预约 ${f.milestone}` : "未预约";
  const bind = f.bindings.length ? ` · 绑定 ${f.bindings.map((b) => `${b.repo}/${b.branch}`).join("、")}` : " · 未绑定分支";
  return `${f.id}「${f.title}」· ${f.status} · ${ms}${bind}`;
}

export function renderFeatureTable(features: LedgerFeature[], opts: RenderOpts & { title?: string } = {}): string {
  const out = [opts.title ?? `合流 · 功能卡 ${features.length} 张`];
  if (!features.length) {
    out.push("  （没有功能卡：heliu 新点子 \"<一句话需求>\" 登记一张）");
    return out.join("\n");
  }
  const columns: Column[] = [
    { header: "卡号" },
    { header: "标题", max: 28 },
    { header: "状态" },
    { header: "预约" },
    { header: "验收" },
    { header: "绑定", max: 44, cut: "middle" },
    { header: "来源" },
  ];
  const rows = features.map((f) => [f.id, f.title, f.status, f.milestone ?? "—", f.acceptance, bindingText(f), f.source]);
  out.push(renderTable(columns, rows, { wide: opts.wide, indent: "  " }));
  return out.join("\n");
}

/* ───────────── 里程碑 ───────────── */

export function renderMilestones(
  list: LedgerMilestone[],
  counts: Array<{ id: string; todo: number; total: number }>,
  unreserved: number,
  opts: RenderOpts = {},
): string {
  const next = list.find((m) => m.status === "规划中");
  const out = [`合流 · 里程碑 ${list.length} 个${next ? `（下一版 = ${next.id}）` : "（还没有「规划中」的版本；新点子会自动建 vNext）"}`];
  if (!list.length) {
    out.push("  （没有里程碑：heliu milestone add v1.2 --title \"…\"）");
  } else {
    const columns: Column[] = [
      { header: "版本" },
      { header: "标题", max: 30 },
      { header: "状态" },
      { header: "目标日期" },
      { header: "集成分支", max: 36, cut: "middle" },
      { header: "待办/全部", align: "right" },
    ];
    const rows = list.map((m) => {
      const c = counts.find((x) => x.id === m.id) ?? { todo: 0, total: 0 };
      return [`${m.id}${m === next ? " ←下一版" : ""}`, m.title || "—", m.status, m.target_date ?? "—", m.integration_branch ?? "（用项目配置）", `${c.todo}/${c.total}`];
    });
    out.push(renderTable(columns, rows, { wide: opts.wide, indent: "  " }));
  }
  if (unreserved) out.push(`  未预约的功能卡 ${unreserved} 张（heliu 预约 <卡号> <版本>）`);
  out.push("  待办 = 预约到该版、状态为 想法/开发中/待合并 的卡（与 heliu 待办 同一口径）");
  out.push("  状态：规划中 → 冻结（不再接新预约）→ 合并中 → 已发布；合并时未兑现的功能自动顺延到下一版并标「从 vX 顺延」（M4）");
  return out.join("\n");
}

/* ───────────── 待办 ───────────── */

function bindingState(b: TodoBinding, precheck: boolean): string {
  if (!b.exists) return "分支已不存在";
  if (b.noCommits) return "尚无提交（与主线同点或自创建后未提交）";
  if (b.mergedState === "in_main") return "已进主线";
  if (b.mergedState === "in_integration") return "已进集成分支";
  const parts: string[] = [];
  if (b.behindIntegration !== null) parts.push(`落后集成分支 ${b.behindIntegration}`);
  else if (b.behindMain !== null) parts.push(`落后主线 ${b.behindMain}`);
  if (precheck && b.conflictFiles !== null) parts.push(b.conflictFiles > 0 ? `冲突 ${b.conflictFiles} 个文件` : "试合无冲突");
  return parts.join(" · ") || "独立未合并";
}

function todoItemLines(it: TodoItem, precheck: boolean, W: number, wide?: boolean): string[] {
  const tags: string[] = [it.status];
  if (it.note && it.group !== "mergeable") tags.push(it.note);
  if (it.rolledFrom.length) tags.push(`从 ${it.rolledFrom[it.rolledFrom.length - 1]} 顺延`);
  if (it.group === "stale" && it.idleDays !== null) tags.push(`${it.idleDays} 天没动静`);
  const out = [fit(`  - ${it.id} ${it.title} · ${tags.join(" · ")}`, W, wide)];
  if (!it.bindings.length) out.push("    （未绑定分支：heliu feature bind <卡号> 或在该分支的会话里登记）");
  for (const b of it.bindings) {
    const last = b === it.bindings[0] && it.lastActivityAt ? ` · 最后活动 ${fmtShort(it.lastActivityAt)}` : "";
    out.push("    " + fitMid(`${b.repoLabel} · ${b.branch} · ${bindingState(b, precheck)}${last}`, W - 4, wide));
  }
  if (it.needsAction) out.push(...(wide ? [`    需要你：${it.needsAction}`] : hangingWrap("    需要你：", it.needsAction, W)));
  return out;
}

export function renderTodo(projectName: string, t: TodoReport, opts: RenderOpts & { limitPerGroup?: number } = {}): string {
  const W = opts.width ?? outputWidth();
  const m = t.milestone;
  const isNext = ["next", "下一版", "下个版本", "下一个版本", "下版"].includes(t.requested.trim().toLowerCase());
  const head = `合流 · ${projectName} · 待办 ${m.id}${m.title ? ` ${m.title}` : ""}（${isNext ? "下一版 · " : ""}${m.status}）· 未合入 ${t.total} 条`;
  const out = [fit(head, W, opts.wide)];
  const nm = t.nextMilestone;
  out.push(nm ? `下一版 = ${nm.id}（${nm.status}）` : "下一版 = （还没有「规划中」的版本；登记新点子时自动建 vNext）");
  const overview = t.groups.map((g) => `${g.title} ${g.count === null ? "未检查" : g.count}`).join(" > ");
  out.push(...hangingWrap("概览：", `${overview}（按优先级排，每张卡只进最靠前的一组）`, W));
  out.push(...hangingWrap("顺延：", "某版合并时没合完的功能自动挪到下一版，标「从 vX 顺延」排在组内最前（M4 执行，不会静默丢弃）", W));
  const empty = t.groups.filter((g) => g.count === 0).map((g) => g.title);
  for (const g of t.groups) {
    if (g.count === 0) continue;
    out.push("");
    if (g.count === null) {
      out.push(`■ ${g.title}：未检查（加 --precheck 在临时对象区试合，不碰仓库）`);
      continue;
    }
    out.push(...hangingWrap("", `■ ${g.title}（${g.count}）· ${g.hint}`, W));
    const lim = opts.limitPerGroup ?? Infinity;
    if (g.key === "mergeable") {
      // 可合并细分：已进主线 / 已进集成分支 / 试合无冲突
      for (const sub of ["已进主线", "已进集成分支", "试合无冲突"]) {
        const list = g.items.filter((i) => (i.note ?? "试合无冲突") === sub);
        if (!list.length) continue;
        out.push(`  可合并 · ${sub}（${list.length}）`);
        for (const it of list.slice(0, lim)) out.push(...todoItemLines(it, t.precheck, W, opts.wide));
        if (list.length > lim) out.push(`  …还有 ${list.length - lim} 条（终端运行 heliu 待办 ${m.id} 查看全部）`);
        const sug = list.filter((i) => i.suggestion);
        if (sug.length) {
          const what = sub === "已进主线" ? "已进主线" : "已合入";
          out.push(...hangingWrap("  建议：", `以上 ${sug.length} 张卡的分支${sub === "已进主线" ? "已进主线" : "已被集成分支包含"}，是否标为${what}？（heliu feature status <卡号> ${what}；台账状态只由你改，heliu 不自动改）`, W));
        }
      }
      continue;
    }
    for (const it of g.items.slice(0, lim)) out.push(...todoItemLines(it, t.precheck, W, opts.wide));
    if (g.items.length > lim) out.push(`  …还有 ${g.items.length - lim} 条（终端运行 heliu 待办 ${m.id} 查看全部）`);
  }
  if (empty.length) out.push("", `（暂无：${empty.join("、")}）`);
  if (!t.total) out.push("", `（${m.id} 还没有预约任何功能：heliu 新点子 "<一句话需求>" 会默认预约到下一版）`);
  out.push("", "提示：heliu 预约 <卡号> <版本> 改预约 · heliu feature list 看全部卡 · --json 输出完整字段");
  return out.join("\n");
}

/* ───────────── sync ───────────── */

/** local_463463d5-740a-… → local_463463d5（完整 id 见 --json 与卡片） */
export function shortSession(id: string): string {
  const m = /^(local_)?([0-9a-f]{8})-[0-9a-f-]{20,}$/i.exec(id);
  return m ? `${m[1] ?? ""}${m[2]}` : id;
}

export function renderSync(projectName: string, r: SyncResult, opts: RenderOpts = {}): string {
  const W = opts.width ?? outputWidth();
  const out = [`合流 · ${projectName} · sync${r.dryRun ? "（预演，不写入）" : ""}`];
  const ms = r.milestone ? `${r.milestone}（下一版）` : "vNext（下一版；还没有「规划中」的版本，写入时自动创建）";
  out.push(`${r.dryRun ? "将建" : "已建"}草稿卡 ${r.drafts.length} 张 → 预约 ${ms}`);
  const s = r.skipped;
  out.push(`跳过：已有功能卡 ${s.hasCard} · 已进主线（有独有提交且已合入）${s.inMain} · 没有独立 worktree ${s.noWorktree} · 主线/集成分支 ${s.notFeature}`);
  const zero = r.drafts.filter((d) => d.noCommits).length;
  if (zero) out.push(`其中 ${zero} 张的分支尚无独有提交（与主线同点或自创建后未提交），按「开发中」登记`);
  out.push(`台账：${r.ledgerDir}`);
  const byRepo = new Map<string, typeof r.drafts>();
  for (const d of r.drafts) byRepo.set(d.repoLabel, [...(byRepo.get(d.repoLabel) ?? []), d]);
  for (const [label, list] of byRepo) {
    out.push("", `■ ${label}（${list.length}）`);
    for (const d of list) {
      const id = d.id ? `${d.id} ` : "";
      out.push(fit(`  - ${id}${d.title} · ${d.status}${d.noCommits ? " · 尚无提交" : ""}${d.titleSource === "label" ? " · 标题取自分支标签" : ""}`, W, opts.wide));
      const sess = d.session ? ` · 会话 ${shortSession(d.session)}（${LINK_MARK[d.sessionLink ?? "branch"]}）` : " · 无关联会话";
      const pr = d.pr !== null ? ` · PR #${d.pr}` : "";
      out.push("    " + fitMid(`${d.branch}${sess}${pr}`, W - 4, opts.wide));
    }
  }
  out.push("");
  out.push(
    r.dryRun
      ? "下一步：去掉 --dry-run 写入；写入后逐条确认标题与预约（heliu feature list；heliu 预约 <卡号> <版本>；heliu feature rename <卡号> <新标题>）"
      : "下一步：逐条确认标题与预约（heliu feature rename <卡号> <新标题>；heliu 预约 <卡号> <版本>）；草稿标记 source: sync",
  );
  return out.join("\n");
}

/** MCP 返回文本上限：超出截断并提示用 CLI --json */
export const MCP_TEXT_LIMIT = 8000;
export function clampText(text: string, cliHint: string, limit = MCP_TEXT_LIMIT): string {
  if (text.length <= limit) return text;
  const tail = `\n…（已截断：共 ${text.length} 字符，超过 ${limit}。完整内容请在终端运行 \`${cliHint} --json\`）`;
  const cut = text.slice(0, limit - tail.length);
  return cut.slice(0, cut.lastIndexOf("\n") > 0 ? cut.lastIndexOf("\n") : cut.length) + tail;
}
/**
 * sync：自动草稿——把「在 worktree 里开发、还没有功能卡、也没进主线」的分支登记成草稿卡。
 *
 * - 标题：关联会话标题（关联来源优先级 记录 > 写入 > 目录），没有会话则用 M1 标签。
 * - 状态：主会话 status_category=completed → 待合并；其余（含 blocked）→ 开发中。
 * - 预约：下一版（next）；来源 source: sync。
 * - 绑定：repo / branch / worktree / session / pr。
 * - 去重：按 仓库 + 分支，已有卡片（任何状态，含已放弃）的分支不再建。
 * - 「未进主线」按承诺层口径：尚无独有提交的分支（与主线同点 / reflog 显示自创建后未提交）虽然 git 祖先判断为
 *   「已进主线」，但没有任何工作被合入，照样建草稿（标「尚无提交」，状态 开发中）。
 * - dry-run：只列出将要建的草稿，不写任何文件（包括不自动建 vNext）。
 */
import type { FeatureBinding, FeatureStatus, FeatureView, LedgerFeature, SessionLink } from "../types.ts";
import { humanizeBranch } from "./labels.ts";
import { Ledger } from "./ledger.ts";
import { bindingKey, sourceBranchIndex, zeroCommitBranches } from "./owncommits.ts";
import type { HeliuPaths } from "./paths.ts";
import type { ProjectConfig } from "./project.ts";
import { reconcile, type ReconcileResult } from "./reconcile.ts";

export interface SyncDraft {
  repo: string;
  repoLabel: string;
  branch: string;
  worktree: string;
  session: string | null;
  sessionTitle: string | null;
  /** 会话与分支的关联来源 */
  sessionLink: SessionLink | null;
  sessionStatus: string | null;
  title: string;
  titleSource: "session" | "label";
  status: FeatureStatus;
  pr: number | null;
  lastCommitAt: string | null;
  mergedState: FeatureView["mergedState"];
  /** 尚无独有提交（与主线同点或自创建后未提交） */
  noCommits: boolean;
  /** 写入后的卡号（dry-run 为 null） */
  id: string | null;
}

export interface SyncResult {
  dryRun: boolean;
  ledgerDir: string;
  /** 草稿预约到的里程碑 id（dry-run 且尚无「规划中」时为 null，表示将自动建 vNext） */
  milestone: string | null;
  milestoneWillBeCreated: boolean;
  drafts: SyncDraft[];
  skipped: { hasCard: number; inMain: number; noWorktree: number; notFeature: number };
  created: LedgerFeature[];
}

export interface SyncOptions {
  dryRun: boolean;
  now?: Date;
  /** 已有对账结果（测试/复用），缺省现跑一次（不预检、不做脏检查） */
  reconciled?: ReconcileResult;
}

/** 收集草稿候选（纯函数，便于测试） */
export function collectDrafts(
  _project: ProjectConfig,
  rec: ReconcileResult,
  existing: LedgerFeature[],
  zeroCommit: Set<string> = new Set(),
): { drafts: SyncDraft[]; skipped: SyncResult["skipped"] } {
  const skipped = { hasCard: 0, inMain: 0, noWorktree: 0, notFeature: 0 };
  const bound = new Set<string>();
  for (const f of existing) for (const b of f.bindings) bound.add(`${b.repo}\u0000${b.branch}`);
  const drafts: SyncDraft[] = [];
  const statusById = new Map(rec.sessions.map((s) => [s.sessionId, s]));
  for (const repo of rec.report.repos) {
    if (!repo.reachable) continue;
    const ordered = [...repo.branches].sort((a, b) => (a.lastCommitAt ?? "").localeCompare(b.lastCommitAt ?? "") || a.branch.localeCompare(b.branch));
    for (const fv of ordered) {
      if (fv.role !== "feature") {
        skipped.notFeature++;
        continue;
      }
      const noCommits = zeroCommit.has(bindingKey(repo.id, fv.branch));
      if (fv.mergedState === "in_main" && !noCommits) {
        skipped.inMain++;
        continue;
      }
      if (!fv.worktree || fv.worktree.isMain) {
        skipped.noWorktree++;
        continue;
      }
      const key = `${repo.id}\u0000${fv.branch}`;
      if (bound.has(key)) {
        skipped.hasCard++;
        continue;
      }
      bound.add(key);
      // FeatureView.sessions 已按 记录 > 写入 > 目录、未归档优先、最后活动倒序排好
      const s = fv.sessions[0] ?? null;
      const sv = s ? statusById.get(s.sessionId) : undefined;
      // 尚无提交的分支没有自己的提交主题，M1 标签会落到主线最后一条提交上，改用分支名
      const title = s?.title?.trim() || (noCommits ? humanizeBranch(fv.branch) : fv.label);
      const pr = s?.prs.find((p) => !p.branch || p.branch === fv.branch)?.number ?? null;
      drafts.push({
        repo: repo.id,
        repoLabel: repo.label,
        branch: fv.branch,
        worktree: fv.worktree.path,
        session: s?.sessionId ?? null,
        sessionTitle: s?.title ?? null,
        sessionLink: s?.link ?? null,
        sessionStatus: s?.statusCategory ?? sv?.statusCategory ?? null,
        title,
        titleSource: s?.title?.trim() ? "session" : "label",
        status: !noCommits && (s?.statusCategory ?? null) === "completed" ? "待合并" : "开发中",
        pr,
        lastCommitAt: fv.lastCommitAt,
        mergedState: fv.mergedState,
        noCommits,
        id: null,
      });
    }
  }
  return { drafts, skipped };
}

export async function syncLedger(project: ProjectConfig, paths: HeliuPaths, opts: SyncOptions): Promise<SyncResult> {
  const ledger = Ledger.of(project);
  const rec = opts.reconciled ?? (await reconcile(project, paths, { precheck: false, dirty: false, timeoutMs: 8000 }));
  const existing = ledger.load().features;
  // 已被主线/集成分支包含、有独立 worktree 的功能分支：判定是否「尚无独有提交」
  const candidates = rec.report.repos.flatMap((r) =>
    r.reachable ? r.branches.filter((b) => b.role === "feature" && b.mergedState !== "unmerged" && b.worktree && !b.worktree.isMain).map((b) => ({ repo: r.id, branch: b.branch })) : [],
  );
  const zero = await zeroCommitBranches(rec.report, candidates, { sourceOf: sourceBranchIndex(paths, rec.report) });
  const { drafts, skipped } = collectDrafts(project, rec, existing, zero);
  const next = ledger.resolveMilestone("next", { create: false });
  const result: SyncResult = {
    dryRun: opts.dryRun,
    ledgerDir: ledger.dir,
    milestone: next?.milestone.id ?? null,
    milestoneWillBeCreated: !next,
    drafts,
    skipped,
    created: [],
  };
  if (opts.dryRun || !drafts.length) return result;

  for (const d of drafts) {
    const binding: FeatureBinding = { repo: d.repo, branch: d.branch, worktree: d.worktree, session: d.session, pr: d.pr };
    const why = d.titleSource === "session" ? `会话「${d.sessionTitle}」` : "分支标签（无关联会话）";
    const body = `${d.title}\n\n> 由 heliu sync 自动生成的草稿：标题取自${why}${d.noCommits ? "；分支尚无独有提交" : ""}。请确认标题与预约版本（heliu 预约 <卡号> <版本>）。`;
    const { feature, milestoneCreated } = ledger.addFeature({ title: d.title, milestone: "next", bindings: [binding], body, source: "sync", status: d.status, now: opts.now });
    if (milestoneCreated) {
      result.milestone = milestoneCreated.id;
    }
    d.id = feature.id;
    result.created.push(feature);
  }
  result.milestoneWillBeCreated = false;
  return result;
}
/**
 * heliu CLI 入口。
 * M1（只读对账）：heliu status|branches|sessions|hygiene|doctor|project add <path>|project list
 * M2（台账）：heliu init | feature add|list|reserve|bind|status|accept|rename | milestone add|list|todo|freeze|rename
 *            | sync [--dry-run] | whereami | mcp
 * 中文别名：新点子 "<标题>" [--预约 v1.2] · 待办 [v1.2|下一版] · 预约 F-0003 v1.3 · 我在哪
 * 全局：--project <name>  --cwd <dir>  --json  --precheck  --dirty  --timeout <ms>  --wide
 */
import { Command, Option } from "commander";
import { writeSync } from "node:fs";
import { runDoctor } from "../core/doctor.ts";
import { DEFAULT_TIMEOUT_MS } from "../core/git.ts";
import { heliuPaths } from "../core/paths.ts";
import { addRepoToProject, listProjectNames, loadProject, ProjectError, resolveProject, type ProjectConfig } from "../core/project.ts";
import { reconcile } from "../core/reconcile.ts";
import { SCHEMA_VERSION, type JsonEnvelope, type MergedState, type ProjectRef, type ScanOptions } from "../types.ts";
import {
  opFeatureAdd,
  opFeatureBind,
  opFeatureList,
  opFeatureReserve,
  opFeatureSet,
  opInit,
  opMilestoneAdd,
  opMilestoneFreeze,
  opMilestoneList,
  opMilestoneRename,
  opMilestoneTodo,
  opSync,
  opWhereami,
  type OpContext,
  type OpResult,
} from "../app/ops.ts";
import {
  LEGEND,
  renderBranchTable,
  renderDoctor,
  renderHeader,
  renderHygiene,
  renderSessions,
  renderStatusFull,
  renderStatusSummary,
  repoTitle,
} from "./render.ts";

interface GlobalOpts {
  project?: string;
  cwd?: string;
  json?: boolean;
  precheck?: boolean;
  dirty?: boolean;
  timeout?: string;
  wide?: boolean;
}

function envelope<T>(command: string, project: ProjectRef | null, data: T): JsonEnvelope<T> {
  return { schemaVersion: SCHEMA_VERSION, command, generatedAt: new Date().toISOString(), project, data };
}

/**
 * 输出先进缓冲，命令结束后同步写完再退出：
 * 管道写是异步的，process.exit 会把超过 64KB 的 --json 输出截断；
 * 实测 Bun 1.3.4 的 Bun.write(Bun.stdout) 在管道满时会从头重写，故用 writeSync 按字节偏移循环写。
 */
const outBuf: string[] = [];
function out(text: string): void {
  outBuf.push(text.endsWith("\n") ? text : text + "\n");
}
function printJson(v: unknown): void {
  out(JSON.stringify(v, null, 2));
}

function scanOptions(g: GlobalOpts): ScanOptions {
  const t = Number(g.timeout ?? DEFAULT_TIMEOUT_MS);
  return { precheck: !!g.precheck, dirty: !!g.dirty, timeoutMs: Number.isFinite(t) && t > 0 ? t : DEFAULT_TIMEOUT_MS };
}

async function project(g: GlobalOpts): Promise<ProjectConfig> {
  return resolveProject(heliuPaths(), g.project, g.cwd ?? process.cwd());
}

/** 台账类命令的上下文（与 MCP 共用 src/app/ops.ts） */
function opCtx(g: GlobalOpts): OpContext {
  return { paths: heliuPaths(), cwd: g.cwd ?? process.cwd(), projectName: g.project, source: "cli", render: { wide: g.wide } };
}

/** 输出：--json 走稳定外壳，否则中文文本 */
function emit(g: GlobalOpts, command: string, r: OpResult): void {
  if (g.json) printJson(envelope(command, r.project, r.data));
  else out(r.text);
}

const program = new Command();
program
  .name("heliu")
  .description("合流：分支 × worktree × 桌面会话 对账单 + 功能卡/版本台账")
  .version("0.2.0", "-V, --version", "显示版本")
  .helpOption("-h, --help", "显示帮助")
  .addHelpCommand(false)
  .option("-p, --project <name>", "项目名（默认按当前目录自动识别）")
  .option("--cwd <dir>", "按这个目录识别项目与当前分支（默认当前目录）")
  .option("--json", "输出稳定 JSON（schemaVersion=1）")
  .option("--precheck", "对未合并分支跑 merge-tree 试合，统计冲突文件数（在临时对象区进行）")
  .option("--dirty", "iCloud 仓也做工作区脏检查（可能较慢）")
  .option("--timeout <ms>", "单条 git 命令超时（毫秒）", String(DEFAULT_TIMEOUT_MS))
  .option("--wide", "表格不截断");

const globals = (cmd: Command): GlobalOpts => cmd.optsWithGlobals() as GlobalOpts;

program
  .command("status")
  .description("健康条 + 行动摘要（等你处理 / 独立未合并 / 已进集成待回主线 / 落后需同步）")
  .option("--full", "改为显示每个仓库的全部分支长表")
  .action(async (o: { full?: boolean }, cmd: Command) => {
    const g = globals(cmd);
    const p = await project(g);
    const { report, sessions } = await reconcile(p, heliuPaths(), scanOptions(g));
    if (g.json) printJson(envelope("status", report.project, report));
    else if (o.full) out(renderStatusFull(report, { wide: g.wide }));
    else out(renderStatusSummary(report, { wide: g.wide, sessions }));
  });

program
  .command("branches")
  .description("只看分支表（可按仓库、合并状态过滤）")
  .addOption(new Option("--repo <id>", "只看某个仓库"))
  .addOption(new Option("--state <state>", "按合并状态过滤").choices(["in_main", "in_integration", "unmerged"]))
  .action(async (o: { repo?: string; state?: MergedState }, cmd: Command) => {
    const g = globals(cmd);
    const p = await project(g);
    const { report } = await reconcile(p, heliuPaths(), scanOptions(g));
    const repos = report.repos.filter((r) => !o.repo || r.id === o.repo);
    if (o.repo && !repos.length) throw new ProjectError(`项目中没有仓库 ${o.repo}（可选：${report.repos.map((r) => r.id).join("、")}）`);
    const filter = (b: { mergedState: MergedState }) => !o.state || b.mergedState === o.state;
    if (g.json) {
      printJson(
        envelope("branches", report.project, {
          repos: repos.map((r) => ({ id: r.id, label: r.label, reachable: r.reachable, error: r.error, counts: r.counts, branches: r.branches.filter(filter) })),
        }),
      );
      return;
    }
    const parts = [renderHeader(report), LEGEND];
    for (const r of repos) {
      parts.push("", repoTitle(r));
      if (!r.reachable) parts.push(`  ✗ ${r.error ?? "不可达"}，已跳过`);
      else parts.push(renderBranchTable(r, { wide: g.wide, filter }));
    }
    out(parts.join("\n"));
  });

program
  .command("sessions")
  .description("本项目的桌面会话：默认列出全部「等你处理」与「运行中」，完整显示待办文案")
  .option("--all", "再列出其余会话（待验收 / 已完成 / 已归档）")
  .action(async (o: { all?: boolean }, cmd: Command) => {
    const g = globals(cmd);
    const p = await project(g);
    const { report, sessions } = await reconcile(p, heliuPaths(), { ...scanOptions(g), precheck: false, dirty: false });
    if (g.json) printJson(envelope("sessions", report.project, { total: sessions.length, sessions }));

