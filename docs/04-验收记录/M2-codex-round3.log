/**
 * M2 台账相关命令的中文文本输出：我在哪 / 功能卡 / 里程碑 / 待办 / sync。
 * CLI 与 MCP 共用（MCP 另做 8k 字符截断）。
 */
import type { LedgerFeature, LedgerMilestone, TodoBinding, TodoItem, TodoReport, WhereAmI } from "../types.ts";
import type { SyncResult } from "../core/sync.ts";
import { fmtShort, LINK_MARK } from "./render.ts";
import { hangingWrap, outputWidth, renderTable, truncate, truncateMiddle, type Column } from "./table.ts";

export interface RenderOpts {
  width?: number;
  wide?: boolean;
}

const fit = (s: string, W: number, wide?: boolean) => (wide ? s : truncate(s, W));
const fitMid = (s: string, W: number, wide?: boolean) => (wide ? s : truncateMiddle(s, W));

/* ───────────── 我在哪 ───────────── */

export function renderWhereami(w: WhereAmI): string {
  const out = ["合流 · 我在哪", `  目录：${w.cwd}`];
  if (!w.project) {
    out.push(...w.notes.map((n) => `  ! ${n}`));
    return out.join("\n");
  }
  out.push(`  项目：${w.project.name}`);
  if (!w.repo) {
    out.push(...w.notes.map((n) => `  ! ${n}`));
    return out.join("\n");
  }
  const place = w.isMainCheckout ? "主目录" : `worktree ${w.worktree?.split("/").pop() ?? "?"}`;
  out.push(`  仓库：${w.repo.label}（${w.repo.id}）· ${place}`);
  const roleText = w.role === "main" ? "主线" : w.role === "integration" ? "集成分支" : w.role === "feature" ? "功能分支" : "";
  out.push(`  分支：${w.branch ?? (w.detached ? "（分离 HEAD）" : "未知")}${roleText ? `（${roleText}）` : ""}`);
  if (w.feature) {
    out.push(`  功能卡：${w.feature.id}「${w.feature.title}」· ${w.feature.status} · 验收 ${w.feature.acceptance}`);
    const ms = w.milestone ? `${w.milestone.id}${w.milestone.title ? ` ${w.milestone.title}` : ""}（${w.milestone.status}）` : (w.feature.milestone ?? "未预约");
    out.push(`  预约：${ms}`);
  } else if (w.role === "feature") {
    out.push("  功能卡：无");
  }
  const behind: string[] = [];
  if (w.behindMain !== null) behind.push(`主线 ${w.behindMain} 提交`);
  if (w.behindIntegration !== null) behind.push(`集成分支 ${w.behindIntegration} 提交`);
  if (behind.length) out.push(`  落后：${behind.join(" · ")}`);
  if (w.session) {
    const t = w.session.title ? `「${w.session.title}」` : "";
    out.push(`  会话：${t}${w.session.sessionId ?? w.session.cliSessionId ?? ""}`);
  }
  for (const n of w.notes) out.push(`  ! ${n}`);
  if (w.role === "feature" && !w.feature) {
    out.push(`  提示：本分支还没有功能卡 → heliu 新点子 "<一句话需求>"（自动绑定当前分支、预约下一版）`);
  }
  return out.join("\n");
}

/* ───────────── 功能卡 ───────────── */

export function bindingText(f: LedgerFeature): string {
  if (!f.bindings.length) return "—";
  const b = f.bindings[0]!;
  return `${b.repo}/${b.branch}${f.bindings.length > 1 ? ` (+${f.bindings.length - 1})` : ""}`;
}

export function renderFeatureLine(f: LedgerFeature): string {
  const ms = f.milestone ? `预约 ${f.milestone}` : "未预约";
  const bind = f.bindings.length ? ` · 绑定 ${f.bindings.map((b) => `${b.repo}/${b.branch}`).join("、")}` : " · 未绑定分支";
  return `${f.id}「${f.title}」· ${f.status} · ${ms}${bind}`;
}

export function renderFeatureTable(features: LedgerFeature[], opts: RenderOpts & { title?: string } = {}): string {
  const out = [opts.title ?? `合流 · 功能卡 ${features.length} 张`];
  if (!features.length) {
    out.push("  （没有功能卡：heliu 新点子 \"<一句话需求>\" 登记一张）");
    return out.join("\n");
  }
  const columns: Column[] = [
    { header: "卡号" },
    { header: "标题", max: 28 },
    { header: "状态" },
    { header: "预约" },
    { header: "验收" },
    { header: "绑定", max: 44, cut: "middle" },
    { header: "来源" },
  ];
  const rows = features.map((f) => [f.id, f.title, f.status, f.milestone ?? "—", f.acceptance, bindingText(f), f.source]);
  out.push(renderTable(columns, rows, { wide: opts.wide, indent: "  " }));
  return out.join("\n");
}

/* ───────────── 里程碑 ───────────── */

export function renderMilestones(
  list: LedgerMilestone[],
  counts: Array<{ id: string; todo: number; total: number }>,
  unreserved: number,
  opts: RenderOpts = {},
): string {
  const next = list.find((m) => m.status === "规划中");
  const out = [`合流 · 里程碑 ${list.length} 个${next ? `（下一版 = ${next.id}）` : "（还没有「规划中」的版本；新点子会自动建 vNext）"}`];
  if (!list.length) {
    out.push("  （没有里程碑：heliu milestone add v1.2 --title \"…\"）");
  } else {
    const columns: Column[] = [
      { header: "版本" },
      { header: "标题", max: 30 },
      { header: "状态" },
      { header: "目标日期" },
      { header: "集成分支", max: 36, cut: "middle" },
      { header: "待办/全部", align: "right" },
    ];
    const rows = list.map((m) => {
      const c = counts.find((x) => x.id === m.id) ?? { todo: 0, total: 0 };
      return [`${m.id}${m === next ? " ←下一版" : ""}`, m.title || "—", m.status, m.target_date ?? "—", m.integration_branch ?? "（用项目配置）", `${c.todo}/${c.total}`];
    });
    out.push(renderTable(columns, rows, { wide: opts.wide, indent: "  " }));
  }
  if (unreserved) out.push(`  未预约的功能卡 ${unreserved} 张（heliu 预约 <卡号> <版本>）`);
  out.push("  待办 = 预约到该版、状态为 想法/开发中/待合并 的卡（与 heliu 待办 同一口径）");
  out.push("  状态：规划中 → 冻结（不再接新预约）→ 合并中 → 已发布；合并时未兑现的功能自动顺延到下一版并标「从 vX 顺延」（M4）");
  return out.join("\n");
}

/* ───────────── 待办 ───────────── */

function bindingState(b: TodoBinding, precheck: boolean): string {
  if (!b.exists) return "分支已不存在";
  if (b.noCommits) return "尚无提交（与主线同点或自创建后未提交）";
  if (b.mergedState === "in_main") return "已进主线";
  if (b.mergedState === "in_integration") return "已进集成分支";
  const parts: string[] = [];
  if (b.behindIntegration !== null) parts.push(`落后集成分支 ${b.behindIntegration}`);
  else if (b.behindMain !== null) parts.push(`落后主线 ${b.behindMain}`);
  if (precheck && b.conflictFiles !== null) parts.push(b.conflictFiles > 0 ? `冲突 ${b.conflictFiles} 个文件` : "试合无冲突");
  return parts.join(" · ") || "独立未合并";
}

function todoItemLines(it: TodoItem, precheck: boolean, W: number, wide?: boolean): string[] {
  const tags: string[] = [it.status];
  if (it.note && it.group !== "mergeable") tags.push(it.note);
  if (it.rolledFrom.length) tags.push(`从 ${it.rolledFrom[it.rolledFrom.length - 1]} 顺延`);
  if (it.group === "stale" && it.idleDays !== null) tags.push(`${it.idleDays} 天没动静`);
  const out = [fit(`  - ${it.id} ${it.title} · ${tags.join(" · ")}`, W, wide)];
  if (!it.bindings.length) out.push("    （未绑定分支：heliu feature bind <卡号> 或在该分支的会话里登记）");
  for (const b of it.bindings) {
    const last = b === it.bindings[0] && it.lastActivityAt ? ` · 最后活动 ${fmtShort(it.lastActivityAt)}` : "";
    out.push("    " + fitMid(`${b.repoLabel} · ${b.branch} · ${bindingState(b, precheck)}${last}`, W - 4, wide));
  }
  if (it.needsAction) out.push(...(wide ? [`    需要你：${it.needsAction}`] : hangingWrap("    需要你：", it.needsAction, W)));
  return out;
}

export function renderTodo(projectName: string, t: TodoReport, opts: RenderOpts & { limitPerGroup?: number } = {}): string {
  const W = opts.width ?? outputWidth();
  const m = t.milestone;
  const isNext = ["next", "下一版", "下个版本", "下一个版本", "下版"].includes(t.requested.trim().toLowerCase());
  const head = `合流 · ${projectName} · 待办 ${m.id}${m.title ? ` ${m.title}` : ""}（${isNext ? "下一版 · " : ""}${m.status}）· 未合入 ${t.total} 条`;
  const out = [fit(head, W, opts.wide)];
  const nm = t.nextMilestone;
  out.push(nm ? `下一版 = ${nm.id}（${nm.status}）` : "下一版 = （还没有「规划中」的版本；登记新点子时自动建 vNext）");
  const overview = t.groups.map((g) => `${g.title} ${g.count === null ? "未检查" : g.count}`).join(" > ");
  out.push(...hangingWrap("概览：", `${overview}（按优先级排，每张卡只进最靠前的一组）`, W));
  out.push(...hangingWrap("顺延：", "某版合并时没合完的功能自动挪到下一版，标「从 vX 顺延」排在组内最前（M4 执行，不会静默丢弃）", W));
  const empty = t.groups.filter((g) => g.count === 0).map((g) => g.title);
  for (const g of t.groups) {
    if (g.count === 0) continue;
    out.push("");
    if (g.count === null) {
      out.push(`■ ${g.title}：未检查（加 --precheck 在临时对象区试合，不碰仓库）`);
      continue;
    }
    out.push(...hangingWrap("", `■ ${g.title}（${g.count}）· ${g.hint}`, W));
    const lim = opts.limitPerGroup ?? Infinity;
    if (g.key === "mergeable") {
      // 可合并细分：已进主线 / 已进集成分支 / 试合无冲突
      for (const sub of ["已进主线", "已进集成分支", "试合无冲突"]) {
        const list = g.items.filter((i) => (i.note ?? "试合无冲突") === sub);
        if (!list.length) continue;
        out.push(`  可合并 · ${sub}（${list.length}）`);
        for (const it of list.slice(0, lim)) out.push(...todoItemLines(it, t.precheck, W, opts.wide));
        if (list.length > lim) out.push(`  …还有 ${list.length - lim} 条（终端运行 heliu 待办 ${m.id} 查看全部）`);
        const sug = list.filter((i) => i.suggestion);
        if (sug.length) {
          const what = sub === "已进主线" ? "已进主线" : "已合入";
          out.push(...hangingWrap("  建议：", `以上 ${sug.length} 张卡的分支${sub === "已进主线" ? "已进主线" : "已被集成分支包含"}，是否标为${what}？（heliu feature status <卡号> ${what}；台账状态只由你改，heliu 不自动改）`, W));
        }
      }
      continue;
    }
    for (const it of g.items.slice(0, lim)) out.push(...todoItemLines(it, t.precheck, W, opts.wide));
    if (g.items.length > lim) out.push(`  …还有 ${g.items.length - lim} 条（终端运行 heliu 待办 ${m.id} 查看全部）`);
  }
  if (empty.length) out.push("", `（暂无：${empty.join("、")}）`);
  if (!t.total) out.push("", `（${m.id} 还没有预约任何功能：heliu 新点子 "<一句话需求>" 会默认预约到下一版）`);
  out.push("", "提示：heliu 预约 <卡号> <版本> 改预约 · heliu feature list 看全部卡 · --json 输出完整字段");
  return out.join("\n");
}

/* ───────────── sync ───────────── */

/** local_463463d5-740a-… → local_463463d5（完整 id 见 --json 与卡片） */
export function shortSession(id: string): string {
  const m = /^(local_)?([0-9a-f]{8})-[0-9a-f-]{20,}$/i.exec(id);
  return m ? `${m[1] ?? ""}${m[2]}` : id;
}

export function renderSync(projectName: string, r: SyncResult, opts: RenderOpts = {}): string {
  const W = opts.width ?? outputWidth();
  const out = [`合流 · ${projectName} · sync${r.dryRun ? "（预演，不写入）" : ""}`];
  const ms = r.milestone ? `${r.milestone}（下一版）` : "vNext（下一版；还没有「规划中」的版本，写入时自动创建）";
  out.push(`${r.dryRun ? "将建" : "已建"}草稿卡 ${r.drafts.length} 张 → 预约 ${ms}`);
  const s = r.skipped;
  out.push(`跳过：已有功能卡 ${s.hasCard} · 已进主线（有独有提交且已合入）${s.inMain} · 没有独立 worktree ${s.noWorktree} · 主线/集成分支 ${s.notFeature}`);
  const zero = r.drafts.filter((d) => d.noCommits).length;
  if (zero) out.push(`其中 ${zero} 张的分支尚无独有提交（与主线同点或自创建后未提交），按「开发中」登记`);
  out.push(`台账：${r.ledgerDir}`);
  const byRepo = new Map<string, typeof r.drafts>();
  for (const d of r.drafts) byRepo.set(d.repoLabel, [...(byRepo.get(d.repoLabel) ?? []), d]);
  for (const [label, list] of byRepo) {
    out.push("", `■ ${label}（${list.length}）`);
    for (const d of list) {
      const id = d.id ? `${d.id} ` : "";
      out.push(fit(`  - ${id}${d.title} · ${d.status}${d.noCommits ? " · 尚无提交" : ""}${d.titleSource === "label" ? " · 标题取自分支标签" : ""}`, W, opts.wide));
      const sess = d.session ? ` · 会话 ${shortSession(d.session)}（${LINK_MARK[d.sessionLink ?? "branch"]}）` : " · 无关联会话";
      const pr = d.pr !== null ? ` · PR #${d.pr}` : "";
      out.push("    " + fitMid(`${d.branch}${sess}${pr}`, W - 4, opts.wide));
    }
  }
  out.push("");
  out.push(
    r.dryRun
      ? "下一步：去掉 --dry-run 写入；写入后逐条确认标题与预约（heliu feature list；heliu 预约 <卡号> <版本>；heliu feature rename <卡号> <新标题>）"
      : "下一步：逐条确认标题与预约（heliu feature rename <卡号> <新标题>；heliu 预约 <卡号> <版本>）；草稿标记 source: sync",
  );
  return out.join("\n");
}

/** MCP 返回文本上限：超出截断并提示用 CLI --json */
export const MCP_TEXT_LIMIT = 8000;
export function clampText(text: string, cliHint: string, limit = MCP_TEXT_LIMIT): string {
  if (text.length <= limit) return text;
  const tail = `\n…（已截断：共 ${text.length} 字符，超过 ${limit}。完整内容请在终端运行 \`${cliHint} --json\`）`;
  const cut = text.slice(0, limit - tail.length);
  return cut.slice(0, cut.lastIndexOf("\n") > 0 ? cut.lastIndexOf("\n") : cut.length) + tail;
}
/**
 * heliu MCP server（stdio）：`heliu mcp`。
 *
 * - 工具名 heliu_*，描述与参数说明全部中文口语，便于模型从用户的话里挑工具。
 * - 每个工具都可带 cwd：MCP 进程只知道主检出目录（CLAUDE_PROJECT_DIR），不知道会话所在 worktree；
 *   SessionStart hook 注入的上下文会提示模型把 cwd 传进来。缺省用 CLAUDE_PROJECT_DIR，再缺省用进程 cwd。
 * - 返回文本 ≤8000 字符，超出截断并提示用 CLI --json。
 * - 只读被管理仓库；写入只发生在台账目录（feature_* / sync）。
 */
import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
import { StdioServerTransport } from "@modelcontextprotocol/sdk/server/stdio.js";
import { z } from "zod";
import {
  opFeatureAdd,
  opFeatureBind,
  opFeatureReserve,
  opFeatureSet,
  opMilestoneList,
  opMilestoneTodo,
  opSync,
  opWhereami,
  projectOf,
  type OpContext,
  type OpResult,
} from "../app/ops.ts";
import { clampText } from "../cli/render-ledger.ts";
import { renderHygiene, renderSessions, renderStatusSummary } from "../cli/render.ts";
import { heliuPaths } from "../core/paths.ts";
import { reconcile } from "../core/reconcile.ts";
import { ACCEPTANCE_LEVELS, FEATURE_STATUSES } from "../types.ts";

export const MCP_TOOL_NAMES = [
  "heliu_whereami",
  "heliu_status",
  "heliu_sessions",
  "heliu_hygiene",
  "heliu_feature_add",
  "heliu_feature_reserve",
  "heliu_feature_bind",
  "heliu_feature_set_status",
  "heliu_milestone_todo",
  "heliu_milestone_list",
  "heliu_sync",
] as const;

/** MCP 渲染宽度：模型读文本，不受终端宽度限制，但保持表格可读 */
const MCP_WIDTH = 100;

const common = {
  cwd: z
    .string()
    .optional()
    .describe("你当前所在的目录（会话的 worktree 路径）。SessionStart 提示里给过就原样传；不传则用项目主目录"),
  project: z.string().optional().describe("项目名（如「磁吸背夹」）。一般不用传，会按 cwd 自动识别"),
};

function ctxOf(args: { cwd?: string; project?: string }): OpContext {
  return {
    paths: heliuPaths(),
    cwd: args.cwd || process.env.CLAUDE_PROJECT_DIR || process.cwd(),
    projectName: args.project || undefined,
    source: "mcp",
    render: { width: MCP_WIDTH },
  };
}

type ToolText = { content: Array<{ type: "text"; text: string }>; isError?: boolean };

function ok(text: string, cliHint: string): ToolText {
  return { content: [{ type: "text", text: clampText(text, cliHint) }] };
}

/** 统一错误处理：返回中文错误文本（isError），不让异常打断会话 */
async function run(cliHint: string, fn: () => Promise<OpResult | string>): Promise<ToolText> {
  try {
    const r = await fn();
    return ok(typeof r === "string" ? r : r.text, cliHint);
  } catch (e) {
    return { content: [{ type: "text", text: `合流出错：${(e as Error).message}` }], isError: true };
  }
}

export function buildServer(): McpServer {
  const server = new McpServer(
    { name: "heliu", version: "0.2.0" },
    {
      instructions:
        "合流（heliu）：把 git 分支 × worktree × 桌面会话 对上账，并管理「功能卡 → 预约到哪一版」。用户说「我有个新点子/做个 X」→ heliu_feature_add；「这个预约到 1.2」→ heliu_feature_reserve；「1.2 还欠什么」→ heliu_milestone_todo。调用时尽量传 cwd（会话所在 worktree）。永不 push、不删分支。",
    },
  );

  server.registerTool(
    "heliu_whereami",
    {
      title: "我在哪",
      description: "看看当前会话在哪个仓库、哪个分支，对应哪张功能卡、预约到哪一版、落后主线/集成分支多少提交。用户问「我现在在做哪个功能」「这个分支落后多少」时用。",
      inputSchema: { ...common },
    },
    async (a) => run("heliu whereami", () => opWhereami(ctxOf(a))),
  );

  server.registerTool(
    "heliu_status",
    {
      title: "项目对账摘要",
      description: "一屏看懂整个项目：健康条、现在最该做的、等你处理的会话、独立未合并分支、已进集成分支待回主线、落后需同步。用户问「项目现在什么情况」「有哪些分支没合」时用。只读。",
      inputSchema: { ...common },
    },
    async (a) =>
      run("heliu status", async () => {
        const ctx = ctxOf(a);
        const p = await projectOf(ctx);
        const { report, sessions } = await reconcile(p, ctx.paths, { precheck: false, dirty: false, timeoutMs: 8000 });
        return renderStatusSummary(report, { width: MCP_WIDTH, sessions });
      }),
  );

  server.registerTool(
    "heliu_sessions",
    {
      title: "会话清单",
      description: "列出本项目的桌面会话：哪些在等你回答（附它要你做什么）、哪些在运行。用户问「哪些会话在等我」「还有谁在跑」时用。只读。",
      inputSchema: { ...common, all: z.boolean().optional().describe("true = 连已完成、已归档的会话也列出来") },
    },
    async (a) =>
      run("heliu sessions", async () => {
        const ctx = ctxOf(a);
        const p = await projectOf(ctx);
        const { sessions } = await reconcile(p, ctx.paths, { precheck: false, dirty: false, timeoutMs: 8000 });
        return renderSessions(p.name, sessions, { all: a.all, width: MCP_WIDTH });
      }),
  );

  server.registerTool(
    "heliu_hygiene",
    {
      title: "worktree 卫生检查",
      description: "检查哪些分支/目录该清理：已进主线但目录还在、目录名和分支名对不上、孤儿条目、残留锁文件、iCloud 冲突副本。只报告，不动手删任何东西。用户问「哪些分支该清了」时用。",
      inputSchema: { ...common },
    },
    async (a) =>
      run("heliu hygiene", async () => {
        const ctx = ctxOf(a);
        const p = await projectOf(ctx);
        const { report } = await reconcile(p, ctx.paths, { precheck: false, dirty: false, timeoutMs: 8000 });
        return renderHygiene(report);
      }),
  );

  server.registerTool(
    "heliu_feature_add",
    {
      title: "登记新功能（新点子）",
      description:
        "把用户的一句话需求登记成一张功能卡，默认预约到「下一版」，并自动绑定当前会话所在的分支。用户说「我有个新点子：让背夹支持闹钟」「做个 X，先并行做着」时用。标题直接用用户的原话（简短）。当前分支已有卡时不会重复绑定。",
      inputSchema: {
        title: z.string().min(1).describe("功能标题，用用户的一句话，如「让背夹支持闹钟」"),
        milestone: z.string().optional().describe("预约到哪一版，如「v1.2」「1.2」「下一版」。不传 = 下一版"),
        bind: z.boolean().optional().describe("是否自动绑定当前分支，默认 true；用户只是记个想法、不在这个分支上做时传 false"),
        session: z.string().optional().describe("要绑定的桌面会话 id（local_…），不传则按 cwd 自动匹配"),
        body: z.string().optional().describe("补充说明（一句话需求、验收要点），可不传"),
        ...common,
      },
    },
    async (a) =>
      run("heliu feature list", () =>
        opFeatureAdd(ctxOf(a), { title: a.title, milestone: a.milestone, bind: a.bind, session: a.session, body: a.body }),
      ),
  );

  server.registerTool(
    "heliu_feature_reserve",
    {
      title: "改预约版本",
      description: "把某张功能卡预约到某一版。用户说「这个预约到 1.2」「这个不急，放 2.0」「挪到下一版」时用。版本不存在会自动新建（规划中）；已冻结的版本不接新预约。",
      inputSchema: {
        id: z.string().describe("功能卡号，如「F-0003」，也可写「3」"),
        milestone: z.string().describe("目标版本，如「v1.2」「1.2」「下一版」；传「无」= 取消预约"),
        ...common,
      },
    },
    async (a) => run("heliu feature list", () => opFeatureReserve(ctxOf(a), a.id, a.milestone)),
  );

  server.registerTool(
    "heliu_feature_bind",
    {
      title: "把功能卡绑到分支/会话",
      description:
        "把功能卡和一个分支（及其 worktree、会话、PR）绑定起来。为某张卡开了新会话后，用它把新会话的 id 回写到卡上；不给 branch 时绑定 cwd 所在的分支。",
      inputSchema: {
        id: z.string().describe("功能卡号，如「F-0003」"),
        repo: z.string().optional().describe("仓库 id（如 docs / firmware / app），给 branch 时需要，默认第一个仓库"),
        branch: z.string().optional().describe("分支名；不传则用 cwd 所在分支"),
        worktree: z.string().optional().describe("worktree 绝对路径，可不传"),
        session: z.string().optional().describe("桌面会话 id（local_…），可不传"),
        pr: z.number().int().optional().describe("PR 编号，可不传"),
        ...common,
      },
    },
    async (a) =>
      run("heliu feature list", () =>
        opFeatureBind(ctxOf(a), a.id, { repo: a.repo, branch: a.branch, worktree: a.worktree, session: a.session, pr: a.pr }),
      ),
  );

  server.registerTool(
    "heliu_feature_set_status",
    {
      title: "改功能状态/验收档位/标题",
      description: `更新功能卡：状态（${FEATURE_STATUSES.join(" / ")}）、验收档位（${ACCEPTANCE_LEVELS.join(" / ")}）或改标题。用户说「这个不做了」→ 已放弃；「这个实机测过了」→ 验收 实机通过；sync 草稿要改名时传 title。`,
      inputSchema: {
        id: z.string().describe("功能卡号，如「F-0003」"),
        status: z.enum(FEATURE_STATUSES).optional().describe("新状态"),
        acceptance: z.enum(ACCEPTANCE_LEVELS).optional().describe("新验收档位（和合并状态无关，不会自动提升）"),
        title: z.string().optional().describe("新标题"),
        ...common,
      },
    },
    async (a) => run("heliu feature list", () => opFeatureSet(ctxOf(a), a.id, { status: a.status, acceptance: a.acceptance, title: a.title })),
  );

  server.registerTool(
    "heliu_milestone_todo",
    {
      title: "某一版还欠什么",
      description:
        "列出预约到某一版、还没合入的功能（台账状态为 想法/开发中/待合并 的都算），按「等你回答 / 有冲突 / 可合并 / 落后需同步 / 停滞 / 开发中 / 尚未关联开发分支」分组。用户问「1.2 还欠什么」「下一版还差啥」「哪些能合了」时用。返回里的「建议」只转述给用户，不要自己改状态。",
      inputSchema: {
        milestone: z.string().optional().describe("版本，如「v1.2」「1.2」；不传 = 下一版"),
        precheck: z.boolean().optional().describe("true = 对未合并分支做试合（在临时区进行，不碰仓库），才能分出「有冲突」，稍慢"),
        ...common,
      },
    },
    async (a) => run(`heliu 待办 ${a.milestone ?? "下一版"}`, () => opMilestoneTodo(ctxOf(a), a.milestone ?? "下一版", { precheck: a.precheck, limitPerGroup: 12 })),
  );

  server.registerTool(
    "heliu_milestone_list",
    {
      title: "版本列表",
      description: "列出所有版本（里程碑）：状态、目标日期、待办数，并指出「下一版」是哪个。用户问「有哪些版本」「下一版是哪个」时用。",
      inputSchema: { ...common },
    },
    async (a) => run("heliu milestone list", () => opMilestoneList(ctxOf(a))),
  );

  server.registerTool(
    "heliu_sync",
    {
      title: "把在途分支登记成草稿卡",
      description:
        "扫描本项目的会话与分支：在 worktree 里开发、还没有功能卡、也没进主线的分支，自动建草稿卡（标题取会话标题，预约下一版）。同一分支只建一次。建议先 dry_run=true 预览；写入后把草稿逐条报给用户确认标题与预约。",
      inputSchema: {
        dry_run: z.boolean().optional().describe("true = 只列出将要建的草稿，不写入；默认 false"),
        ...common,
      },
    },
    async (a) => run("heliu sync --dry-run", () => opSync(ctxOf(a), { dryRun: !!a.dry_run })),
  );

  return server;
}

/** 启动 stdio 服务，直到客户端关闭 stdin */
export async function runMcpServer(): Promise<void> {
  const server = buildServer();
  const transport = new StdioServerTransport();
  const closed = new Promise<void>((resolve) => {
    transport.onclose = () => resolve();
    process.stdin.on("end", () => resolve());
    process.stdin.on("close", () => resolve());
  });
  await server.connect(transport);
  await closed;
}
/**
 * bin/heliu-hook：输出格式（hookSpecificOutput.additionalContext 中文）、<300ms、任何错误静默 exit 0、
 * Stop 写缓存不写台账；plugin 的 hooks.json 不注册 WorktreeCreate（会替换默认 worktree 创建）。
 */
import { afterAll, beforeAll, describe, expect, test } from "bun:test";
import { existsSync, readFileSync } from "node:fs";
import { join } from "node:path";
import { Cache } from "../src/core/cache.ts";
import { Ledger } from "../src/core/ledger.ts";
import { heliuPaths } from "../src/core/paths.ts";
import { buildFixture, gitSnapshot, type Fixture } from "./helpers/fixture.ts";

const ROOT = join(import.meta.dir, "..");
const HOOK = join(ROOT, "bin", "heliu-hook");
const BIN = join(ROOT, "bin", "heliu");
let fx: Fixture;

function hook(input: string): { code: number; stdout: string; stderr: string; ms: number } {
  const t0 = performance.now();
  // 直接执行 sh 包装（与 Claude Code 调 hooks.json 的方式一致），计时含 sh 找 bun + bun 启动
  const r = Bun.spawnSync({ cmd: [HOOK], stdin: Buffer.from(input), env: { ...process.env, ...fx.env }, stdout: "pipe", stderr: "pipe" });
  const ms = performance.now() - t0;
  return { code: r.exitCode ?? -1, stdout: r.stdout.toString(), stderr: r.stderr.toString(), ms };
}
const ev = (event: string, cwd: string, extra: Record<string, unknown> = {}) => JSON.stringify({ session_id: "cli-test", cwd, hook_event_name: event, ...extra });

beforeAll(() => {
  fx = buildFixture();
  const reg = Bun.spawnSync({ cmd: [process.execPath, "run", BIN, "project", "add", fx.repo, "--name", "演示", "--integration", "integ"], env: { ...process.env, ...fx.env }, stdout: "pipe", stderr: "pipe" });
  expect(reg.exitCode).toBe(0);
  // 给 standalone 分支建一张卡（预约 v1.2）
  const l = new Ledger(join(fx.repo, ".heliu"));
  l.addFeature({ title: "实现 EPP 网关", milestone: "v1.2", bindings: [{ repo: "磁吸-仓库", branch: "claude/bold-shaw-cccccc", worktree: fx.wt.standalone!, session: null, pr: null }] });
});
afterAll(() => fx.cleanup());

describe("SessionStart", () => {
  test("有功能卡：输出 hookSpecificOutput.additionalContext（中文，含卡号/预约/落后数）", () => {
    const r = hook(ev("SessionStart", fx.wt.standalone!, { source: "startup" }));
    expect(r.code).toBe(0);
    const j = JSON.parse(r.stdout);
    expect(Object.keys(j)).toEqual(["hookSpecificOutput"]);
    expect(j.hookSpecificOutput.hookEventName).toBe("SessionStart");
    const ctx: string = j.hookSpecificOutput.additionalContext;
    expect(ctx.startsWith("【合流】你在 磁吸 仓库/claude/bold-shaw-cccccc")).toBe(true);
    expect(ctx).toContain("功能卡 F-0001『实现 EPP 网关』");
    expect(ctx).toContain("预约 v1.2");
    expect(ctx).toContain("落后主线 0 提交、落后集成分支 3");
    expect(ctx).toContain(`cwd="${fx.wt.standalone!}"`);
    expect(ctx.length).toBeLessThan(10_000);
  });

  test("无功能卡：提示在明确需求后调用 heliu_feature_add", () => {
    const r = hook(ev("SessionStart", fx.wt.reused!));
    const ctx: string = JSON.parse(r.stdout).hookSpecificOutput.additionalContext;
    expect(ctx).toContain("本分支暂无功能卡；若本会话在做新功能，请在明确需求后调用 heliu_feature_add 登记（标题用用户的一句话），否则忽略。");
  });

  test("耗时 <300ms（三次都满足，含 bun 启动）", () => {
    hook(ev("SessionStart", fx.wt.standalone!)); // 预热磁盘缓存
    const times = [0, 1, 2].map(() => hook(ev("SessionStart", fx.wt.standalone!)).ms);
    for (const t of times) expect(t).toBeLessThan(300);
  });

  test("首次见到的 worktree 记进缓存（替代 WorktreeCreate）", () => {
    const c = Cache.open(heliuPaths(fx.env), "演示", { readonly: true })!;
    const seen = c.worktrees().map((w) => w.path);
    c.close();
    expect(seen).toContain(fx.wt.standalone!);
  });
});

describe("Stop 与容错", () => {
  test("Stop：会话最后活动写入缓存 sqlite，不写台账、不输出", () => {
