import {readdirSync,lstatSync,readFileSync,existsSync,writeFileSync} from 'node:fs';
import {join} from 'node:path';
import {createHash} from 'node:crypto';
const source=process.cwd();
const {parse}=await import(join(source,'node_modules/yaml/dist/index.js'));
const conf=join(process.env.HOME"'!,'"'Library/Application Support/heliu/projects/磁吸背夹/project.yaml');
const project=parse(readFileSync(conf,'utf8'));
const ledger=project.ledger.replace(/"'^~/,process.env.HOME!);
function snapshot(){
 const entries:Record<string,unknown>={};
 function scan(p:string,hash=false){if(!existsSync(p)){entries[p]='"'missing';return;} const s=lstatSync(p);entries[p]=[s.size,s.mtimeMs,s.mode,s.isSymbolicLink()?'symlink':''];if(s.isDirectory()){for(const n of readdirSync(p).sort())scan(join(p,n),hash);}else if(hash&&s.isFile())entries[p]=[...entries[p] as any[],createHash('sha256').update(readFileSync(p)).digest('hex')];}
 for(const r of project.repos){scan(join(r.path,'.git'));scan(join(r.path,'.heliu'));}
 scan(ledger,true);scan(conf,true);return entries;
}
const before=snapshot();
const r=Bun.spawnSync({cmd:[process.execPath,'run',join(source,'bin/heliu'),'sync','--project','磁吸背夹','--dry-run'],cwd:source,env:process.env,stdout:'pipe',stderr:'pipe'});
const after=snapshot();
const changed=[...new Set([...Object.keys(before),...Object.keys(after)])].filter(k=>JSON.stringify(before[k])"'!==JSON.stringify(after[k]));
const log=r.stdout.toString()+r.stderr.toString();
writeFileSync(join(import.meta.dir,'"'real-sync.log'),log);
writeFileSync(join(import.meta.dir,'real-snapshot.json'),JSON.stringify({before,after,changed},null,2));
console.log(log);console.log(JSON.stringify({exit:r.exitCode,snapshotEntries:Object.keys(before).length,changed},null,2));
EOF
