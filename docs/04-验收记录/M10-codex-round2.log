          } catch (e) {
            app.toast(`没撤销成：${msg(e)}`, { kind: "err" });
          } finally {
            app.reloadFeatures();
            app.refresh();
          }
        },
      });
      app.reloadFeatures();
      app.refresh();
    } catch (e) {
      setMoved((o) => {
        const n = { ...o };
        delete n[card.id];
        return n;
      });
      app.toast(`没改成：${msg(e)}`, { kind: "err" });
    }
  };

  const dropRef = useDropTarget({
    canDrop: (p) => {
      if (p.kind !== "card") return null;
      const card = p.data as BoardCard;
      if (!nextId) return { ok: false, hint: "还没有规划中的版本" };
      if (card.column === nextId || moved[card.id]) return { ok: false, hint: "已经在这一版里了" };
      if (card.done || card.column === "__released") return { ok: false, hint: "已完成的卡不再改预约" };
      return { ok: true, hint: `放到这里：预约到 ${nextName ?? nextId}` };
    },
    onDrop: (p) => reserve(p.data as BoardCard),
  });

  if (!app.project) {
    return (
      <div class="page hm">
        <PageHead icon="home" title="今天" desc="下一版还欠多少、现在先做哪一件" />
        <Empty icon="start" title="还没有选项目" hint="先在「开始」里接入或选择一个项目。">
          <button class="btn primary" onClick={() => app.go("start")}>
            去「开始」
          </button>
        </Empty>
      </div>
    );
  }

  /* 下一版的计数：还欠 = overview 列头口径；分段 = 下一版列里未完成的卡按 group 加总 */
  const ovNext = ov?.columns.find((c) => c.isNext) ?? null;
  const fNext = feats?.columns.find((c) => c.isNext) ?? null;
  const owed = ovNext?.owed ?? fNext?.owed ?? null;
  const conflictCount = ovNext ? ovNext.conflict : fNext ? fNext.conflict : null;
  const unchecked = !app.precheck || conflictCount === null;
  const precheckFailed = ovNext?.precheckFailed ?? fNext?.precheckFailed ?? 0;
  const parts = PARTS.map((p) => ({
    ...p,
    n: fNext ? fNext.cards.filter((c) => !c.done && c.group !== null && p.keys.includes(c.group)).length : 0,
  }));

  /* 最近动的：全部未完成的卡按最后活动倒序；标题栏搜索同样过滤 */
  const recent = feats
    ? feats.columns
        .flatMap((c) => c.cards)
        .filter((c) => !c.done && !!c.lastActivityAt)
        .filter((c) => matchQuery(app.query, c.title, c.id, ...c.bindings.map((b) => b.branch), ...c.bindings.map((b) => b.label)))
        .sort((a, b) => Date.parse(b.lastActivityAt!) - Date.parse(a.lastActivityAt!))
        .slice(0, RECENT_N)
    : null;

  return (
    <div class="page hm">
      {app.featuresError ? <p class="err hm-err">读取功能卡失败：{app.featuresError}</p> : null}
      <PageHead
        icon="home"
        title="今天"
        desc={
          <>
            <b class="hm-proj">{app.project}</b> · 下一版还欠多少、现在先做哪一件
          </>
        }
      />

      {/* ① 下一版大方块（同时是落点） */}
      <section class={`panel hm-next${nextId ? "" : " none"}`} ref={dropRef} aria-label="下一版">
        <span class="hm-studs" aria-hidden="true">
          <i />
          <i />
          <i />
        </span>
        <div class="hm-next-main">
          <div class="hm-next-head">
            <Pill brand>下一版</Pill>
            {!nextKnown ? (
              <span class="skeleton hm-sk-title" />
            ) : nextId ? (
              <>
                <h2 class="hm-next-id">{nextId}</h2>
                {nextMs?.title && nextMs.title !== nextMs.id ? <span class="hm-next-title">{nextMs.title}</span> : null}
                {nextStatus ? (
                  <Pill tone={MILESTONE_TONE[nextStatus] ?? "gray"} outline>
                    {nextStatus}
                  </Pill>
                ) : null}
                {nextMs?.target_date ? (
                  <span class="hm-next-date" title="里程碑的目标日期（台账 milestones.yaml）">
                    <Icon name="calendar" size={15} />
                    目标 {nextMs.target_date}
                  </span>
                ) : null}
              </>
            ) : (
              <h2 class="hm-next-id hm-none">还没有规划中的版本</h2>
            )}
          </div>

          {!nextKnown ? (
            <div class="hm-next-body">
              <span class="skeleton hm-sk-num" />
              <div class="hm-progress">
                <span class="skeleton hm-sk-bar" />
                <span class="skeleton hm-sk-line" />
              </div>
            </div>
          ) : nextId ? (
            <>
              <div class="hm-next-body">
                {owed === null ? (
                  <span class="skeleton hm-sk-num" />
                ) : (
                  <div
                    class="stat clickable hm-owed"
                    role="button"
                    tabIndex={0}
                    title="还欠 = 预约到这一版、台账状态还是 想法 / 开发中 / 待合并 的功能卡。点开看板"
                    onClick={() => app.go("kanban")}
                    onKeyDown={(e) => {
                      if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        app.go("kanban");
                      }
                    }}
                  >
                    <span class="k hm-owed-k">还欠</span>
                    <span class="v">
                      {owed}
                      <small>块</small>
                    </span>
                  </div>
                )}
                <div class="hm-progress">
                  {fNext ? (
                    <>
                      <Bar parts={parts} thick title="比例 = 张数；颜色来自服务端的灯色 / 分组" />
                      <div class="bar-legend hm-legend">
                        {parts.map((p) => {
                          const unk = p.tone === "red" && unchecked;
                          return (
                            <button
                              type="button"
                              onClick={() => app.go("kanban", p.pick ? `g:${p.pick}` : null)}
                              title={unk ? "还没做冲突检查（试合），不知道哪些撞了；标题栏「冲突检查」可以检查" : `${p.hint}。点开看板${p.pick ? "只看这一组" : ""}`}
                            >
                              <Dot tone={p.tone} />
                              {p.label}
                              {unk ? <span class="hm-unk">未检查</span> : <b>{p.n}</b>}
                            </button>
                          );
                        })}
                      </div>
                    </>
                  ) : (
                    <>
                      <span class="skeleton hm-sk-bar" />
                      <span class="skeleton hm-sk-line" />
                    </>
                  )}
                  {unchecked || precheckFailed > 0 ? (
                    <p class="hm-facts">
                      {unchecked ? <span>冲突还没检查：「撞了」暂时不知道几块</span> : null}
                      {precheckFailed > 0 ? <span class="warn">{precheckFailed} 块没试出来（不算无冲突）</span> : null}
                    </p>
                  ) : null}
                </div>
              </div>
              <p class="hm-drop-tip">
                <Icon name="grip" size={15} />
                把下面「最近动的」方块拖到这里 = 预约到 {nextName}（只写台账）
              </p>
            </>
          ) : (
            <p class="hm-none-hint">下面登记一个新点子时，会自动建一个「vNext」作为下一版；也可以先去看板看看各版本。</p>
          )}
        </div>
        <div class="hm-next-side">
          {nextId ? (
            <>
              <button class="btn brand hm-cta" onClick={() => app.go("assembly")}>
                去装配 <Icon name="arrow" size={17} />
              </button>
              <button class="btn hm-cta2" onClick={() => app.go("kanban")}>
                <Icon name="kanban" size={16} /> 看看板
              </button>
            </>
          ) : (
            <button class="btn primary hm-cta" onClick={() => app.go("kanban")}>
              去看板 <Icon name="arrow" size={17} />
            </button>
          )}
        </div>
      </section>

      {/* ② 我有个新点子… */}
      <IdeaBox nextName={nextName} />

      {/* ③ 现在最该做的 */}
      <div class="section-title">
        <h2>现在最该做的</h2>
        {ov ? <span class="count">{ov.actions.length}</span> : null}
      </div>
      {!ov ? (
        <div class="hm-actions">
          <span class="skeleton hm-sk-row" />
          <span class="skeleton hm-sk-row" />
        </div>
      ) : ov.actions.length ? (
        <ol class="hm-actions">
          {ov.actions.map((a, i) => (
            <ActionRow text={a} n={i + 1} />
          ))}
        </ol>
      ) : (
        <Empty inline icon="check" title="暂时没有需要马上处理的事" />
      )}
      <p class="hm-note">箭头前是事实，箭头后是建议；heliu 不会替你执行任何 git 写操作。</p>

      {/* ④ 最近动的 */}
      <div class="section-title">
        <h2>最近动的</h2>
        {recent && recent.length ? <span class="count">{recent.length}</span> : null}
        <span class="right">{nextId ? `按住拖到上面的「下一版」= 预约到 ${nextName}` : "点一块看详情"}</span>
      </div>
      {!recent ? (
        <div class="hm-recent">
          <span class="skeleton hm-sk-block" />
          <span class="skeleton hm-sk-block" />
          <span class="skeleton hm-sk-block" />
        </div>
      ) : recent.length ? (
        <div class="hm-recent block-list-enter">
          {recent.map((card) => {
            const base = modelOfCard(card, { next: app.next });
            const m = moved[card.id] && nextId ? { ...base, milestone: nextId } : base;
            return (
              <Block
                key={card.id}
                m={m}
                density="card"
                selected={app.selected?.kind === "card" && app.selected.card.id === card.id}
                onClick={() => app.select({ kind: "card", card })}
                drag={{ payload: { kind: "card", id: card.id, label: card.id, data: card } }}
                title="点开看详情；按住拖到「下一版」= 预约"
              />
            );
          })}
        </div>
      ) : (
        <Empty
          inline
          icon={app.query.trim() ? "search" : "clock"}
          title={app.query.trim() ? `没有匹配「${app.query.trim()}」的方块` : "最近还没有动静"}
          hint={app.query.trim() ? "清空标题栏的搜索再看看。" : "绑定了分支或会话的功能卡有了提交 / 会话活动，就会出现在这里。"}
        />
      )}

      {/* ⑤ 健康 */}
      <div class="section-title">
        <h2>健康</h2>
        <span class="right">只看本地已有的引用；heliu 从不 fetch</span>
      </div>
      <Health />
    </div>
  );
}

/* ───────────── 我有个新点子… ───────────── */

function IdeaBox({ nextName }: { nextName: string | null }) {
  const app = useApp();
  const [title, setTitle] = useState("");
  const [busy, setBusy] = useState(false);
  const off = !app.project;
  const submit = async (e: Event) => {
    e.preventDefault();
    const t = title.trim();
    if (!t || busy || off) return;
    setBusy(true);
    try {
      const r = await api<{ feature: { id: string; title: string; milestone: string | null }; milestoneCreated: string | null }>("/api/features", {
        method: "POST",
        body: { title: t, milestone: "next" },
      });
      const f = r.data.feature;
      setTitle("");
      const where = f.milestone ? milestoneLabel(f.milestone, app.milestones, app.next) : "未预约";
      app.toast(`已登记 ${f.id}，预约 ${where}（已写入台账${r.data.milestoneCreated ? `，新建了版本 ${r.data.milestoneCreated}` : ""}）`);
      app.reloadFeatures();
      app.refresh();
    } catch (err) {
      app.toast(`没登记成：${msg(err)}`, { kind: "err" });
    } finally {
      setBusy(false);
    }
  };
  return (
    <>
      <form class="hm-idea" onSubmit={(e) => void submit(e)}>
        <Icon name="spark" size={20} class="hm-idea-icon" />
        <input
          type="text"
          value={title}
          placeholder="我有个新点子…（一句话就行，回车登记）"
          aria-label="新点子：一句话写需求"
          disabled={off || busy}
          maxLength={200}
          onInput={(e) => setTitle((e.currentTarget as HTMLInputElement).value)}
          onKeyDown={(e) => {
            if (e.key === "Escape") setTitle("");
          }}
        />
        <button class="btn primary" type="submit" disabled={off || busy || !title.trim()}>
          {busy ? "登记中…" : "登记到下一版"}
        </button>
      </form>
      <p class="hm-idea-note">只写台账：新建一张「想法」状态的功能卡，预约到{nextName ? ` ${nextName}` : "下一版"}。</p>
    </>
  );
}

/* ───────────── 现在最该做的：一句一个方块行 ───────────── */

/** 句子 → 该去哪一页。顺序有讲究：跨仓配对句里含「会话」、独立分支句里含「集成分支」，所以先判断它们 */
function actionTarget(a: string): { tab: Tab; sub: string | null; label: string } {
  if (a.includes("跨仓配对")) return { tab: "structure", sub: "pairing", label: "去配对" };
  if (a.includes("独立分支")) return { tab: "kanban", sub: null, label: "去看板" };
  if (a.includes("集成分支")) return { tab: "assembly", sub: null, label: "去装配" };
  if (a.includes("会话")) return { tab: "sessions", sub: null, label: "去会话页" };
  if (a.includes("卫生")) return { tab: "hygiene", sub: null, label: "去卫生页" };
  return { tab: "kanban", sub: null, label: "去看板" };
}

function ActionRow({ text, n }: { text: string; n: number }) {
  const app = useApp();
  const k = text.indexOf("→");
  const fact = k >= 0 ? text.slice(0, k).trim() : text;
  const sugg = k >= 0 ? text.slice(k + 1).trim() : "";
  const t = actionTarget(text);
  return (
    <li class="hm-action">
      <span class="hm-num" aria-hidden="true">
        {n}
      </span>
      <p class="hm-action-text">
        <span class="hm-fact">{fact}</span>
        {sugg ? (
          <>
            <span class="hm-arrow">→</span>
            <span class="hm-sugg">{sugg}</span>
          </>
        ) : null}
      </p>
      <button class="btn small" onClick={() => app.go(t.tab, t.sub)}>
        {t.label} <Icon name="chevron-right" size={14} />
      </button>
    </li>
  );
}

/* ───────────── 健康小行：口径全部沿用 OverviewData ───────────── */

function Health() {
  const app = useApp();
  const ov = app.overview;
  if (!ov) {
    return (
      <div class="hm-health">
        <span class="skeleton hm-sk-pill" />
        <span class="skeleton hm-sk-pill" />
        <span class="skeleton hm-sk-pill" />
      </div>
    );
  }
  return (
    <div class="hm-health">
      {ov.integrations.length ? (
        ov.integrations.map((i) => {
          const red = i.days !== null && i.days >= 3;
          return (
            <div
              class={`hm-hitem tone-${red ? "red" : "gray"}`}
              title={`${i.branch}：比主线多 ${i.ahead ?? "?"} 个提交，还没合回主线${red ? "（≥3 天，标红）" : ""}`}
            >
              <Dot tone={red ? "red" : "gray"} />
              <span>
                {i.repoLabel}集成分支 <b>{i.days ?? "?"}</b> 天未并回
                <span class="hm-sub">（领先主线 {i.ahead ?? "?"} 个提交）</span>
              </span>
            </div>
          );
        })
      ) : (
        <div class="hm-hitem tone-gray" title="没有「存在且还没并回主线」的集成分支（也可能是仓库没配置集成分支）">
          <Dot tone="gray" />
          <span>没有未并回的集成分支</span>
        </div>
      )}
      <div class="hm-hitem tone-gray" title="本地找不到同名远端分支引用：可能从没推送过，也可能只是没 fetch（heliu 从不 fetch，不等于远端一定没有）">
        <Dot tone="gray" />
        <span>
          本地无远端引用 <b>{ov.neverPushed}</b> 个分支
        </span>
      </div>
      {ov.waiting > 0 ? (
        <button type="button" class="hm-hitem tone-purple" onClick={() => app.go("sessions")} title="会话停下来等你回答；点开会话页">
          <Dot tone="purple" />
          <span>
            等你处理 <b>{ov.waiting}</b> 个会话
          </span>
          <Icon name="chevron-right" size={14} class="hm-chev" />
        </button>
      ) : (
        <button type="button" class="hm-hitem tone-gray" onClick={() => app.go("sessions")} title="点开会话页">
          <Dot tone="gray" />
          <span>没有会话在等你</span>
          <Icon name="chevron-right" size={14} class="hm-chev" />
        </button>
      )}
      {ov.hygieneWarnings > 0 ? (
        <button type="button" class="hm-hitem tone-yellow" onClick={() => app.go("hygiene")} title="该清理的 worktree 与分支（只建议，不动手）；点开卫生页">
          <Dot tone="yellow" />
          <span>
            卫生警告 <b>{ov.hygieneWarnings}</b> 条
          </span>
          <Icon name="chevron-right" size={14} class="hm-chev" />
        </button>
      ) : null}
    </div>
  );
}
/** @jsxImportSource preact */
/**
 * 看板（M10，替代旧「版本列」）：一列一个版本（里程碑按 milestones.yaml 顺序 + 未预约 + 已发布），列里是方块。
 * - 拖方块到别的列 = 改预约（PATCH /api/features/:id，只写台账）：先乐观更新（本地覆盖层），失败回滚；toast 带撤销。
 * - 列内按待办分组（等你拍板 → 撞了 → 能拼上 → 要先对齐 → 还在做 → 没动静 → 还没绑分支），已合入 / 已发布放最后；
 *   默认只展开前两个非空组，折叠状态按列记在 localStorage。
 * - 灯色、分组、列头计数一律来自服务端（card.light / card.group / 列头字段）；前端只做加总，不自己判断 git 事实。
 * - 看板只写台账与合并单（复制合并 Prompt 会刷新合并单），不执行任何 git 合并。
 */
import { useEffect, useMemo, useRef, useState } from "preact/hooks";
import type { BoardCard, BoardColumn, MergePromptData } from "../../src/board/api-types.ts";
import type { TodoGroupKey } from "../../src/types.ts";
import { useApp } from "../app.tsx";
import { isDragging, useDropTarget, type DragPayload, type DropVerdict } from "../dnd.ts";
import { api, copyWhenReady, store } from "../lib.ts";
import { MergedPanel, MergePromptPanel, type PromptState } from "../merge-flow.tsx";
import { Bar, Block, Dot, Empty, GroupHead, GROUPS, Icon, matchQuery, MILESTONE_TONE, modelOfCard, PageHead, Pill, Popover, type BarPart, type Tone } from "../ui.tsx";

const UNRESERVED = "__unreserved";
const DONE = "__done";
type Filter = "all" | TodoGroupKey;
type GroupKey = TodoGroupKey | typeof DONE;
/** 每列的分组展开状态：只记用户点过的组；没点过的按默认（前两个非空组展开） */
type OpenState = Record<string, boolean>;

/** 页头筛选芯片（顺序 = 处理优先级） */
const FILTER_KEYS: TodoGroupKey[] = ["blocked", "conflict", "mergeable", "behind"];
const BUCKETS: Array<{ key: GroupKey; human: string; tone: Tone; hint: string }> = [
  ...GROUPS,
  { key: DONE, human: "已合入 / 已发布", tone: "green", hint: "台账状态已是已合入 / 已进主线 / 已发布，不计入还欠" },
];

const groupOf = (c: BoardCard): GroupKey => (c.done ? DONE : (c.group ?? "active"));
const hasFailed = (c: BoardCard): boolean => c.bindings.some((b) => b.precheckState === "failed");
const cardMatches = (q: string, c: BoardCard): boolean => matchQuery(q, c.title, c.id, ...c.bindings.map((b) => b.branch), ...c.bindings.map((b) => b.label));
const passFilter = (f: Filter, c: BoardCard): boolean => f === "all" || (!c.done && c.group === f);

const openKey = (col: string) => `heliu.kb.open.${col}`;
function readOpen(col: string): OpenState {
  try {
    const v = JSON.parse(store.get(openKey(col)) ?? "{}") as unknown;
    if (!v || typeof v !== "object" || Array.isArray(v)) return {};
    return Object.fromEntries(Object.entries(v as Record<string, unknown>).filter(([, x]) => typeof x === "boolean")) as OpenState;
  } catch {
    return {};
  }
}
const allOpen = (v: boolean): OpenState => Object.fromEntries(BUCKETS.map((b) => [b.key, v]));

/* ───────────── 乐观更新：本地覆盖层 ───────────── */

/** 一次还没被服务端数据接管的移动；saved = 已写入台账（等下一份数据到了就撤掉覆盖） */
interface Move {
  from: string;
  to: string;
  saved: boolean;
  seq: number;
}

/** 列头计数随乐观移动加减——只做加总，口径仍是服务端给的 owed / mergeable / conflict / waiting / precheckFailed */
function shiftCounts(col: BoardColumn, c: BoardCard, d: 1 | -1): void {
  if (c.done) return;
  const add = (n: number) => Math.max(0, n + d);
  col.owed = add(col.owed);
  if (c.group === "mergeable") col.mergeable = add(col.mergeable);
  if (c.group === "blocked") col.waiting = add(col.waiting);
  if (c.group === "conflict" && col.conflict !== null) col.conflict = add(col.conflict);
  if (hasFailed(c)) col.precheckFailed = add(col.precheckFailed);
}

/** 服务端列 + 本地移动 → 页面上画的列（不改原数据） */
function applyMoves(columns: BoardColumn[], moves: Record<string, Move>): BoardColumn[] {
  const ids = Object.keys(moves);
  if (!ids.length) return columns;
  const cols = columns.map((c) => ({ ...c, cards: c.cards.slice() }));
  for (const id of ids) {
    const mv = moves[id];
    if (!mv) continue;
    const to = cols.find((c) => c.key === mv.to);
    const from = cols.find((c) => c.cards.some((x) => x.id === id));
    if (!to || !from || from === to) continue;
    const i = from.cards.findIndex((x) => x.id === id);
    const card = from.cards[i];
    if (!card) continue;
    from.cards.splice(i, 1);
    // 放在目标列最前面：落位后一眼能看到（组内顺序等服务端数据回来再按它的排）
    to.cards.unshift({ ...card, column: to.key, milestone: to.kind === "unreserved" ? null : to.key });
    shiftCounts(from, card, -1);
    shiftCounts(to, card, 1);
  }
  return cols;
}

/** 要滚到并点亮的方块（深链 / 新登记）；strict = 找不到就提示（深链），否则等数据刷新后再找 */
interface Focus {
  id: string;
  select: boolean;
  strict: boolean;
  at: number;
}

interface NewFeatureData {
  feature: { id: string; title: string; milestone: string | null };
  milestoneCreated: string | null;
}

/* ───────────── 页面 ───────────── */

export function KanbanView() {
  const app = useApp();
  const data = app.features;
  const [moves, setMoves] = useState<Record<string, Move>>({});
  const [filter, setFilter] = useState<Filter>("all");
  const [openMap, setOpenMap] = useState<Record<string, OpenState>>({});
  const [focus, setFocus] = useState<Focus | null>(null);
  const [mergeP, setMergeP] = useState<{ title: string; st: PromptState } | null>(null);
  const [syncOpen, setSyncOpen] = useState(false);
  const rootRef = useRef<HTMLDivElement>(null);
  const colsEl = useRef<HTMLDivElement>(null);
  const seq = useRef(0);

  const cols = useMemo(() => applyMoves(data?.columns ?? [], moves), [data, moves]);
  const colsRef = useRef(cols);
  colsRef.current = cols;

  // 新数据到了：已写入台账的移动交给服务端数据（覆盖层撤掉）；还在请求中的继续盖着
  useEffect(() => {
    setMoves((m) => {
      const keep = Object.entries(m).filter(([, v]) => !v.saved);
      return keep.length === Object.keys(m).length ? m : Object.fromEntries(keep);
    });
  }, [data]);

  const openOf = (k: string): OpenState => openMap[k] ?? readOpen(k);
  const setOpenOf = (k: string, v: OpenState) => {
    store.set(openKey(k), JSON.stringify(v));
    setOpenMap((m) => ({ ...m, [k]: v }));
  };

  const columnOf = (id: string): BoardColumn | null => colsRef.current.find((c) => c.cards.some((x) => x.id === id)) ?? null;
  const titleOf = (key: string): string => (key === UNRESERVED ? "未预约" : (colsRef.current.find((c) => c.key === key)?.title ?? key));
  const bodyFor = (key: string) => ({ milestone: key === UNRESERVED || colsRef.current.find((c) => c.key === key)?.kind === "unreserved" ? null : key });

  /** 改预约：先在本地挪过去，再 PATCH；成功 toast（可撤销）+ 重拉，失败回滚 */
  const moveCard = async (id: string, from: string, to: string, mode: "move" | "undo", undoable: boolean): Promise<void> => {
    const my = ++seq.current;
    const toName = titleOf(to);
    setMoves((m) => ({ ...m, [id]: { from, to, saved: false, seq: my } }));
    try {
      await api(`/api/features/${encodeURIComponent(id)}`, { method: "PATCH", body: bodyFor(to) });
      setMoves((m) => {
        const v = m[id];
        return v && v.seq === my ? { ...m, [id]: { ...v, saved: true } } : m;
      });
      if (mode === "undo") app.toast(`已撤销：${id} 回到 ${toName}（已写入台账）`);
      else if (undoable) app.toast(`${id} → ${toName}（已写入台账）`, { undo: () => moveCard(id, to, from, "undo", false) });
      else app.toast(`${id} → ${toName}（已写入台账）。原来的版本已不接新预约，所以不能撤回去`);
      app.reloadFeatures();
      app.refresh();
    } catch (e) {
      setMoves((m) => {
        if (m[id]?.seq !== my) return m;
        const n = { ...m };
        delete n[id];
        return n;
      });
      app.toast(`${mode === "undo" ? "没撤销成" : "没改成"}：${(e as Error).message}`, { kind: "err" });
    }
  };

  const verdict = (col: BoardColumn, p: DragPayload): DropVerdict | null => {
    if (p.kind !== "card") return null;
    const cur = columnOf(p.id)?.key ?? (p.data as BoardCard | null)?.column ?? null;
    if (cur === col.key) return { ok: false, hint: "已经在这一列" };
    if (!col.droppable) return { ok: false, hint: col.dropHint ?? "这一列不能放" };
    return { ok: true, hint: col.kind === "unreserved" ? "放到这里：取消预约" : `放到这里：预约到 ${col.title}` };
  };
  const drop = (col: BoardColumn, p: DragPayload) => {
    const fromCol = columnOf(p.id);
    const from = fromCol?.key ?? (p.data as BoardCard).column;
    if (from === col.key) return;
    // 原列已冻结 / 合并中：服务端不接回去，所以不给撤销
    void moveCard(p.id, from, col.key, "move", fromCol ? fromCol.droppable : true);
    // 落位反馈：目标列里它所在的组若是折叠的就展开，滚到它并回弹一下（不改选中）
    setFocus({ id: p.id, select: false, strict: false, at: Date.now() });
  };

  /* 深链：#/kanban/F-0041 → 滚到这张卡并选中；#/kanban/g:blocked → 筛选这一组。每个 sub 只处理一次 */
  const handledSub = useRef<string | null>(null);
  useEffect(() => {
    const sub = app.sub;
    if (!sub) {
      handledSub.current = null;
      return;
    }
    if (handledSub.current === sub) return;
    handledSub.current = sub;
    if (sub.startsWith("g:")) {
      const g = sub.slice(2);
      if (GROUPS.some((x) => x.key === g)) setFilter(g as TodoGroupKey);
      return;
    }
    setFocus({ id: sub, select: true, strict: true, at: Date.now() });
  }, [app.sub]);

  const scrollToCard = (id: string, card: BoardCard | null, tries = 0) => {
    const el = rootRef.current?.querySelector<HTMLElement>(`.kb-cols [data-key="${CSS.escape(id)}"]`);
    if (!el) {
      if (tries < 12) setTimeout(() => scrollToCard(id, card, tries + 1), 50);
      return;
    }
    el.scrollIntoView({ block: "center", inline: "nearest" });
    el.classList.add("landed");
    setTimeout(() => el.classList.remove("landed"), 420);
    if (card) app.select({ kind: "card", card });
  };
  useEffect(() => {
    if (!focus || !data) return;
    const col = cols.find((c) => c.cards.some((x) => x.id === focus.id));
    const card = col?.cards.find((x) => x.id === focus.id);
    if (!col || !card) {
      if (focus.strict) {
        app.toast(`看板里没有 ${focus.id}（可能已放弃，或不在这个项目里）`, { kind: "info" });
        setFocus(null);
      } else if (Date.now() - focus.at > 15000) setFocus(null);
      return;
    }
    setFocus(null);
    if (!passFilter(filter, card)) setFilter("all");
    if (!cardMatches(app.query, card)) app.setQuery("");
    if (col.kind !== "released") {
      const o = openOf(col.key);
      const g = groupOf(card);
      if (o[g] !== true) setOpenOf(col.key, { ...o, [g]: true });
    }
    // 晚一拍：等折叠组展开渲染出来，也等切页时清掉选中的那一下先执行
    setTimeout(() => scrollToCard(focus.id, focus.select ? card : null), 30);
  }, [focus, cols]);

  /* 列菜单：复制合并 Prompt（必须在点击的同一轮里把 Promise 交给剪贴板） */
  const copyPrompt = (col: BoardColumn) => {
    const req = api<MergePromptData>("/api/release/prompt", { body: { milestone: col.key } });
    const copied = copyWhenReady(req.then((r) => r.data.prompt));
    setMergeP({ title: col.title, st: { data: null, copied: null, error: null } });
    req
      .then(async (r) => {
        const ok = await copied;
        setMergeP({ title: col.title, st: { data: r.data, copied: ok, error: null } });
        app.toast(ok ? `已复制 ${col.title} 的合并 Prompt（只预演，不执行合并）` : `${col.title} 的合并 Prompt 已生成：点「复制 Prompt」`);
        app.refresh();
      })
      .catch((e: Error) => setMergeP({ title: col.title, st: { data: null, copied: false, error: e.message } }));
  };

  /* 搜索 × 筛选 */
  const q = app.query;
  const qCards = useMemo(() => cols.flatMap((c) => c.cards).filter((c) => cardMatches(q, c)), [cols, q]);
  const countOf = (g: TodoGroupKey) => qCards.filter((c) => !c.done && c.group === g).length;
  const filtering = filter !== "all" || !!q.trim();
  const shown = qCards.filter((c) => passFilter(filter, c)).length;
  const pass = (c: BoardCard) => passFilter(filter, c) && cardMatches(q, c);
  const extra = filter !== "all" && !FILTER_KEYS.includes(filter) ? GROUPS.find((g) => g.key === filter) : undefined;
  const sel = app.selected?.kind === "card" ? app.selected.card.id : null;

  const onAdded = (id: string) => setFocus({ id, select: false, strict: false, at: Date.now() });
  const onBlank = (e: MouseEvent) => {
    if (!app.selected) return;
    const t = e.target as HTMLElement | null;
    if (t?.closest(".block, button, input, select, textarea, a, form, .popover")) return;
    app.select(null);
  };

  const head = (
    <PageHead icon="kanban" title="看板" desc="一列一个版本；把方块拖到别的列就是预约（只写台账）。">
      {app.project ? (
        <>
          <div class="fchips kb-filters" role="group" aria-label="按状态筛选">
            <button class={`fchip${filter === "all" ? " on" : ""}`} aria-pressed={filter === "all"} onClick={() => setFilter("all")}>
              全部 <b>{qCards.length}</b>
            </button>
            {FILTER_KEYS.map((k) => {
              const g = GROUPS.find((x) => x.key === k)!;
              const n = countOf(k);
              const on = filter === k;
              // 没做冲突检查（试合）时，「撞了」不知道几块：写「未检查」而不是 0
              const unchecked = k === "conflict" && !app.precheck;
              return (
                <button
                  class={`fchip tone-${g.tone}${on ? " on" : ""}`}
                  aria-pressed={on}
                  disabled={unchecked || (!n && !on)}
                  title={unchecked ? "还没做冲突检查（试合）：点标题栏的「冲突检查」" : g.hint}
                  onClick={() => setFilter(on ? "all" : k)}
                >
                  <Dot tone={g.tone} />
                  {g.human} {unchecked ? <span class="tiny muted">未检查</span> : <b>{n}</b>}
                </button>
              );
            })}
            {extra ? (
              <button class={`fchip tone-${extra.tone} on`} aria-pressed={true} title={`${extra.hint}（点一下取消）`} onClick={() => setFilter("all")}>
                <Dot tone={extra.tone} />
                {extra.human} <b>{countOf(extra.key)}</b>
                <Icon name="close" size={12} />
              </button>
            ) : null}
          </div>
          <NewIdeaButton onAdded={onAdded} />
        </>
      ) : null}
    </PageHead>
  );

  if (!app.project) {
    return (
      <div class="page wide kb-page">
        {head}
        <Empty icon="kanban" title="还没有选项目" hint="先在「开始」里接入或选择一个项目，看板会按版本把方块排成列。">
          <button class="btn primary" onClick={() => app.go("start")}>
            去开始 / 接入
          </button>
        </Empty>
      </div>
    );
  }

  return (
    <div class="page wide kb-page" ref={rootRef}>
      {head}
      {app.featuresError ? <p class="err kb-err">读取功能卡失败：{app.featuresError}</p> : null}
      {data?.broken.length ? (
        <p class="err small kb-err">
          有 {data.broken.length} 个卡片文件读不出来：{data.broken.join("、")}
        </p>
      ) : null}
      {filtering && data ? (
        <p class="kb-note">
          <Icon name="filter" size={14} />
          <span>
            {filter !== "all" ? `只看「${GROUPS.find((g) => g.key === filter)?.human ?? filter}」` : "全部状态"}
            {q.trim() ? ` · 搜索「${q.trim()}」` : ""}：<b>{shown}</b> 个方块
          </span>
          <button
            class="link"
            onClick={() => {
              setFilter("all");
              if (q) app.setQuery("");
            }}
          >
            清除筛选
          </button>
        </p>
      ) : null}
      {!data ? (
        app.featuresError ? null : <KbSkeleton />
      ) : (
        <div class="kb-cols" ref={colsEl} onClick={onBlank}>
          {cols.map((col) => (
            <KbColumn
              key={col.key}
              col={col}
              pass={pass}
              filtering={filtering}
              open={openOf(col.key)}
              setOpen={(v) => setOpenOf(col.key, v)}
              selectedId={sel}
              verdict={verdict}
              drop={drop}
              onCopyPrompt={copyPrompt}
              onAdded={onAdded}
            />
          ))}
        </div>
      )}
      {data ? (
        <p class="kb-foot" title={data.ledgerDir}>
          看板只写台账（{data.ledgerDir}）{data.abandoned ? ` · 另有 ${data.abandoned} 张已放弃（不显示）` : ""} · 真正的 git 合并在终端：heliu 合并 &lt;版本&gt;，看完摘要输入 yes 才开始
        </p>
      ) : null}
      {mergeP ? (
        <MergePromptPanel
          st={mergeP.st}
          title={mergeP.title}
          onClose={() => setMergeP(null)}
          onSync={() => {
            setMergeP(null);
            setSyncOpen(true);
          }}
        />
      ) : null}
      {syncOpen ? (
        <MergedPanel
          onClose={() => setSyncOpen(false)}
          onChanged={() => {
            app.reloadFeatures();
            app.refresh();
          }}
        />
      ) : null}
    </div>
  );
}

/* ───────────── 一列 ───────────── */

interface ColProps {
  col: BoardColumn;
  pass: (c: BoardCard) => boolean;
  filtering: boolean;
  open: OpenState;
  setOpen: (v: OpenState) => void;
  selectedId: string | null;
  verdict: (col: BoardColumn, p: DragPayload) => DropVerdict | null;
  drop: (col: BoardColumn, p: DragPayload) => void;
  onCopyPrompt: (col: BoardColumn) => void;
  onAdded: (id: string) => void;
}

function KbColumn(p: ColProps) {
  const app = useApp();
  const { col } = p;
  const ref = useDropTarget({ canDrop: (x) => p.verdict(col, x), onDrop: (x) => p.drop(col, x) });
  const [menu, setMenu] = useState(false);
  const [adding, setAdding] = useState(false);
  const released = col.kind === "released";
  const unreserved = col.kind === "unreserved";
  const isMs = col.kind === "milestone" && !!col.milestone;
  // 冻结 / 合并中的版本服务端不接新预约，登记也会被拒，所以和已发布列一样不给 ＋
  const canAdd = col.droppable && !released;

  // 迷你分段条：按本列卡的分组加总，done 的不算
  const live = col.cards.filter((c) => !c.done);
  const n = (g: TodoGroupKey) => live.filter((c) => c.group === g).length;
  const parts: BarPart[] = [
    { tone: "purple", n: n("blocked"), label: "等你拍板" },
    { tone: "red", n: n("conflict"), label: "撞了" },
    { tone: "green", n: n("mergeable"), label: "能拼上" },
    { tone: "yellow", n: n("behind"), label: "要先对齐" },
  ];
  parts.push({ tone: "gray", n: live.length - parts.reduce((a, x) => a + x.n, 0), label: "还在做 / 没动静 / 还没绑分支" });

  const visible = col.cards.filter(p.pass);
  const buckets = BUCKETS.map((b) => ({ ...b, cards: visible.filter((c) => groupOf(c) === b.key) })).filter((b) => b.cards.length);

  const pillText = released ? "已发布" : unreserved ? "未预约" : null;
  const pill = released ? (
    <Pill tone="green">已发布</Pill>
  ) : unreserved ? (
    <Pill tone="gray">未预约</Pill>
  ) : col.isNext ? (
    <Pill brand>下一版</Pill>
  ) : col.milestone ? (
    <Pill tone={MILESTONE_TONE[col.milestone.status] ?? "gray"}>{col.milestone.status}</Pill>
  ) : null;
  const sub = [
    col.milestone?.title && col.milestone.title !== col.key ? col.milestone.title : null,
    col.milestone?.target_date ? `目标 ${col.milestone.target_date}` : null,
    unreserved ? "还没定进哪一版" : null,
    released ? "已经发布的版本（只读）" : null,
  ].filter(Boolean);

  const padText = !col.cards.length
    ? released
      ? "还没有已发布的方块"
      : unreserved
        ? "没有未预约的方块：拖到这里 = 取消预约"
        : col.droppable
          ? "这一版还没有方块：把方块拖到这里，或点 ＋ 登记新点子"
          : (col.dropHint ?? "这一列不能放")
    : col.droppable
      ? unreserved
        ? "拖到这里 = 取消预约"
        : `拖到这里 = 预约到 ${col.title}`
      : (col.dropHint ?? "这一列不能放");

  const renderCard = (c: BoardCard) => (
    <Block
      key={c.id}
      m={modelOfCard(c, { next: app.next })}
      density="card"
      selected={p.selectedId === c.id}
      onClick={() => app.select({ kind: "card", card: c })}
      drag={c.done || released ? undefined : { payload: { kind: "card", id: c.id, label: c.title, data: c } }}
      title={c.done || released ? "已合入 / 已发布的方块不再改预约" : undefined}
      hideMilestone
    />
  );

  return (
    <section ref={ref} class={`kb-col kind-${col.kind}${col.isNext ? " is-next" : ""}${col.droppable ? "" : " locked"}`} aria-label={released ? `已发布：${col.cards.length} 项` : `${col.title}：还欠 ${col.owed}`}>
      <header class="kb-col-head">
        <div class="kb-col-title">
          {pillText ? <Dot tone={released ? "green" : "gray"} /> : null}
          <h2 title={col.title}>{col.title}</h2>
          {/* 标题已经写了「未预约 / 已发布」就不再重复一个同名胶囊 */}
          {pill && pillText !== col.title ? pill : null}
          <span class="kb-col-tools">
            {canAdd ? (
              <button
                class={`icon-btn${adding ? " on" : ""}`}
                onClick={() => setAdding((a) => !a)}
                title={unreserved ? "登记新点子（先不预约）" : `在 ${col.title} 登记新点子`}
                aria-label={unreserved ? "登记新点子（先不预约）" : `在 ${col.title} 登记新点子`}
                aria-expanded={adding}
              >
                <Icon name="plus" size={16} />
              </button>
            ) : null}
            {!released ? (
              <div class="kb-menu-wrap">
                <button class={`icon-btn${menu ? " on" : ""}`} data-popover-anchor onClick={() => setMenu((m) => !m)} aria-label={`${col.title} 列菜单`} aria-expanded={menu} title="更多">
                  <Icon name="more" size={16} />
                </button>
                <Popover open={menu} onClose={() => setMenu(false)} class="kb-menu">
                  {isMs ? (
                    <>
                      <button
                        class="item"
                        onClick={() => {
                          setMenu(false);
                          p.onCopyPrompt(col);
                        }}
                      >
                        <Icon name="copy" size={16} />
                        <span>
                          复制合并 Prompt<span class="sub">刷新合并单并复制；只预演，不执行合并</span>
                        </span>
                      </button>
                      <button
                        class="item"
                        onClick={() => {
                          setMenu(false);
                          app.go("assembly", col.key);
                        }}
                      >
                        <Icon name="assembly" size={16} />
                        <span>
                          在装配里打开<span class="sub">按合并顺序看这一版每块能不能拼上</span>
                        </span>
                      </button>
                      <div class="sep" />
                    </>
                  ) : null}
                  <button
                    class="item"
                    onClick={() => {
                      setMenu(false);
                      p.setOpen(allOpen(true));
                    }}
                  >
                    <Icon name="chevron" size={16} />
                    <span>展开全部分组</span>
                  </button>
                  <button
                    class="item"
                    onClick={() => {
                      setMenu(false);
                      p.setOpen(allOpen(false));
                    }}
                  >
                    <Icon name="chevron-right" size={16} />
                    <span>收起全部分组</span>
                  </button>
                </Popover>
              </div>
            ) : null}
          </span>
        </div>
        {sub.length ? <p class="kb-col-sub">{sub.join(" · ")}</p> : null}
        {released ? (
          <div class="kb-owed">
            <span class="num">{col.cards.length}</span>
            <span class="k">项已发布</span>
          </div>
        ) : (
          <>
            <div class="kb-owed" title="还欠 = 这一列里台账状态还没到「已合入」的方块数">
              <span class="k">还欠</span>
              <span class="num">{col.owed}</span>
            </div>
            <Bar thin parts={parts} title="按方块张数：等你拍板 / 撞了 / 能拼上 / 要先对齐 / 其他" />
            <p class="kb-col-facts">
              <span>
                能拼上 <b>{col.mergeable}</b>
              </span>
              <span class="sep">·</span>
              {col.conflict === null ? (
                <span title="还没做冲突检查：点标题栏的「冲突检查」">冲突未检查</span>
              ) : (
                <span>
                  撞了 <b>{col.conflict}</b>
                </span>
              )}
              <span class="sep">·</span>
              <span>
                等你 <b>{col.waiting}</b>
              </span>
              {col.precheckFailed > 0 ? (
                <>
                  <span class="sep">·</span>
                  <span class="warn" title={col.precheckSummary?.firstError ?? "请求了试合但没得到结果：不算无冲突"}>
                    没试出来 <b>{col.precheckFailed}</b>
                  </span>
                </>
              ) : null}
            </p>
          </>
        )}
      </header>
      <div class="kb-col-body">
        {adding ? (
          <IdeaForm
            milestone={unreserved ? null : col.key}
            hint={unreserved ? "先不预约 · 只写台账" : `预约到 ${col.title} · 只写台账`}
            onDone={p.onAdded}
            onCancel={() => setAdding(false)}
          />
        ) : null}
        {released ? (
          visible.length ? <div class="group-body">{visible.map(renderCard)}</div> : null
        ) : (
          buckets.map((b, i) => {
            const isOpen = p.open[b.key] ?? (p.filtering || i < 2);
            return (
              <div class="block-group" key={b.key}>
                <GroupHead tone={b.tone} title={b.human} n={b.cards.length} open={isOpen} hint={b.hint} onToggle={() => p.setOpen({ ...p.open, [b.key]: !isOpen })} />
                {isOpen ? <div class="group-body">{b.cards.map(renderCard)}</div> : null}
              </div>
            );
          })
        )}
        {!visible.length && col.cards.length ? <p class="kb-empty">没有符合的方块</p> : null}
        <div class={`kb-drop-pad${col.cards.length ? "" : " empty"}`} aria-hidden="true">
          <span>{padText}</span>
        </div>
      </div>
    </section>
  );
}

/* ───────────── 新点子 ───────────── */

function NewIdeaButton({ onAdded }: { onAdded: (id: string) => void }) {
  const app = useApp();
  const [open, setOpen] = useState(false);
  return (
    <div class="kb-idea-wrap">
      <button class="btn primary" data-popover-anchor onClick={() => setOpen((o) => !o)} aria-expanded={open}>
        <Icon name="plus" size={16} /> 新点子
      </button>
      <Popover open={open} onClose={() => setOpen(false)} class="kb-idea-pop">
        <IdeaForm milestone={app.next ?? "next"} hint={`预约到下一版${app.next ? `（${app.next}）` : ""} · 只写台账`} onDone={onAdded} onCancel={() => setOpen(false)} />
      </Popover>
    </div>
  );
}

/** 一句话登记：回车 = POST /api/features {title, milestone}；milestone null = 先不预约（必须显式传，缺省服务端会预约到下一版） */
function IdeaForm({ milestone, hint, onDone, onCancel }: { milestone: string | null; hint: string; onDone: (id: string) => void; onCancel: () => void }) {
  const app = useApp();
  const [title, setTitle] = useState("");
  const [busy, setBusy] = useState(false);
  const submit = async (e: Event) => {
    e.preventDefault();
    const t = title.trim();
    if (!t || busy) return;
    setBusy(true);
    try {
      const r = await api<NewFeatureData>("/api/features", { body: { title: t, milestone } });
      const f = r.data.feature;
      app.toast(`已登记 ${f.id}，${f.milestone ? `预约 ${f.milestone}` : "先不预约"}${r.data.milestoneCreated ? `（顺手建了 ${r.data.milestoneCreated}）` : ""}（已写入台账）`);
      setTitle("");
      onDone(f.id);
      app.reloadFeatures();
      app.refresh();
    } catch (err) {
      app.toast(`没登记成：${(err as Error).message}`, { kind: "err" });
    } finally {
      setBusy(false);
    }
  };
  return (
    <form class="kb-new" onSubmit={(e) => void submit(e)}>
      <input
        type="text"
        value={title}
        autoFocus
        placeholder="一句话写需求，回车登记"
        aria-label="新点子标题"
        onInput={(e) => setTitle((e.target as HTMLInputElement).value)}
        onKeyDown={(e) => {
          if (e.key === "Escape") {
            e.stopPropagation();
            onCancel();
          }
        }}
      />
      <div class="kb-new-foot">
        <span class="hint">{hint}</span>
        <button class="btn small ghost" type="button" onClick={onCancel}>
          取消
        </button>
        <button class="btn small primary" type="submit" disabled={busy || !title.trim()}>
          {busy ? "登记中…" : "登记"}
        </button>
      </div>
    </form>
  );
}

/* ───────────── 骨架 ───────────── */

function KbSkeleton() {
  return (
    <>
      <p class="kb-note">正在对账并试合（只读，merge-tree 在临时区进行，不碰仓库）…</p>
      <div class="kb-cols" aria-busy="true" aria-label="正在读取看板">
        {[3, 2, 1].map((k) => (
          <div class="kb-col kb-skel" key={k}>
            <div class="kb-col-head">
              <div class="skeleton kb-skel-title" />
              <div class="skeleton kb-skel-num" />
              <div class="skeleton kb-skel-bar" />
            </div>
            <div class="kb-col-body">
              {Array.from({ length: k }, (_, j) => (
                <div class="skeleton kb-skel-card" key={j} />
              ))}
            </div>
          </div>
        ))}
      </div>
    </>
  );
}

 succeeded in 0ms:
/** @jsxImportSource preact */
/**
 * 时间线（M10，甘特 / WBS）：左栏 = 仓库 → 模块 → 方块的树，右侧 = 时间轴；每一块画一条「活跃区间」。
 * - 布局全部来自 web/timeline-model.ts（纯函数，有测试）；这里只渲染、管折叠 / 筛选 / 拖放。
 * - 颜色只读服务端 card.light；没卡的分支固定蓝「还没登记」。起点是近似的条画虚线边并在提示里写明，不假装精确。
 * - 拖条（或左栏方块）到上面的版本芯片 = 预约（PATCH /api/features/:id）；没卡的分支 = 登记成卡并预约（POST /api/features）；
 *   拖卡到左栏的模块行 = 改模块。只写台账，不碰 git；每次松手 toast 说明写了什么，改卡的给「撤销」。
 */
import { useEffect, useMemo, useRef, useState } from "preact/hooks";
import type { BoardCard } from "../../src/board/api-types.ts";
import { OTHER_MODULE } from "../../src/core/classify.ts";
import type { FeatureView, LedgerMilestone } from "../../src/types.ts";
import { milestoneLabel, useApp } from "../app.tsx";
import { dragProps, useDropTarget, type DragPayload } from "../dnd.ts";
import { api, mdhm, store } from "../lib.ts";
import {
  RANGES,
  axisWidth,
  buildTimeline,
  countByTone,
  flattenRows,
  isRange,
  mmdd,
  moduleKey,
  parseDay,
  repoKey,
  todayScrollLeft,
  withCardPatch,
  type TLItem,
  type TLModuleNode,
  type TLRange,
  type TLRepoNode,
  type TLRow,
  type TLTone,
} from "../timeline-model.ts";
import { Bar, Block, Empty, HUMAN, Icon, MILESTONE_TONE, PageHead, Pill, Seg, matchQuery, modelOfBranch, modelOfCard, type BarPart, type BlockModel, type Tone } from "../ui.tsx";

const RANGE_KEY = "heliu.tl.range";
const msg = (e: unknown): string => (e as Error)?.message ?? String(e);

type Filter = "all" | TLTone;
const FILTERS: Array<{ key: Filter; label: string; tone?: Tone }> = [
  { key: "all", label: "全部" },
  { key: "purple", label: HUMAN.purple, tone: "purple" },
  { key: "red", label: HUMAN.red, tone: "red" },
  { key: "green", label: HUMAN.green, tone: "green" },
  { key: "yellow", label: HUMAN.yellow, tone: "yellow" },
  { key: "blue", label: HUMAN.blue, tone: "blue" },
];
/** 模块行分布条的颜色顺序（最需要人的在前） */
const TONE_ORDER: TLTone[] = ["purple", "red", "yellow", "green", "gray", "blue"];

/** 没卡的分支被拖起时带的数据：登记成卡要用 */
interface BranchDrag {
  repo: string;
  repoLabel: string;
  branch: FeatureView;
  title: string;
  type: string;
  module: string;
}
type CardPatch = Partial<Pick<BoardCard, "module" | "moduleSource" | "milestone" | "column">>;

export function TimelineView() {
  const app = useApp();
  const [range, setRangeState] = useState<TLRange>(() => {
    const v = store.get(RANGE_KEY);
    return isRange(v) ? v : "1m";
  });
  const setRange = (r: TLRange) => {
    store.set(RANGE_KEY, r);
    setRangeState(r);
  };
  const [filter, setFilter] = useState<Filter>("all");
  const [collapsed, setCollapsed] = useState<Set<string>>(() => new Set());
  const [hover, setHover] = useState<string | null>(null);

  /* 乐观更新：松手后先按新值画，数据刷新后丢掉；请求失败也丢掉（= 回滚） */
  const [over, setOver] = useState<Record<string, CardPatch>>({});
  useEffect(() => setOver({}), [app.features]);
  const feats = useMemo(() => Object.entries(over).reduce((f, [id, p]) => withCardPatch(f, id, p), app.features), [app.features, over]);

  /* 时间轴宽度：量可视区，范围短时每天更宽、放不下就横向滚动 */
  const bodyRef = useRef<HTMLDivElement>(null);
  const cornerRef = useRef<HTMLDivElement>(null);
  const [visible, setVisible] = useState(0);
  const leftW = () => cornerRef.current?.offsetWidth ?? 260;

  const now = useMemo(() => new Date(), [app.tick, app.status, app.features]);
  const width = axisWidth(range, Math.max(320, (visible || 1100) - leftW()), now);
  const model = useMemo(
    () => buildTimeline(app.status, feats, { now, range, width, modules: feats?.modules, milestones: app.milestones.length ? app.milestones : undefined }),
    [app.status, feats, now, range, width, app.milestones],
  );
  const nothing = !model.items.length && !model.counts.entries && !model.tree.some((n) => n.error);
  const hasBody = !!app.project && !!app.features && !nothing;
  useEffect(() => {
    const el = bodyRef.current;
    if (!hasBody || !el) return;
    const measure = () => setVisible(el.clientWidth);
    measure();
    if (typeof ResizeObserver === "undefined") {
      window.addEventListener("resize", measure);
      return () => window.removeEventListener("resize", measure);
    }
    const ro = new ResizeObserver(measure);
    ro.observe(el);
    return () => ro.disconnect();
  }, [hasBody]);

  /* 方块模型：页面现算（与看板 / 详情同一个 modelOfCard / modelOfBranch） */
  const blocks = useMemo(() => {
    const out = new Map<string, BlockModel>();
    for (const it of model.items) {
      if (it.card) out.set(it.key, modelOfCard(it.card, { next: app.next }));
      else if (it.branch) out.set(it.key, modelOfBranch(it.branch, { id: it.repo, label: it.repoLabel }, feats?.modules));
    }
    return out;
  }, [model, app.next]);

  /* 搜索（标题栏）+ 颜色筛选 */
  const q = app.query.trim();
  const byQuery = (it: TLItem) =>
    matchQuery(q, it.title, it.card?.id, it.repoLabel, it.module, it.branch?.branch, ...(it.card?.bindings.map((b) => b.branch) ?? []), ...(it.card?.bindings.map((b) => b.label) ?? []));
  const queried = q ? model.items.filter(byQuery) : model.items;
  const tones = countByTone(queried);
  const filtering = !!q || filter !== "all";
  const keep = filtering ? (it: TLItem) => (filter === "all" || it.tone === filter) && byQuery(it) : undefined;
  const flat = useMemo(() => flattenRows(model.tree, { collapsed, keep }), [model, collapsed, q, filter]);

  /* 回到今天：今天落在可视时间轴 80% 处 */
  const toToday = (smooth: boolean) => {
    const el = bodyRef.current;
    if (!el) return;
    el.scrollTo({ left: todayScrollLeft(model.todayX, el.clientWidth, leftW()), behavior: smooth ? "smooth" : "auto" });
  };
  // 第一次量到宽度、或换了范围：把今天放到 80% 处；同一范围里的数据刷新不动用户的滚动位置
  const scrolledFor = useRef<TLRange | null>(null);
  useEffect(() => {
    if (!visible || !hasBody || scrolledFor.current === range) return;
    scrolledFor.current = range;
    toToday(false);
  }, [range, visible, hasBody]);

  /* 深链 #/timeline/F-0041：展开所在组、滚到那一行、选中 */
  const linked = useRef<string | null>(null);
  useEffect(() => {
    const sub = app.sub;
    if (!sub || linked.current === sub) return;
    const it = model.items.find((x) => x.key === sub || x.card?.id === sub);
    if (!it) return;
    linked.current = sub;
    setFilter("all");
    setCollapsed((s) => {
      const n = new Set(s);
      n.delete(repoKey(it.repo));
      n.delete(moduleKey(it.repo, it.module));
      return n;
    });
    // 等两帧再选中：切页时外壳会先清空选中（main.tsx 的 [tab] effect 在子组件之后跑）
    requestAnimationFrame(() =>
      requestAnimationFrame(() => {
        pick(it);
        const row = bodyRef.current?.querySelector(`[data-row="${CSS.escape(it.key)}"]`) as HTMLElement | null;
        row?.scrollIntoView({ block: "center" });
        const el = bodyRef.current;
        if (el) el.scrollTo({ left: Math.max(0, it.x1 - (el.clientWidth - leftW()) * 0.6) });
      }),
    );
  }, [app.sub, model]);

  const toggle = (key: string) =>
    setCollapsed((s) => {
      const n = new Set(s);
      if (n.has(key)) n.delete(key);
      else n.add(key);
      return n;
    });

  /* 选中 */
  const selKey = app.selected ? (app.selected.kind === "card" ? app.selected.card.id : `${app.selected.repo}|${app.selected.branch.branch}`) : null;
  const pick = (it: TLItem) => {
    if (it.card) app.select({ kind: "card", card: it.card });
    else if (it.branch) app.select({ kind: "branch", repo: it.repo, repoLabel: it.repoLabel, branch: it.branch, main: it.main ?? "", integration: it.integration });
  };
  const payloadOf = (it: TLItem): DragPayload | null => {
    if (it.card) return { kind: "card", id: it.card.id, label: it.card.id, data: it.card };
    if (!it.branch) return null;
    const m = blocks.get(it.key);
    const data: BranchDrag = { repo: it.repo, repoLabel: it.repoLabel, branch: it.branch, title: it.title, type: m?.type ?? "功能", module: m?.module ?? it.module };
    return { kind: "branch", id: it.key, label: it.title, data };
  };

  /* 写台账：改卡（乐观 + 撤销）/ 从分支建卡 */
  const patchCard = async (card: BoardCard, body: Record<string, unknown>, optimistic: CardPatch, okText: string, undo: { body: Record<string, unknown>; text: string }) => {
    setOver((o) => ({ ...o, [card.id]: { ...o[card.id], ...optimistic } }));
    try {
      await api(`/api/features/${encodeURIComponent(card.id)}`, { method: "PATCH", body });
      app.toast(okText, {
        undo: async () => {
          try {
            await api(`/api/features/${encodeURIComponent(card.id)}`, { method: "PATCH", body: undo.body });
            app.toast(`已撤销：${card.id} ${undo.text}`);
          } catch (e) {
            app.toast(`没撤销成：${msg(e)}`, { kind: "err" });
          } finally {
            app.reloadFeatures();
            app.refresh();
          }
        },
      });
      app.reloadFeatures();
      app.refresh();
    } catch (e) {
      setOver((o) => {
        const n = { ...o };
        delete n[card.id];
        return n;
      });
      app.toast(`没改成：${msg(e)}`, { kind: "err" });
    }
  };
  const reserve = (card: BoardCard, ms: LedgerMilestone) => {
    const name = milestoneLabel(ms.id, app.milestones, app.next);
    // 原值（撤销用）：与详情面板同一口径
    const back = card.milestone === "next" ? (app.next ?? null) : card.column === "__unreserved" ? null : card.milestone;
    const backName = back ? milestoneLabel(back, app.milestones, app.next) : "未预约";
    void patchCard(card, { milestone: ms.id }, { milestone: ms.id, column: ms.id }, `${card.id} → ${name}（已写入台账）`, { body: { milestone: back }, text: `改回${backName}` });
  };
  const register = async (b: BranchDrag, ms: LedgerMilestone) => {
    const name = milestoneLabel(ms.id, app.milestones, app.next);
    try {
      const r = await api<{ feature: { id: string; title: string }; milestoneCreated: string | null }>("/api/features", {
        body: { title: b.title, milestone: ms.id, bind: { repo: b.repo, branch: b.branch.branch }, type: b.type, module: b.module },
      });
      app.toast(`已登记 ${r.data.feature.id}「${r.data.feature.title}」，预约到 ${name}（已写入台账；可在详情里改预约）`);
      app.reloadFeatures();
      app.refresh();
    } catch (e) {
      app.toast(`没登记成：${msg(e)}`, { kind: "err" });
    }
  };
  const moveModule = (card: BoardCard, module: string) => {
    const back = card.moduleSource === "card" ? card.module : null;
    void patchCard(card, { module }, { module, moduleSource: "card" }, `${card.id} 模块 → ${module}（已写入台账）`, { body: { module: back }, text: `模块改回${back ?? "推测"}` });
  };

  /* ───────────── 渲染 ───────────── */

  const head = (
    <PageHead icon="timeline" title="时间线" desc="每一块什么时候在动、里程碑在哪；把条拖到上面的版本芯片 = 预约。">
      <Seg options={RANGES.map((r) => ({ value: r.value, label: r.label }))} value={range} onChange={setRange} />
      <button class="btn small" onClick={() => toToday(true)} title="把今天放回时间轴右侧">
        <Icon name="calendar" size={15} />
        回到今天
      </button>
    </PageHead>
  );

  if (!app.project) {
    return (
      <div class="page wide tl-page">
        {head}
        <Empty icon="start" title="还没有选项目" hint="先在「开始」里接入或选择一个项目。">
          <button class="btn primary" onClick={() => app.go("start")}>
            去「开始」
          </button>
        </Empty>
      </div>
    );
  }
  if (!app.features && app.featuresError) {
    return (
      <div class="page wide tl-page">
        {head}
        <div class="err">功能卡没拿到：{app.featuresError}</div>
      </div>
    );
  }
  if (!app.features) {
    return (
      <div class="page wide tl-page">
        {head}
        <div class="tl-skeleton" aria-busy="true" aria-label="正在加载时间线">
          {[0, 1, 2, 3, 4, 5].map((i) => (
            <div class="tl-sk-row">
              <span class="skeleton" style={`width:${i % 3 === 0 ? 140 : 200}px`} />
              <span class="skeleton" style={`margin-left:${60 + ((i * 97) % 300)}px;width:${120 + ((i * 53) % 220)}px`} />
            </div>
          ))}
        </div>
      </div>
    );
  }

  const chips = app.milestones.filter((m) => m.status !== "已发布");
  const inWindowMs = model.milestones.filter((m) => m.inWindow);
  const W = model.width;

  return (
    <div class="page wide tl-page">
      {head}

      <div class="tl-toolbar">
        <div class="fchips" role="group" aria-label="按状态筛选">
          {FILTERS.map((f) => {
            const n = f.key === "all" ? queried.length : (tones[f.key] ?? 0);
            // 没做冲突检查（试合）时，「撞了」不知道几块：写「未检查」而不是 0（Codex 第 1 轮建议）
            const unchecked = f.label === "撞了" && !app.precheck;
            return (
              <button
                class={`fchip${filter === f.key ? " on" : ""}${f.tone ? ` tone-${f.tone}` : ""}`}
                disabled={unchecked || (f.key !== "all" && !n && filter !== f.key)}
                title={unchecked ? "还没做冲突检查（试合）：点标题栏的「冲突检查」" : undefined}
                onClick={() => setFilter(f.key)}
                aria-pressed={filter === f.key}
              >
                {f.label} {unchecked ? <span class="tiny muted">未检查</span> : <b>{n}</b>}
              </button>
            );
          })}
        </div>
        {!app.status ? (
          <span class="tl-note">{app.statusError ? `分支数据没拿到（${app.statusError}）：先只画功能卡` : "分支数据还在加载：先画功能卡"}</span>
        ) : null}
      </div>

      <div class="tl-ms-chips" aria-label="版本芯片：把条拖上来 = 预约">
        <span class="tl-ms-lead">
          <Icon name="arrow" size={14} />
          拖到版本上 = 预约
        </span>
        {chips.length ? (
          chips.map((m) => <VersionChip key={m.id} ms={m} onReserve={reserve} onRegister={register} onLocate={(x) => locate(bodyRef.current, x, leftW())} line={model.milestones.find((l) => l.id === m.id) ?? null} />)
        ) : (
          <span class="muted small">还没有未发布的版本：在看板里新建一个版本后就能拖上来预约。</span>
        )}
      </div>

      {nothing ? (
        <Empty icon="timeline" title="还没有可以画的方块" hint="登记一张功能卡，或在被管理的仓库里开一条分支，它就会出现在这里。" />
      ) : (
        <>
          <div class="tl-body" ref={bodyRef} onPointerLeave={() => setHover(null)}>
            <div class="tl-grid" style={`width:calc(var(--tl-left) + ${W}px)`}>
              <div class="tl-head">
                <div class="tl-corner" ref={cornerRef}>
                  <span>
                    WBS · <b>{flat.shown}</b> 块
                  </span>
                  <button
                    class="btn ghost xs"
                    onClick={() => setCollapsed((s) => (s.size ? new Set() : new Set(model.tree.map((n) => repoKey(n.repo)))))}
                    title={collapsed.size ? "全部展开" : "全部收起"}
                  >
                    {collapsed.size ? "全部展开" : "全部收起"}
                  </button>
                </div>
                <div class="tl-scale" style={`width:${W}px`}>
                  {model.ticks.map((t) =>
                    t.kind === "today" ? (
                      <span class="tl-tick today" style={`left:${t.x}px`}>
                        今天
                      </span>
                    ) : t.label ? (
                      <span class={`tl-tick${t.major ? " major" : ""}`} style={`left:${t.x}px`} title={mdhm(new Date(t.t).toISOString())}>
                        {t.label}
                      </span>
                    ) : null,
                  )}
                  {inWindowMs.map((m) => (
                    <span class="tl-ms-label" style={`left:${Math.max(36, Math.min(W - 36, m.x))}px`} title={`${m.id}${m.title !== m.id ? ` ${m.title}` : ""} · 目标日期 ${mmdd(m.date.getTime())} · ${m.status}`}>
                      <Pill tone={MILESTONE_TONE[m.status] ?? "accent"}>
                        {m.id} · {mmdd(m.date.getTime())}
                      </Pill>
                    </span>
                  ))}
                </div>
              </div>

              <div class="tl-rows" style={flat.rows.length ? `height:${flat.height}px` : undefined}>
                <div class="tl-lines" style={`width:${W}px;height:${Math.max(flat.height, 120)}px`} aria-hidden="true">
                  {model.ticks.map((t) => (t.kind === "today" ? null : <i class={`tl-gridline${t.major ? " major" : ""}`} style={`left:${t.x}px`} />))}
                  {inWindowMs.map((m) => (
                    <i class={`tl-ms tone-${MILESTONE_TONE[m.status] ?? "accent"}`} style={`left:${m.x}px`} />
                  ))}
                  {model.todayX >= 0 && model.todayX <= W ? <i class="tl-today" style={`left:${model.todayX}px`} /> : null}
                </div>
                {flat.rows.length ? (
                  flat.rows.map((r) => (
                    <Row
                      key={r.key}
                      r={r}
                      width={W}
                      hover={hover === r.key}
                      onHover={setHover}
                      selKey={selKey}
                      blocks={blocks}
                      onToggle={toggle}
                      onPick={pick}
                      payloadOf={payloadOf}
                      onModuleDrop={moveModule}
                      onSessions={() => app.go("sessions")}
                    />
                  ))
                ) : (
                  <div class="tl-none">
                    <Empty inline icon="filter" title="没有符合筛选的方块" hint={q ? `搜索「${q}」` : undefined}>
                      <button
                        class="btn small"
                        onClick={() => {
                          setFilter("all");
                          app.setQuery("");
                        }}
                      >
                        清除筛选
                      </button>
                    </Empty>
                  </div>
                )}
              </div>
            </div>
          </div>
          <p class="tl-legend">
            <span>
              <i class="lg-bar" />条 = 从最早到最后一次可见活动
            </span>
            <span>
              <i class="lg-bar approx" />虚线边 = 起点为近似（最早可见活动）
            </span>
            <span>
              <i class="lg-dot" />只有一个时间点
            </span>
            <span>
              <i class="lg-dot hollow" />还没有活动记录（画在现在）
            </span>
            <span>
              <b>←</b> 起点或最后活动早于时间窗
            </span>
            <span>
              <i class="lg-ms" />版本目标日期
            </span>
          </p>
        </>
      )}
    </div>
  );
}

/** 点版本芯片：把它的目标日期线滚进可视区 */
function locate(el: HTMLDivElement | null, x: number, left: number) {
  if (!el) return;
  el.scrollTo({ left: Math.max(0, x - (el.clientWidth - left) / 2), behavior: "smooth" });
}

/* ───────────── 版本芯片（落点） ───────────── */

const targetOf = (ms: LedgerMilestone): number | null => parseDay(ms.target_date);

function VersionChip({
  ms,
  line,
  onReserve,
  onRegister,
  onLocate,
}: {
  ms: LedgerMilestone;
  line: { x: number; inWindow: boolean } | null;
  onReserve: (c: BoardCard, ms: LedgerMilestone) => void;
  onRegister: (b: BranchDrag, ms: LedgerMilestone) => Promise<void>;
  onLocate: (x: number) => void;
}) {
  const app = useApp();
  const name = milestoneLabel(ms.id, app.milestones, app.next);
  const col = app.features?.columns.find((c) => c.key === ms.id) ?? null;
  const blocked = col && !col.droppable ? (col.dropHint ?? `${name} 现在不能再预约（${ms.status}）`) : null;
  const ref = useDropTarget({
    canDrop: (p) => {
      if (p.kind === "card") {
        const c = p.data as BoardCard;
        if (c.column === ms.id || (c.milestone === "next" && app.next === ms.id)) return { ok: false, hint: "已经在这一版" };
        if (c.done) return { ok: false, hint: "已完成的卡不再改预约" };
        if (blocked) return { ok: false, hint: blocked };
        return { ok: true, hint: `放到这里：预约到 ${name}` };
      }
      if (p.kind === "branch") {
        if (blocked) return { ok: false, hint: blocked };
        return { ok: true, hint: `放到这里：登记成功能卡并预约到 ${name}` };
      }
      return null;
    },
    onDrop: (p) => {
      if (p.kind === "card") onReserve(p.data as BoardCard, ms);
      else if (p.kind === "branch") return onRegister(p.data as BranchDrag, ms);
    },
  });
  const isNext = app.next === ms.id;
  return (
    <div
      class={`tl-chip${isNext ? " next" : ""}`}
      ref={ref}
      role="button"
      tabIndex={0}
      title={`${name} · ${ms.status}${ms.target_date ? ` · 目标日期 ${ms.target_date}` : " · 还没定目标日期"}${line && !line.inWindow ? "（不在当前时间窗里）" : ""}`}
      onClick={() => line && line.inWindow && onLocate(line.x)}
      onKeyDown={(e) => {
        if ((e.key === "Enter" || e.key === " ") && line && line.inWindow) {
          e.preventDefault();
          onLocate(line.x);
        }
      }}
    >
      <b class="name">{name}</b>
      <Pill tone={MILESTONE_TONE[ms.status] ?? "gray"}>{isNext ? "下一版" : ms.status}</Pill>
      <span class="meta">
        {targetOf(ms) !== null ? `目标 ${mmdd(targetOf(ms)!)}` : "没定日期"}
        {col ? ` · 还欠 ${col.owed}` : ""}
      </span>
    </div>
  );
}

/* ───────────── 一行（左栏 + 时间轴，同一个 DOM 行 = 天然对齐） ───────────── */

interface RowProps {
  r: TLRow;
  width: number;
  hover: boolean;
  onHover: (k: string | null) => void;
  selKey: string | null;
  blocks: Map<string, BlockModel>;
  onToggle: (key: string) => void;
  onPick: (it: TLItem) => void;
  payloadOf: (it: TLItem) => DragPayload | null;
  onModuleDrop: (c: BoardCard, module: string) => void;
  onSessions: () => void;
}

function Row(p: RowProps) {
  const { r } = p;
  const cls = [`tl-row`, `k-${r.kind}`];
  if (p.hover) cls.push("hover");
  if (r.kind === "item" && p.selKey === r.item.key) cls.push("selected");
  return (
    <div class={cls.join(" ")} style={`height:${r.h}px`} data-row={r.key} onPointerEnter={() => p.onHover(r.key)}>
      {r.kind === "repo" ? <RepoHead r={r} onToggle={p.onToggle} /> : null}
      {r.kind === "module" ? <ModuleHead r={r} onToggle={p.onToggle} onDrop={p.onModuleDrop} /> : null}
      {r.kind === "entries" ? (
        <div class="tl-left tl-entries" title="这些分支没有自己的提交（多半只是桌面会话的入口），不画成工作条">
          <span class="glyph">◌</span>
          <span class="name">会话入口 {r.count}</span>
          {r.waiting ? <Pill tone="purple">等你 {r.waiting}</Pill> : null}
          <button class="link small" onClick={p.onSessions}>
            看会话
          </button>
        </div>
      ) : null}
      {r.kind === "item" ? <ItemLeft it={r.item} m={p.blocks.get(r.item.key)} selected={p.selKey === r.item.key} onPick={p.onPick} payloadOf={p.payloadOf} /> : null}
      <div class="tl-right" style={`width:${p.width}px`}>
        {r.kind === "item" ? <Track it={r.item} m={p.blocks.get(r.item.key)} selected={p.selKey === r.item.key} onPick={p.onPick} payloadOf={p.payloadOf} width={p.width} /> : null}
        {r.kind === "module" || (r.kind === "repo" && !r.open) ? <Summary items={r.items} /> : null}
      </div>
    </div>
  );
}

function RepoHead({ r, onToggle }: { r: Extract<TLRow, { kind: "repo" }>; onToggle: (k: string) => void }) {
  const n: TLRepoNode = r.node;
  return (
    <div class="tl-left tl-repo">
      <button class={`tl-toggle${r.open ? "" : " closed"}`} onClick={() => onToggle(r.key)} aria-expanded={r.open} disabled={!!n.error} title={n.error ? undefined : r.open ? "收起" : "展开"}>
        <Icon name="chevron" size={14} class="chev" />
        <Icon name={n.pseudo ? "info" : "folder"} size={15} />
        <span class="name">{n.label}</span>
      </button>
      {n.error ? (
        <span class="tl-err" title={n.error}>
          不可达：{n.error}
        </span>
      ) : (
        <span class="badge">{r.count} 块</span>
      )}
    </div>
  );
}

function ModuleHead({ r, onToggle, onDrop }: { r: Extract<TLRow, { kind: "module" }>; onToggle: (k: string) => void; onDrop: (c: BoardCard, module: string) => void }) {
  const m: TLModuleNode = r.node;
  const ref = useDropTarget({
    canDrop: (p) => {
      if (p.kind !== "card") return null;
      const c = p.data as BoardCard;
      if (c.done) return null;
      if ((c.module || OTHER_MODULE) === m.module) return { ok: false, hint: "已经在这个模块" };
      return { ok: true, hint: `放到这里：模块改成「${m.module}」` };
    },
    onDrop: (p) => onDrop(p.data as BoardCard, m.module),
  });
  const parts: BarPart[] = TONE_ORDER.map((t) => ({ tone: t, n: r.tones[t] ?? 0, label: HUMAN[t] }));
  return (
    <div class="tl-left tl-module" ref={ref}>
      <button class={`tl-toggle${r.open ? "" : " closed"}`} onClick={() => onToggle(r.key)} aria-expanded={r.open} title={`模块：${m.module}（把功能卡拖到这里 = 改模块）`}>
        <Icon name="chevron" size={13} class="chev" />
        <span class="name">{m.module}</span>
        <span class="n">{r.count}</span>
      </button>
      <span class="tl-mbar">
        <Bar thin parts={parts} />
      </span>
    </div>
  );
}

function tipOf(it: TLItem, m: BlockModel | undefined): string {
  const lines = [it.title];
  if (m) lines.push(`${m.human}${m.fact ? `：${m.fact}` : ""}`);
  const startText = it.start ? `${it.startKind === "created" ? "创建" : "约"} ${mdhm(it.start.toISOString())}` : "没有起点";
  if (it.endKind === "none") lines.push("还没有可见活动：画在现在");
  else if (it.shape === "dot") lines.push(`只有一个时间点：${mdhm(it.end.toISOString())}`);
  else lines.push(`${startText} → ${mdhm(it.end.toISOString())}`);
  if (it.startKind === "approx" && it.shape === "bar") lines.push("起点为近似（最早可见活动）");
  if (it.outside) lines.push(`最后活动 ${mdhm(it.end.toISOString())}，早于时间窗`);
  else if (it.clippedLeft) lines.push("起点早于时间窗：从窗左边起画");
  return lines.join("\n");
}

function ItemLeft({ it, m, selected, onPick, payloadOf }: { it: TLItem; m: BlockModel | undefined; selected: boolean; onPick: (it: TLItem) => void; payloadOf: (it: TLItem) => DragPayload | null }) {
  if (!m) return <div class="tl-left tl-item" />;
  return (
    <div class="tl-left tl-item">
      <Block m={m} density="compact" selected={selected} onClick={() => onPick(it)} drag={{ payload: () => payloadOf(it) }} title={tipOf(it, m)} />
    </div>
  );
}

function Track({ it, m, selected, onPick, payloadOf, width }: { it: TLItem; m: BlockModel | undefined; selected: boolean; onPick: (it: TLItem) => void; payloadOf: (it: TLItem) => DragPayload | null; width: number }) {
  const tip = tipOf(it, m);
  const tone = it.tone;
  const common = {
    title: tip,
    role: "button" as const,
    tabIndex: -1,
    onClick: () => onPick(it),
    ...dragProps(() => payloadOf(it)),
  };
  if (it.outside) {
    return (
      <div class={`tl-stub tone-${tone}${selected ? " selected" : ""}`} {...common}>
        <i class="dot" />← {mmdd(it.end.getTime())}
      </div>
    );
  }
  if (it.shape === "dot") {
    const labelRoom = width - it.x1 > 140;
    return (
      <>
        <div class={`tl-dot tone-${tone}${it.endKind === "none" ? " hollow" : ""}${selected ? " selected" : ""}`} style={`left:${it.x1}px`} {...common} />
        {labelRoom ? (
          <span class="tl-dot-label" style={`left:${it.x1 + 12}px`}>
            {it.title}
          </span>
        ) : null}
      </>
    );
  }
  const w = Math.max(10, it.x1 - it.x0);
  const cls = ["tl-bar", `tone-${tone}`];
  if (it.startKind === "approx") cls.push("approx");
  if (it.clippedLeft) cls.push("clipped");
  if (selected) cls.push("selected");
  return (
    <div class={cls.join(" ")} style={`left:${it.x0}px;width:${w}px`} {...common}>
      {it.clippedLeft ? <span class="tl-clip">←</span> : null}
      {w >= 60 ? <span class="tl-bar-title">{m?.title ?? it.title}</span> : null}
    </div>
  );
}

/** 组行上的摘要条：组内条目在时间窗里的范围（淡色细条） */
function Summary({ items }: { items: TLItem[] }) {
  const inside = items.filter((i) => !i.outside);
  if (!inside.length) return null;
  const x0 = Math.min(...inside.map((i) => i.x0));
  const x1 = Math.max(...inside.map((i) => i.x1));
  return <i class="tl-summary" style={`left:${x0}px;width:${Math.max(6, x1 - x0)}px`} />;
}
/** @jsxImportSource preact */
/**
 * 合流装配（M10，替代旧「合并预演」页）：像拼积木一样把这一版的方块按顺序摆上「合流轨道」，看每一块能不能拼上、先合谁后合谁。
 * - 数据只来自 GET /api/release/preview（与 heliu 合并 <版本> --预演 同一个合并单构建器）：档位 / 冲突 / 落后都是服务端事实，前端不自己判断 git。
 * - 写只走 POST /api/release/decision（拖进轨道 = 并入；开关 = 并入 / 待定 / 不并 / 顺延）、/api/release/plan、/api/release/prompt，
 *   以及 merge-flow.tsx 封装的 /api/merged。全部只写台账与合并单文件，页面任何地方都不执行 git 合并（M4：合并只在终端 yes 后执行）。
 */
import { useEffect, useMemo, useRef, useState } from "preact/hooks";
import type { BoardCard, Light, MergePromptData, ReleaseDecisionResult, ReleaseItem, ReleasePlanResult, ReleasePreview, ReleaseTier } from "../../src/board/api-types.ts";
import { useApp, type AppState } from "../app.tsx";
import { useDropTarget, type DragPayload } from "../dnd.ts";
import { api, copyWhenReady, hms, useApi } from "../lib.ts";
import { MergedPanel, MergePromptPanel, type PromptState } from "../merge-flow.tsx";
import { Block, Empty, GroupHead, Icon, matchQuery, modelOfCard, PageHead, Pill, Seg, Stat, type BlockChip, type BlockModel, type SegOption, type Tone } from "../ui.tsx";

/* ───────────── 档位（顺序 = 左栏分堆顺序） ───────────── */

interface TierDef {
  key: ReleaseTier;
  human: string;
  tone: Tone;
  light: Light;
  hint: string;
}
const TIERS: TierDef[] = [
  { key: "clean", human: "能拼上", tone: "green", light: "green", hint: "试合无冲突：默认并入" },
  { key: "in_integration", human: "已在集成分支", tone: "green", light: "green", hint: "绑定分支已被集成分支包含：执行时跳过" },
  { key: "conflict", human: "撞了", tone: "red", light: "red", hint: "试合有冲突文件：并入前要先解" },
  { key: "precheck_failed", human: "没试出来", tone: "yellow", light: "yellow", hint: "没得到试合结果：不算无冲突，也不自动顺延（默认待定）" },
  { key: "unfinished", human: "还没做完", tone: "gray", light: "gray", hint: "会话等你回答 / 正在运行，或卡片还是「想法 / 开发中」：默认顺延" },
  { key: "unmergeable", human: "拼不上", tone: "gray", light: "gray", hint: "分支不存在、仓库未配置集成分支等：合并时没法执行，默认顺延" },
];
const TIER: Record<ReleaseTier, TierDef> = Object.fromEntries(TIERS.map((t) => [t.key, t])) as Record<ReleaseTier, TierDef>;

/* ───────────── 决定（字面值 = 合并单 decision：并入 / 顺延 / 等它 / 不并 / 待定） ───────────── */

const DECISION_OPTS: Array<SegOption<string>> = [
  { value: "并入", label: "并入", tone: "green", title: "本次合入" },
  { value: "待定", label: "待定", tone: "yellow", title: "还没决定：执行时跳过，不并入也不顺延，留在本版（本版先不收尾）" },
  { value: "不并", label: "不并", tone: "gray", title: "不合：执行时把卡片改为未预约" },
  { value: "顺延", label: "顺延", tone: "accent", title: "不合：执行时把卡片挪到下一版，并记「从本版顺延」" },
];
/** 「等它」只在当前决定就是它时出现（多半是终端 heliu release set 改的），免得开关一个都没选中 */
const WAIT_OPT: SegOption<string> = { value: "等它", label: "等它", tone: "purple", title: "本次不合也不顺延：本版先不收尾，等它好了重新预演" };
const DEC_TONE: Record<string, Tone> = { 并入: "green", 待定: "yellow", 不并: "gray", 顺延: "accent", 等它: "purple" };

/** 这一项的决定开关：已在集成分支 → 只读（执行时跳过）；拼不上 → 「并入」禁用并写明原因；其余四个（或五个）都能切 */
function optsFor(x: ReleaseItem, dec: string): Array<SegOption<string>> {
  const base = dec === "等它" ? [...DECISION_OPTS, WAIT_OPT] : DECISION_OPTS;
  if (x.tier === "in_integration") return base.map((o) => ({ ...o, disabled: o.value !== dec, title: "已在集成分支，执行时跳过" }));
  if (x.tier === "unmergeable") {
    return base.map((o) => (o.value === "并入" && dec !== "并入" ? { ...o, disabled: true, title: `拼不上：${x.reason}。先补分支或配置集成分支，才能并入` } : o));
  }
  return base;
}

const itemKey = (x: ReleaseItem): string => `${x.order}|${x.id}|${x.bindings[0]?.repo ?? ""}|${x.bindings[0]?.branch ?? ""}`;
const firstSentence = (s: string): string => {
  const i = s.indexOf("。");
  return i >= 0 ? s.slice(0, i + 1) : s;
};
const onTrack = (x: ReleaseItem, decision: string): boolean => decision === "并入" || x.tier === "in_integration";

/** 方块上的事实芯片：全部取自预演（试合 / 落后 / 分支是否存在） */
function chipsOf(x: ReleaseItem): BlockChip[] {
  const chips: BlockChip[] = [];
  if (x.tier === "in_integration") chips.push({ text: "已在集成分支", tone: "green", title: "绑定分支已被集成分支包含：执行时跳过" });
  const conflicts = x.bindings.reduce((a, b) => a + (b.conflictFiles ?? 0), 0);
  if (conflicts > 0) chips.push({ text: `撞了 ${conflicts} 个文件`, tone: "red", title: "试合（merge-tree，临时对象区）发现的冲突文件数" });
  if (x.tier !== "in_integration") {
    let best: { n: number; of: string } | null = null;
    for (const b of x.bindings) {
      const n = b.behindIntegration ?? b.behindMain ?? 0;
      const of = b.behindIntegration !== null ? "集成分支" : "主线";
      if (n > 0 && (!best || n > best.n)) best = { n, of };
    }
    if (best) chips.push({ text: `落后 ${best.n}`, tone: "yellow", title: `落后${best.of} ${best.n} 个提交` });
  }
  const failed = x.bindings.find((b) => b.precheckState === "failed");
  if (failed) chips.push({ text: "没试出来", tone: "yellow", title: `请求了试合但没得到结果（${failed.precheckError ?? "原因未知"}）：不算无冲突` });
  if (x.bindings.some((b) => !b.exists)) chips.push({ text: "分支不存在", tone: "gray", title: "绑定的分支在本地找不到" });
  if (!x.bindings.length) chips.push({ text: "没绑分支", tone: "gray" });
  return chips;
}

/**
 * 合并单项 → 方块。有对应功能卡时整块用 modelOfCard：颜色、人话、事实、芯片与看板 / 时间线完全一致（同一张卡跨页不变色），
 * 只把仓库 / 分支换成这一项的绑定（多仓的卡一项一块）。找不到卡（看板数据还没到或卡已删）才按合并单档位构造。
 * 合并单档位（能拼上 / 撞了 / 还没做完 …）是另一个维度：用「档位：…」小胶囊单独标，不覆盖方块的颜色与人话。
 */
function modelOfItem(x: ReleaseItem, card: BoardCard | undefined, app: AppState, sel: string): BlockModel {
  const b = x.bindings[0] ?? null;
  if (card) {
    const m = modelOfCard(card, { next: app.next });
    return { ...m, key: itemKey(x), repoLabel: b ? b.repoLabel : m.repoLabel, branch: b ? b.branch : m.branch };
  }
  const t = TIER[x.tier];
  return {
    key: itemKey(x),
    id: x.id,
    title: x.title,
    type: "其他",
    typeGuess: true,
    module: "其他",
    light: t.light,
    human: t.human,
    fact: x.reason || null,
    repoLabel: b ? b.repoLabel : null,
    branch: b ? b.branch : null,
    milestone: sel,
    lastActivityAt: null,
    chips: chipsOf(x),
    variant: "normal",
    needsAction: null,
  };
}

/** 合并单档位标签：和方块的颜色 / 人话分开，title 是合并单原文（M4 状态名 + 依据） */
function TierPill({ x }: { x: ReleaseItem }) {
  return (
    <Pill tone="gray" outline class="as-tier" title={`合并单档位：${x.tierText} · ${x.reason}`}>
      档位：{TIER[x.tier].human}
    </Pill>
  );
}

/* ───────────── 页面 ───────────── */

interface PlanState {
  busy: boolean;
  result: ReleasePlanResult | null;
  error: string | null;
}

export function AssemblyView() {
  const app = useApp();

  /* 版本：候选 = 未发布的里程碑；默认 = 地址里的 #/assembly/<版本>，否则下一版 */
  const cands = app.milestones.filter((m) => m.status !== "已发布");
  const subId = app.sub === "next" ? app.next : app.sub;
  const sel = cands.find((m) => m.id === subId)?.id ?? cands.find((m) => m.id === app.next)?.id ?? cands[0]?.id ?? null;

  const pv = useApi<ReleasePreview>(app.project && sel ? `/api/release/preview?milestone=${encodeURIComponent(sel)}` : null, [app.tick, sel]);
  const d = pv.env && sel && pv.env.data.milestone.id === sel ? pv.env.data : null;

  /* 乐观更新：卡号 → 刚改的决定（合并单按卡号改，同一张卡的每个绑定项一起变）；新的预演到了就以服务端为准 */
  const [over, setOver] = useState<Record<string, string>>({});
  const overRef = useRef(over);
  overRef.current = over;
  const pending = useRef(new Map<string, number>());
  const seq = useRef(0);
  const [busy, setBusy] = useState<Record<string, boolean>>({});
  useEffect(() => {
    setOver((o) => {
      const keep: Record<string, string> = {};
      for (const [k, v] of Object.entries(o)) if (pending.current.has(k)) keep[k] = v;
      return keep;
    });
  }, [pv.env]);

  const [plan, setPlan] = useState<PlanState>({ busy: false, result: null, error: null });
  const [mp, setMp] = useState<PromptState | null>(null);
  const [syncOpen, setSyncOpen] = useState(false);
  const [openFiles, setOpenFiles] = useState<Set<string>>(new Set());
  const [closed, setClosed] = useState<Set<ReleaseTier>>(new Set(["in_integration"]));
  /** 左栏点开的那一行（触屏没有 hover：点一下显示决定开关） */
  const [rowOpen, setRowOpen] = useState<string | null>(null);
  useEffect(() => {
    setPlan({ busy: false, result: null, error: null });
    setMp(null);
    setOver({});
    setOpenFiles(new Set());
  }, [sel]);

  const cardOf = useMemo(() => {
    const m = new Map<string, BoardCard>();
    for (const col of app.features?.columns ?? []) for (const c of col.cards) m.set(c.id, c);
    return m;
  }, [app.features]);

  const items = d?.items ?? [];
  const itemsRef = useRef(items);
  itemsRef.current = items;
  const eff = (x: ReleaseItem): string => over[x.id] ?? x.decision;

  /** 改决定：先本地改，再写合并单；失败回滚。undo = toast 里的「撤销」把决定改回去 */
  const decide = async (x: ReleaseItem, decision: string, opts: { undoable?: boolean } = {}) => {
    if (!sel) return;
    const id = x.id;
    // 用最新一次预演里的这一项比较（撤销时 x 可能已是旧数据）
    const cur = itemsRef.current.find((i) => i.id === id && i.tier !== "in_integration") ?? x;
    const before = overRef.current[id] ?? cur.decision;
    if (before === decision) return;
    const prevOver = overRef.current[id];
    const my = ++seq.current;
    pending.current.set(id, my);
    setOver((o) => ({ ...o, [id]: decision }));
    setBusy((b) => ({ ...b, [id]: true }));
    // 卡片写的是 next 字面量、选的又正是下一版：不带 milestone（服务端按 next 解析到同一版），免得顺手把 next 改成固定版本号
    const card = cardOf.get(id);
    const body: Record<string, string> = { feature: id, decision };
    if (!(card && card.milestone === "next" && sel === app.next)) body.milestone = sel;
    try {
      const r = await api<ReleaseDecisionResult>("/api/release/decision", { body });
      if (pending.current.get(id) === my) pending.current.delete(id);
      app.toast(firstSentence(r.data.message), opts.undoable === false ? {} : { undo: () => void decide(x, before, { undoable: false }) });
      pv.reload();
      app.refresh();
    } catch (e) {
      if (pending.current.get(id) === my) {
        pending.current.delete(id);
        setOver((o) => {
          const n = { ...o };
          if (prevOver === undefined) delete n[id];
          else n[id] = prevOver;
          return n;
        });
      }
      app.toast(`没改成：${(e as Error).message}`, { kind: "err" });
    } finally {
      if (!pending.current.has(id)) setBusy((b) => ({ ...b, [id]: false }));
    }
  };

  /* 整条轨道是落点：拖方块进来 = 决定改成「并入」 */
  const dropRef = useDropTarget(
    d
      ? {
          canDrop: (p: DragPayload) => {
            if (p.kind !== "card") return null;
            const x = (p.data as ReleaseItem | undefined) ?? items.find((i) => i.id === p.id);
            if (!x || !items.some((i) => i.id === x.id)) return { ok: false, hint: `不在 ${sel} 的合并单里` };
            if (x.tier === "unmergeable") return { ok: false, hint: `拼不上：${x.reason || "分支不存在或仓库未配置集成分支"}` };
            if (onTrack(x, eff(x))) return { ok: false, hint: "已经在轨道上" };
            return { ok: true, hint: "放到这里：排进合并单（并入）" };
          },
          onDrop: (p: DragPayload) => {
            const x = (p.data as ReleaseItem | undefined) ?? items.find((i) => i.id === p.id);
            if (x) void decide(x, "并入");
          },
        }
      : null,
  );

  /** M8：复制这一版的合并 Prompt；剪贴板写入必须在点击这一刻交出（Safari） */
  const copyPrompt = () => {
    if (!sel) return;
    const req = api<MergePromptData>("/api/release/prompt", { body: { milestone: sel } });
    const copied = copyWhenReady(req.then((r) => r.data.prompt));
    setMp({ data: null, copied: null, error: null });
    req
      .then(async (r) => {
        setMp({ data: r.data, copied: await copied, error: null });
        pv.reload();
      })
      .catch((e: Error) => setMp({ data: null, copied: false, error: e.message }));
  };
  const makePlan = async () => {
    if (!sel) return;
    setPlan({ busy: true, result: null, error: null });
    try {
      const r = await api<ReleasePlanResult>("/api/release/plan", { method: "POST", body: { milestone: sel } });
      setPlan({ busy: false, result: r.data, error: null });
      pv.reload();
    } catch (e) {
      setPlan({ busy: false, result: null, error: (e as Error).message });
    }
  };
  const toggleFiles = (k: string) =>
    setOpenFiles((s) => {
      const n = new Set(s);
      if (n.has(k)) n.delete(k);
      else n.add(k);
      return n;
    });
  const toggleTier = (t: ReleaseTier) =>
    setClosed((s) => {
      const n = new Set(s);
      if (n.has(t)) n.delete(t);
      else n.add(t);
      return n;
    });

  const head = (tools: boolean) => (
    <PageHead icon="assembly" title="合流装配" desc="把这一版的方块按顺序摆上轨道：每一块能不能拼上、先合谁后合谁。只排单，不合并。">
      {tools && cands.length ? (
        <>
          <label class="as-ms">
            版本
            <select class="small" value={sel ?? ""} onChange={(e) => app.go("assembly", (e.currentTarget as HTMLSelectElement).value)} aria-label="选择要装配的版本">
              {cands.map((m) => (
                <option value={m.id}>
                  {m.id}
                  {m.title && m.title !== m.id ? ` ${m.title}` : ""}
                  {m.id === app.next ? "（下一版）" : ""} · {m.status}
                </option>
              ))}
            </select>
          </label>
          <button class="btn small" onClick={() => setSyncOpen(true)} title="在别处合并了分支？重新对账，把台账状态补上（先列出，你勾选后才写）">
            <Icon name="sync" size={15} />
            刚合并完？同步一下
          </button>
        </>
      ) : null}
    </PageHead>
  );
  const panels = (
    <>
      {mp ? (
        <MergePromptPanel
          st={mp}
          title={sel ?? ""}
          onClose={() => setMp(null)}
          onSync={() => {
            setMp(null);
            setSyncOpen(true);
          }}
        />
      ) : null}
      {syncOpen ? (
        <MergedPanel
          onClose={() => setSyncOpen(false)}
          onChanged={() => {
            pv.reload();
            app.refresh();
          }}
        />
      ) : null}
    </>
  );

  /* ── 前置空态 ── */
  if (!app.project) {
    return (
      <div class="page as-page">
        {head(false)}
        <Empty icon="start" title="还没有选项目" hint="先在「开始」里接入或选择一个项目。">
          <button class="btn primary" onClick={() => app.go("start")}>
            去「开始」
          </button>
        </Empty>
      </div>
    );
  }
  const msLoading = !app.milestones.length && !app.features && !app.featuresError;
  if (msLoading) {
    return (
      <div class="page as-page">
        {head(false)}
        <Skeleton />
      </div>
    );
  }
  if (!sel) {
    return (
      <div class="page as-page">
        {head(false)}
        <Empty
          icon="assembly"
          title={app.milestones.length ? "没有未发布的里程碑" : "还没有里程碑"}
          hint={app.milestones.length ? "已发布的版本不再装配：在看板或「今天」登记一个新点子会自动建 vNext。" : "在看板或「今天」登记一个新点子会自动建 vNext。"}
        >
          <button class="btn primary" onClick={() => app.go("kanban")}>
            去看板
          </button>
        </Empty>
        {panels}
      </div>
    );
  }

  /* ── 派生 ── */
  const q = app.query;
  const hit = (x: ReleaseItem) => matchQuery(q, x.title, x.id, ...x.bindings.map((b) => b.branch));
  const shown = items.filter(hit);
  const track = shown.filter((x) => onTrack(x, eff(x)));
  const trackAll = items.filter((x) => onTrack(x, eff(x)));
  const deferredIds = [...new Set(items.filter((x) => eff(x) === "顺延").map((x) => x.id))];
  const deferredItems = items.filter((x) => eff(x) === "顺延");
  const isSel = (id: string) => app.selected?.kind === "card" && app.selected.card.id === id;
  /* 看板同一列（key = 版本 id）：用来对照「撞了」的两个口径、找没绑分支的卡 */
  const col = app.features?.columns.find((c) => c.key === sel) ?? null;
  const boardConflict = app.features?.precheck && col ? col.cards.filter((c) => c.group === "conflict").length : null;
  const planConflict = d?.counts.conflict ?? 0;
  const basisDiff = boardConflict !== null && boardConflict !== planConflict;
  const basisText = `分堆按合并单档位，和看板按卡片分组口径不同：会话等你回答 / 正在运行、或卡片还是「想法 / 开发中」的，即使试合有冲突也归到「还没做完」；分支不存在、仓库没配集成分支的归到「拼不上」；合并单还按「卡 × 分支」一项一算。`;
  const unbound = col ? col.cards.filter((c) => !c.done && !c.bindings.length) : [];
  const pick = (id: string) => {
    const c = cardOf.get(id);
    if (c) app.select(isSel(id) ? null : { kind: "card", card: c });
  };

  return (
    <div class="page as-page">
      {head(true)}

      <div class="as-notice" role="note">
        <Icon name="alert" size={18} />
        <div>
          <p>
            <b>仅预演，不会执行合并（M4）。</b>试合用 merge-tree 在临时对象区进行，不改任何分支、不碰工作目录。真正合并：在终端运行 <code>heliu 合并 {sel}</code>
            ，看完摘要输入 yes 才开始。
          </p>
          {d?.warnings.map((w) => (
            <p class="as-warn">
              <b>注意：</b>
              {w}
            </p>
          ))}
        </div>
      </div>

      {d ? (
        <p class="as-meta">
          <span>试合于 {hms(d.generatedAt)}</span>
          <span class="sep">·</span>
          <span>用时 {(d.scanMs / 1000).toFixed(1)}s</span>
          <span class="sep">·</span>
          <span>
            与 <span class="mono">heliu 合并 {d.milestone.id} --预演</span> 同一套规则（同一个合并单构建器）
          </span>
          {pv.loading ? (
            <>
              <span class="sep">·</span>
              <span>正在重新试合…</span>
            </>
          ) : null}
        </p>
      ) : null}

      {pv.error ? <p class="err">读取合并预演失败：{pv.error}</p> : null}

      {!d && !pv.error ? (
        <Skeleton />
      ) : d ? (
        <>
          <div class="as-body">
            {/* ── 左栏：这一版的方块，按档分堆 ── */}
            <aside class="as-bins" aria-label="这一版的方块">
              <div class="as-col-head">
                <h2>这一版的方块</h2>
                <span class="count">{shown.length}</span>
              </div>
              <p class="as-col-hint">按住方块拖到右边的轨道 = 并入；鼠标移到一行上（或 Tab 到它、点一下）就能直接改决定。都只写合并单文件。</p>
              {basisDiff ? (
                <p class="as-basis">
                  {basisText}所以这里的「撞了 {planConflict}」{planConflict < (boardConflict ?? 0) ? "比" : "和"}看板的「撞了 {boardConflict}」{planConflict < (boardConflict ?? 0) ? "少" : "不一样"}。
                </p>
              ) : null}
              {!items.length ? (
                <Empty inline icon="info" title={`${d.milestone.id} 还没有待合入的功能。`} hint="预约到这一版、还没合入的功能卡会出现在这里。" />
              ) : !shown.length ? (
                <Empty inline icon="search" title={`没有匹配「${q.trim()}」的方块`} />
              ) : (
                TIERS.map((t) => {
                  const list = shown.filter((x) => x.tier === t.key);
                  if (!list.length) return null;
                  const open = !closed.has(t.key);
                  return (
                    <div class="block-group as-bin">
                      <GroupHead tone={t.tone} title={t.human} n={list.length} open={open} onToggle={() => toggleTier(t.key)} hint={t.hint} />
                      {open ? (
                        <div class="group-body">
                          <p class="hint">{t.hint}</p>
                          {list.map((x) => {
                            const dec = eff(x);
                            const placed = onTrack(x, dec);
                            const skip = x.tier === "in_integration";
                            const k = itemKey(x);
                            const changed = dec !== x.defaultDecision;
                            return (
                              <div class={`as-row${placed ? " placed" : ""}${rowOpen === k ? " open" : ""}${isSel(x.id) ? " sel" : ""}`} key={k}>
                                <Block
                                  m={modelOfItem(x, cardOf.get(x.id), app, sel)}
                                  density="compact"
                                  selected={isSel(x.id)}
                                  onClick={() => {
                                    setRowOpen(rowOpen === k ? null : k);
                                    pick(x.id);
                                  }}
                                  title={`${x.title}\n档位：${x.tierText} · ${x.reason}\n建议：${x.actionText}`}
                                  drag={placed ? undefined : { payload: { kind: "card", id: x.id, label: x.title, data: x } }}
                                />
                                <div class="as-row-sub">
                                  <TierPill x={x} />
                                  <Pill tone={DEC_TONE[dec] ?? "gray"} class="as-dec-pill" title={changed ? `默认是「${x.defaultDecision}」，合并单里已改成「${dec}」` : "默认决定"}>
                                    决定：{dec}
                                    {skip ? "（执行时跳过）" : placed ? " · 在轨道上" : ""}
                                    {changed ? " · 已改" : ""}
                                  </Pill>
                                  <span class="as-row-seg" role="group" aria-label={`${x.id} 的决定`}>
                                    <Seg
                                      small
                                      tone
                                      value={dec}
                                      options={optsFor(x, dec)}
                                      onChange={(v) => {
                                        if (!skip) void decide(x, v);
                                      }}
                                    />
                                  </span>
                                  {busy[x.id] ? <span class="as-busy">写入中…</span> : null}
                                </div>
                                {x.tier === "unmergeable" ? <p class="as-row-why">拼不上：{x.reason}</p> : null}
                              </div>
                            );
                          })}
                        </div>
                      ) : null}
                    </div>
                  );
                })
              )}
              {unbound.length ? (
                <div class="as-unbound">
                  <p>
                    <b>还有 {unbound.length} 张卡没绑分支</b>：合并单里它们只能是「拼不上（没有绑定分支）」，不能并入，默认顺延。要让它们进这一版，先给它绑分支（在时间线或星图里把一条「还没登记」的分支拖到它上面）；要把它们挪走，在看板里改预约。
                  </p>
                  <div class="as-unbound-list">
                    {unbound.slice(0, 5).map((c) => (
                      <Block key={c.id} m={modelOfCard(c, { next: app.next })} density="mini" selected={isSel(c.id)} onClick={() => app.select(isSel(c.id) ? null : { kind: "card", card: c })} title={`${c.id} ${c.title}：点开看详情`} />
                    ))}
                  </div>
                  <div class="as-unbound-foot">
                    {unbound.length > 5 ? <span class="tiny muted">另外 {unbound.length - 5} 张在看板里看</span> : <span />}
                    <button class="btn xs" onClick={() => app.go("kanban")}>
                      去看板改预约
                    </button>
                  </div>
                </div>
              ) : null}
            </aside>

            {/* ── 右栏：合流轨道 ── */}
            <section class="as-main" aria-label="合流轨道">
              <div class="as-col-head">
                <h2>合流轨道</h2>
                <span class="count">{track.length}</span>
                <span class="right">从上到下 = 合并顺序</span>
              </div>
              <p class="as-col-hint">
                顺序：已进集成（执行时跳过）→ 无冲突 → 有冲突（只有 union 文件的在前，再按冲突文件数）→ 未能试合 → 未完成 → 无法合并。右边的开关改决定，同样只写合并单。
              </p>
              <div class="as-track" ref={dropRef}>
                {track.map((x) => {
                  const dec = eff(x);
                  const skip = x.tier === "in_integration";
                  const t = TIER[x.tier];
                  const k = itemKey(x);
                  const files = x.bindings.filter((b) => b.conflicts.length > 0);
                  const nFiles = files.reduce((a, b) => a + b.conflicts.length, 0);
                  return (
                    <div class={`as-slot${skip ? " skip" : ""}`} key={k}>
                      <span class={`as-node tone-${t.tone}`} title={`合并单第 ${x.order} 项`}>
                        {x.order}
                      </span>
                      <Block m={modelOfItem(x, cardOf.get(x.id), app, sel)} density="card" selected={isSel(x.id)} onClick={() => pick(x.id)} />
                      <div class="as-ctl">
                        <TierPill x={x} />
                        <span class="k">决定</span>
                        <Seg
                          small
                          tone
                          value={dec}
                          options={optsFor(x, dec)}
                          onChange={(v) => {
                            if (!skip) void decide(x, v);
                          }}
                        />
                        {skip ? <span class="as-skip-note">跳过：已在集成分支</span> : null}
                        {busy[x.id] ? <span class="as-busy">正在写入合并单…</span> : null}
                        {!skip && dec !== x.defaultDecision ? <span class="as-changed">默认是「{x.defaultDecision}」，已改成「{dec}」</span> : null}
                        <p class="as-advice">
                          <b>建议：</b>
                          {x.actionText}
                        </p>
                        {nFiles ? (
                          <>
                            <button class="btn xs as-files-btn" onClick={() => toggleFiles(k)} aria-expanded={openFiles.has(k)}>
                              撞了的 {nFiles} 个文件 {openFiles.has(k) ? "▴" : "▾"}
                            </button>
                            {openFiles.has(k) ? (
                              <ul class="as-files">
                                {files.flatMap((b) => [
                                  ...(files.length > 1 ? [<li class="repo" key={`${b.repo}|${b.branch}`}>{`${b.repoLabel} · ${b.branch}`}</li>] : []),
                                  ...b.conflicts.map((f) => <li key={`${b.repo}|${b.branch}|${f}`}>{f}</li>),
                                ])}
                              </ul>
                            ) : null}
                          </>
                        ) : null}
                      </div>
                    </div>
                  );
                })}
                {!track.length ? (
                  <div class="as-track-empty">
                    <b>{trackAll.length ? `轨道上没有匹配「${q.trim()}」的方块` : "轨道还是空的"}</b>
                    {trackAll.length ? "清空标题栏的搜索就能看到全部。" : "把左边「能拼上」的方块拖到这里，就排进了合并单。"}
                  </div>
                ) : (
                  <div class="as-drop-line" aria-hidden="true">
                    拖方块到这里 = 并入
                  </div>
                )}
                <div class="as-conf-row">
                  <span class="as-conf" title="合流点：轨道上的方块按顺序合进各仓库的集成分支（在终端执行）">
                    <Icon name="arrow" size={18} />
                  </span>
                  <div class="as-conf-text">
                    <span class="t">合流点</span>
                    {d.repos.length ? (
                      d.repos.map((r) => (
                        <span class={`r${r.integration ? "" : " none"}`} title={r.integration ? `${r.repoLabel} 的集成分支` : "未配置集成分支，或配置的集成分支在本地不存在（见顶部提示）"}>
                          {r.repoLabel} → {r.integration ? <span class="mono">{r.integration}</span> : "未配置集成分支"}
                        </span>
                      ))
                    ) : (
                      <span class="r muted">这一版的合并单还没有涉及任何仓库</span>
                    )}
                  </div>
                </div>
              </div>

              {/* ── 预计顺延 · 合并单文件（事实，折叠） ── */}
              <details class="as-more">
                <summary>
                  预计顺延 <span class="n">{deferredIds.length}</span>
                  <span class="faint">·</span>
                  合并单文件
                  <Icon name="chevron" size={14} class="chev" />
                </summary>
                <div class="as-more-body">
                  <div class="panel tight">
                    <h3>
                      预计顺延 <span class="n">{deferredIds.length}</span>
                    </h3>
                    {deferredItems.length ? (
                      <ul>
                        {deferredItems.map((x) => (
                          <li>
                            {x.id} {x.title}：<span class="muted">{x.reason}</span>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="muted">无</p>
                    )}
                    <p class="muted small">顺延 = 合并时没合完的功能挪到下一版并标「从 {d.milestone.id} 顺延」（由终端 heliu 合并 执行，不会静默丢弃）。</p>
                  </div>
                  <div class="panel tight">
                    <h3>合并单</h3>
                    <p class="small">
                      <span class="mono">{d.plan.file}</span>：
                      {d.plan.exists
                        ? d.plan.format === "board"
                          ? "现在是旧版看板草稿（不能直接执行），生成合并单时会先备份再覆盖。"
                          : `已存在 · ${d.plan.status ?? "草稿"}${d.plan.kept ? ` · 决定里保留了你改过的 ${d.plan.kept} 项` : ""}`
                        : "还没有。"}
                    </p>
                    <p class="small muted">
                      「生成合并单」= 在终端运行 <span class="mono">heliu 合并 {d.milestone.id} --预演</span>：写同一个文件、同一格式（保留你改过的决定），之后可以 <span class="mono">heliu release set</span> 改决定、
                      <span class="mono">heliu 合并 {d.milestone.id}</span> 在终端里逐条确认执行。<b>看板不会执行任何合并。</b>
                    </p>
                  </div>
                </div>
              </details>
            </section>
          </div>

          {/* ── 底部常驻条 ── */}
          <div class="as-dock">
            <div class="as-dock-in">
              <div class="as-dock-row">
                <div class="as-dock-stats">
                  <Stat sm n={trackAll.length} label="块在轨道上" tone="accent" title="决定为「并入」的项，加上已在集成分支（执行时跳过）的项" />
                  <Stat
                    sm
                    n={d.counts.conflict}
                    label="撞了"
                    tone={d.counts.conflict ? "red" : undefined}
                    title={`合并单档位口径：这一版里归到「撞了」的项数（不论决定，按卡 × 分支计）。${basisText}${boardConflict !== null ? `看板按卡片分组是「撞了 ${boardConflict}」。` : ""}`}
                  />
                  <Stat sm n={d.counts.precheck_failed} label="没试出来" tone={d.counts.precheck_failed ? "yellow" : undefined} title="这一版里请求了试合但没得到结果的项数：不算无冲突" />
                  <Stat sm n={deferredIds.length} label="预计顺延" title="决定为「顺延」的卡数" />
                </div>
                <div class="as-dock-acts">
                  <button class="btn" onClick={() => void makePlan()} disabled={plan.busy || !items.length} title="把这次预演写成合并单文件（保留你改过的决定），不执行合并">
                    {plan.busy ? "生成中…" : d.plan.exists && d.plan.format !== "board" ? "刷新合并单" : "生成合并单"}
                  </button>
                  <button class="btn primary" onClick={copyPrompt} title="刷新合并单，并把交给 Claude 会话的合并 Prompt 复制到剪贴板（不执行合并）">
                    <Icon name="copy" size={15} />
                    复制合并 Prompt
                  </button>
                </div>
              </div>
              {plan.result ? (
                <p class="as-dock-res ok">
                  已写入：<span class="mono">{plan.result.file}</span>（{plan.result.items} 项 · 状态 {plan.result.status} · 预计顺延 {plan.result.deferred} 张卡
                  {plan.result.kept ? ` · 保留了你改过的 ${plan.result.kept} 项决定` : ""}）
                  {plan.result.backup ? <span class="muted"> 旧的看板草稿已备份到 {plan.result.backup}</span> : null}
                </p>
              ) : null}
              {plan.error ? <p class="as-dock-res bad">没生成成：{plan.error}</p> : null}
              <p class="as-dock-rule">
                <b>
                  看板只排单，不执行合并：在终端运行 <span class="mono">heliu 合并 {d.milestone.id}</span>，看完摘要输入 yes 才开始。
                </b>
              </p>
            </div>
          </div>
        </>
      ) : null}
      {panels}
    </div>
  );
}

