import { useEffect, useState } from "preact/hooks";
import type { PairingsData } from "../src/board/api-types.ts";
import type { PairGroup, PairSuggestion } from "../src/core/pairing-types.ts";
import { ago, api } from "./lib.ts";

interface ApplyResult {
  bound: Array<{ key: string; card: string; repoLabel: string; branch: string }>;
  created: Array<{ id: string; title: string; milestone: string | null; branches: string[] }>;
  skipped: Array<{ key: string; reason: string }>;
}

const TIER: Record<PairSuggestion["tier"], { text: string; cls: string }> = {
  strong: { text: "强", cls: "t-green" },
  medium: { text: "中", cls: "t-yellow" },
  weak: { text: "弱", cls: "t-gray" },
};

export function PairingPanel({ onClose, onChanged }: { onClose: () => void; onChanged: () => void }) {
  const [data, setData] = useState<PairingsData | null>(null);
  const [error, setError] = useState<string | null>(null);
  const [pick, setPick] = useState<Set<string>>(new Set());
  const [showWeak, setShowWeak] = useState(false);
  const [busy, setBusy] = useState(false);
  const [done, setDone] = useState<ApplyResult | null>(null);

  const load = async (keepPick = false) => {
    try {
      const r = await api<PairingsData>("/api/pairings");
      setData(r.data);
      setError(null);
      if (!keepPick && r.data.report) setPick(new Set(r.data.report.groups.flatMap((g) => g.items).filter((i) => i.checked).map((i) => i.key)));
    } catch (e) {
      setError((e as Error).message);
    }
  };
  useEffect(() => {
    void load();
  }, []);
  // 后台分析中：每秒看一次进度，跑完重新读建议
  const running = !!data?.job?.running;
  useEffect(() => {
    if (!running) return;
    const t = setInterval(() => void load(), 1000);
    return () => clearInterval(t);
  }, [running]);

  const analyze = async (force: boolean) => {
    try {
      await api("/api/pairings/analyze", { body: { force } });
      await load();
    } catch (e) {
      setError((e as Error).message);
    }
  };
  const write = async () => {
    setBusy(true);
    try {
      const r = await api<ApplyResult>("/api/pairings", { body: { keys: [...pick] } });
      setDone(r.data);
      onChanged();
      await load();
    } catch (e) {
      setError((e as Error).message);
    } finally {
      setBusy(false);
    }
  };
  const toggle = (k: string) =>
    setPick((s) => {
      const n = new Set(s);
      if (n.has(k)) n.delete(k);
      else n.add(k);
      return n;
    });

  const rep = data?.report ?? null;
  const job = data?.job ?? null;
  const groups = rep?.groups ?? [];
  const weakCount = groups.flatMap((g) => g.items).filter((i) => i.tier === "weak" && i.target.kind !== "other").length;
  const visible = (g: PairGroup) => g.items.filter((i) => showWeak || i.tier !== "weak" || i.target.kind === "other");

  return (
    <aside class="detail decision merged pairing" aria-label="跨仓配对">
      <button class="menu-btn" onClick={onClose} aria-label="关闭">
        ×
      </button>
      <h3>跨仓配对</h3>
      <p class="small">会话开在一个仓库（多是文档仓），真正的代码改在别的仓库的 worktree 里。这里按本机对话记录，建议把那条分支也绑到会话的卡上——这样等你回答、合并、落后都在同一张卡上。</p>
      {error ? <p class="err small">{error}</p> : null}
      {!data ? <p class="small muted">正在读取…</p> : null}

      {running ? (
        <p class="copied muted">
          正在分析对话记录：{job!.done} / {job!.total || "?"} 份（只读，只提取路径与次数）…
        </p>
      ) : job?.error ? (
        <p class="err small">分析没完成：{job.error}</p>
      ) : null}

      {data && !data.analyzedAt && !running ? (
        <>
          <p class="small">还没分析过。先分析一次（首次约几秒到一分钟，之后只看有变化的文件）：</p>
          <p>
            <button class="btn primary small" onClick={() => void analyze(false)}>
              分析对话记录
            </button>
          </p>
        </>
      ) : null}

      {done ? (
        <div class="pair-done">
          <p class="copied ok">✓ 已写进台账：绑定 {done.bound.length} 条{done.created.length ? `，新建 ${done.created.length} 张卡` : ""}（没有碰任何仓库）</p>
          <ul class="small">
            {done.created.map((c) => (
              <li>
                新建 <b>{c.id}</b> {c.title}：{c.branches.join("、")}
              </li>
            ))}
            {done.bound
              .filter((b) => !done.created.some((c) => c.id === b.card))
              .map((b) => (
                <li>
                  <b>{b.card}</b> 绑定 {b.repoLabel} {b.branch}
                </li>
              ))}
            {done.skipped.map((s) => (
              <li class="muted">跳过：{s.reason}</li>
            ))}
          </ul>
        </div>
      ) : null}

      {rep && data?.analyzedAt ? (
        <>
          <p class="small">
            上次分析 {ago(data.analyzedAt)} ·{" "}
            <button class="link" disabled={running} onClick={() => void analyze(false)}>
              重新分析
            </button>
            <br />
            建议：强 {rep.counts.strong} · 中 {rep.counts.medium}
            {rep.counts.other ? ` · 已绑在别的卡 ${rep.counts.other}（只提示）` : ""}
            {rep.counts.paired ? ` · 已配好 ${rep.counts.paired}` : ""}
            {weakCount ? (
              <>
                {" · "}
                <button class="link" onClick={() => setShowWeak((v) => !v)}>
                  {showWeak ? "收起弱证据" : `更多弱证据（${weakCount}）`}
                </button>
              </>
            ) : null}
          </p>
          {!groups.some((g) => visible(g).length) ? <p class="small">没有要配对的：会话没有在别的仓库的 worktree 里改过东西，或者都已经配好了。</p> : null}
          <div class="pair-groups">
            {groups.map((g) => {
              const items = visible(g);
              if (!items.length) return null;
              return (
                <section class="pair-group">
                  <p class="pg-head">
                    <b>{g.title}</b>
                    {g.status === "blocked" ? <span class="tag t-purple">等你回答</span> : g.status === "running" ? <span class="tag">运行中</span> : null}
                    <span class="muted small">
                      {" "}
                      会话在 {g.repoLabel}
                      {g.branch ? ` ${g.branch}` : ""} → {g.card ? `${g.card.id}「${g.card.title}」` : "还没有卡：确认时用会话标题建卡（预约下一版）"}
                    </span>
                  </p>
                  <ul class="sync-list">
                    {items.map((i) => (
                      <li>
                        <label class="chk">
                          <input type="checkbox" disabled={i.target.kind === "other"} checked={pick.has(i.key)} onChange={() => toggle(i.key)} />
                          <span>
                            <span class={`tag ${i.target.kind === "other" ? "t-gray" : TIER[i.tier].cls}`}>{i.target.kind === "other" ? "已有卡" : TIER[i.tier].text}</span> <b>{i.repoLabel}</b> <code>{i.branch}</code>
                            <span class="sync-br">依据：{i.evidence}</span>
                            {i.target.kind === "other" ? <span class="sync-br">这条分支已经绑在 {i.target.id}「{i.target.title}」上：如果是同一件事，请手动处理（不会自动合卡）</span> : null}
                          </span>
                        </label>
                      </li>
                    ))}
                  </ul>
                </section>
              );
            })}
          </div>
          {rep.notes.length ? (
            <div class="small">
              <p class="muted">另外（不是建议，只是事实）：</p>
              <ul>
                {rep.notes.map((n) => (
                  <li>
                    会话「{n.title}」{n.text}
                  </li>
                ))}
              </ul>
            </div>
          ) : null}
          <div class="row-actions sticky">
            <button class="btn primary small" disabled={busy || !pick.size} onClick={() => void write()}>
              {busy ? "写入中…" : `绑定所选（${pick.size} 条）`}
            </button>
            <button class="btn small" onClick={onClose}>
              先不改
            </button>
          </div>
        </>
      ) : null}
      <p class="explain">
        依据是建议不是事实：worktree 现在检出的分支可能后来换过；仓库主目录常切换分支，只算弱证据。{(data?.privacy ?? []).join("")}
      </p>
    </aside>
  );
}
/**
 * 星图布局（M7，纯函数，不碰 DOM，便于测试）。
 *
 * 纵横：横轴 = 分支最后提交时间（平方根刻度，越右越新），纵轴 = 仓库泳道。
 * 每个泳道底部两条"星河主流"：主线、集成分支；功能分支是星点，排在主流上方，按时间横向铺开、碰撞时往上叠一层。
 * 右侧一列是版本行星（里程碑 + 未预约 + 已发布）；功能卡与它预约的版本之间画星座线。
 * 数据全部来自 /api/status（ReconcileReport）与 /api/features（FeaturesData），不额外请求。
 *
 * M8 收纳：每条泳道按类型（修复 / 功能 / 调研 / 文档 / 工程 / 其他）分成几行；收起的行是一个"星团"
 * （成员在时间轴上的小点 + 状态分布 + 数量 + 最新时间），展开的行才画出每颗星点。颜色 = 状态，形状 = 类型。
 *
 * M9 会话入口：没有自己提交的分支（FeatureView.sessionEntry，服务端判定）不进类型行，收进每条泳道最下面的
 * 「会话入口」行（空心小点、默认收起）；「已配对」= 它的卡在别的仓库还绑着有真实改动的分支。
 */
import type { BoardCard, FeaturesData, Light } from "../src/board/api-types.ts";
import { FEATURE_TYPES, TYPE_GLYPH, classifyText, inferType, isFeatureType, type FeatureType } from "../src/core/classify.ts";
import type { FeatureView, ReconcileReport, RepoReport } from "../src/types.ts";

export type StarColor = Light | "blue";

export interface GalaxyOptions {
  width: number;
  now: number;
  /** 显示已进主线的分支（缺省隐藏：它们已经完成） */
  showMerged: boolean;
  /** 折叠的仓库 id */
  collapsed: Set<string>;
  /** M8：展开的类型行（`仓库|类型`）；不在里面的行收成星团 */
  expanded: Set<string>;
  /** M8：全部展开 */
  expandAll?: boolean;
}

export interface GBranch {
  key: string;
  kind: "branch";
  repo: string;
  repoLabel: string;
  branch: string;
  label: string;
  x: number;
  y: number;
  r: number;
  color: StarColor;
  merged: FeatureView["mergedState"];
  lastAt: string | null;
  ahead: number;
  behind: number | null;
  /** 绑定的功能卡（没有 = 流浪星，可拖到版本行星建卡） */
  card: BoardCard | null;
  waiting: string | null;
  conflicts: number | null;
  /** 最新的前几名：1 = 最新 */
  recent: number | null;
  sessionTitle: string | null;
  worktree: string | null;
  /** 常显标签放在星点哪一侧；null = 不常显（悬停 / 选中 / 搜索命中时才显示） */
  labelSide: "r" | "l" | "t" | "b" | null;
  labelText: string;
  /** M8：类型（卡片上写的 > 推测）与所在类型行 */
  type: FeatureType;
  row: string;
  /** M9：会话入口（没有自己的提交） */
  entry: boolean;
  /** M9：worktree 完整路径（知道去哪回答 / 改代码） */
  worktreePath: string | null;
  /** M9：同一张卡上的其他绑定（如「文档仓 claude/xxx · 会话入口」） */
  mates: string[];
  /** M9：没卡的分支，它的会话在等你（有卡时看卡的灯） */
  sessionBlocked: boolean;
}

export interface GCard {
  key: string;
  kind: "card";
  card: BoardCard;
  x: number;
  y: number;
  r: number;
  color: StarColor;
  planet: string;
  type: FeatureType;
}

export type GNode = GBranch | GCard;

/** M8：泳道里的一行（一个类型） */
export interface GRow {
  key: string;
  repo: string;
  type: FeatureType;
  glyph: string;
  /** 行的上下边界与中线 */
  y0: number;
  y1: number;
  y: number;
  expanded: boolean;
  count: number;
  /** 本行全部分支 key（收起时也在） */
  members: string[];
  /** 状态分布（收起时的分布条、展开时的行头都用） */
  colors: Partial<Record<StarColor, number>>;
  waiting: number;
  conflict: number;
  newestAt: string | null;
  /** 含全项目最新的那条分支 */
  hasNewest: boolean;
  /** M9：会话入口行（不是类型行：不接"改类型"拖放） */
  entry: boolean;
  /** M9：会话入口行里已配对的数量 */
  paired: number;
  /** 收起时的星团：成员在时间轴上的范围与小点；展开时为 null */
  cluster: {
    x0: number;
    x1: number;
    dots: Array<{ x: number; dy: number; color: StarColor }>;
    color: StarColor;
    labelText: string;
    /** r = 星团右边；b = 星团下方（右边被行星 / 合流点挡住时） */
    labelSide: "r" | "b" | null;
    labelX: number;
    labelY: number;
  } | null;
}

export interface GLane {
  repo: string;
  label: string;
  y0: number;
  y1: number;
  mainY: number;
  integY: number | null;
  main: string;
  integration: string | null;
  integAhead: number | null;
  integDays: number | null;
  collapsed: boolean;
  /** 本泳道显示 / 总共的功能分支数 */
  shown: number;
  total: number;
  hiddenMerged: number;
  /** M9：显示中的分支里，有真实改动的 / 会话入口 */
  work: number;
  entries: number;
  error: string | null;
}

export interface GPlanet {
  key: string;
  title: string;
  kind: "milestone" | "unreserved" | "released";
  x: number;
  y: number;
  r: number;
  isNext: boolean;
  droppable: boolean;
  owed: number;
  waiting: number;
  conflict: number | null;
}

export interface GConfluence {
  key: string;
  repo: string;
  label: string;
  branch: string;
  x: number;
  y: number;
}

export interface GFlow {
  key: string;
  node: string;
  d: string;
  cls: "in" | "out" | "conflict" | "behind" | "waiting";
  /** M8：从收起的星团出发（画得更淡，免得斜穿其他行） */
  cluster?: boolean;
}

export interface GLink {
/**
 * 结构页模型（M8，纯函数，便于测试）：把功能卡与"还没建卡的分支"按「模块 × 类型」汇总，挑出现在该决定的。
 * - 卡片的类型 / 模块来自 /api/features（卡片上写的 > 服务端推测）；没卡的分支用同一套规则在这里推测。
 * - 状态口径与版本列一致：等你 / 冲突 / 已合入待确认 / 可合并 / 落后 / 开发中 / 想法 / 已完成；没卡的分支 = 还没建卡。
 * 结构页只是汇总 + 下钻，不另起一套状态。
 */
import type { BoardCard, FeaturesData } from "../src/board/api-types.ts";
import { FEATURE_TYPES, OTHER_MODULE, inferModule, inferType, isFeatureType, type FeatureType, type ModuleDef } from "../src/core/classify.ts";
import type { ReconcileReport } from "../src/types.ts";
import { branchText } from "./galaxy-model.ts";

export type SState = "waiting" | "conflict" | "merged" | "mergeable" | "behind" | "stray" | "dev" | "idea" | "done";

/** 状态定义：顺序即"该决定"的优先级 */
export const STATES: Array<{ key: SState; title: string; tone: "purple" | "red" | "green" | "yellow" | "blue" | "gray"; hint: string; decide: boolean }> = [
  { key: "waiting", title: "等你回答", tone: "purple", hint: "绑定的会话停下来等你拍板", decide: true },
  { key: "conflict", title: "有冲突", tone: "red", hint: "试合有冲突文件，合并前要解", decide: true },
  { key: "merged", title: "已合入待确认", tone: "green", hint: "分支已被集成分支 / 主线包含，台账还是旧状态：点「同步一下」", decide: true },
  { key: "mergeable", title: "可合并", tone: "green", hint: "已进集成分支或试合无冲突，可以排进合并单", decide: true },
  { key: "behind", title: "落后需同步", tone: "yellow", hint: "有还没合并的分支落后基线（与星图「落后需同步」同口径）；合并前先评估是否同步", decide: true },
  { key: "stray", title: "还没建卡", tone: "blue", hint: "有分支（还没进主线）没有功能卡，不知道它要进哪一版", decide: true },
  { key: "dev", title: "开发中", tone: "gray", hint: "正在推进（含停滞）", decide: false },
  { key: "idea", title: "想法", tone: "gray", hint: "还没关联开发分支", decide: false },
  { key: "done", title: "已合入", tone: "gray", hint: "台账状态已是 已合入 / 已进主线 / 已发布（不等于已验收）", decide: false },
];
const ORDER = new Map(STATES.map((s, i) => [s.key, i]));
export const stateMeta = (k: SState) => STATES[ORDER.get(k)!]!;

export interface SItem {
  /** 星图里的 key（b:仓库:分支 / k:卡号），用于"星图里看" */
  key: string;
  cardId: string | null;
  title: string;
  type: FeatureType;
  typeSource: "card" | "guess";
  module: string;
  moduleSource: "card" | "guess";
  state: SState;
  nextStep: string;
  /** 预约的版本（列标题）；没卡的分支为 null */
  milestone: string | null;
  lastAt: string | null;
  repos: string[];
  /** 没卡的分支：改类型 / 模块时据此建卡 */
  bind: { repo: string; branch: string } | null;
  /** 主状态不是「已合入待确认」（例如还在等你），但分支其实已经合进去了：也列进「已合入待确认」，与「同步一下」一致 */
  alsoMerged: boolean;
  /** 还没合并的分支里最多落后基线几个提交（0 = 不落后）；主状态不是「落后」时也列进「落后需同步」 */
  behind: number;
  /** M9：没卡的分支，会话在等你：主状态是「还没建卡」时也列进「等你回答」（与星图同口径） */
  waitingSession?: boolean;
}

export interface SModule {
  name: string;
  items: SItem[];
  open: number;
  done: number;
  byType: Partial<Record<FeatureType, number>>;
  byState: Partial<Record<SState, number>>;
  /** 最需要决定的前三项 */
  top: SItem[];
}

export interface StructureModel {
  modules: SModule[];
  /** 出现过的类型（矩阵的列） */
  types: FeatureType[];
  /** 模块 → 类型 → 数量 / 其中"等你或有冲突"（矩阵上的小红点只标最急的） */
  matrix: Record<string, Partial<Record<FeatureType, { n: number; hot: number }>>>;
  /** 每种"该决定"状态下的全部条目（跨模块） */
  decisions: Partial<Record<SState, SItem[]>>;
  total: number;
  /** M9：各仓库的会话入口分支（没有自己的提交，不计入上面任何一类） */
  entries: Array<{ repo: string; repoLabel: string; count: number; paired: number; branches: number }>;
  /** M9：会话几乎都从一个仓库开时，建议给它起个如实的名字 */
  renameHint: { repo: string; label: string; suggested: string; entries: number; branches: number; sessions: number; allSessions: number } | null;
}

/** 至少这么多个会话、其中这个比例以上都开在同一个仓库，且它有会话入口时，建议改名（例：文档仓 → 总仓（会话入口 + 文档）） */
export const RENAME_MIN_SESSIONS = 10;
export const RENAME_MIN_SHARE = 0.8;

function cardState(c: BoardCard): SState {
  if (c.done) return "done";
  if (c.variant === "merged-pending") return "merged";
  switch (c.group) {
    case "blocked":
      return "waiting";
    case "conflict":
      return "conflict";
    case "mergeable":
      return "mergeable";
    case "behind":
      return "behind";
    case "unbound":
      return "idea";
    default:
      return "dev";
  }
}

const byUrgency = (a: SItem, b: SItem) => ORDER.get(a.state)! - ORDER.get(b.state)! || Date.parse(b.lastAt ?? "1970") - Date.parse(a.lastAt ?? "1970");

export function buildStructure(report: ReconcileReport, features: FeaturesData): StructureModel {
  const defs: ModuleDef[] = features.modules.length ? features.modules : [];
  const items: SItem[] = [];
  const bound = new Set<string>();
  const titleOf = new Map(features.columns.map((c) => [c.key, c.title]));
  for (const col of features.columns)
    for (const c of col.cards) {
      for (const b of c.bindings) if (b.exists) bound.add(`${b.repo}|${b.branch}`);
      // 「星图里看」优先跳到有真实改动的那条（会话入口只是入口）
      const live = c.bindings.find((b) => b.exists && b.sessionEntry !== true) ?? c.bindings.find((b) => b.exists);
      items.push({
        key: live ? `b:${live.repo}:${live.branch}` : `k:${c.id}`,
        cardId: c.id,
        title: c.title,
        type: isFeatureType(c.type) ? c.type : "其他",
        typeSource: c.typeSource,
        module: c.module || OTHER_MODULE,
        moduleSource: c.moduleSource,
        state: cardState(c),
        nextStep: c.nextStep,
        milestone: c.column === "__unreserved" ? null : (titleOf.get(c.column) ?? c.column),
        lastAt: c.lastActivityAt,
        repos: [...new Set(c.bindings.map((b) => b.repoLabel))],
        bind: null,
        alsoMerged: false,
        behind: Math.max(0, ...c.bindings.filter((b) => b.exists && b.mergedState === "unmerged").map((b) => b.vsIntegration?.behind ?? b.vsMain?.behind ?? 0)),
      });
      const it = items[items.length - 1]!;
      if (c.mergedTo && it.state !== "done" && it.state !== "merged") it.alsoMerged = true;
    }
  // 还没建卡、也还没进主线的分支（与星图"还没建卡"同一口径）
  for (const r of report.repos) {
    if (!r.reachable) continue;
    for (const b of r.branches) {
      if (b.role !== "feature" || bound.has(`${r.id}|${b.branch}`)) continue;
      const text = branchText(b);
      // M9：会话入口（没有自己的提交）不算「还没建卡」；但它的会话在等你时照样列进「等你回答」（与星图同口径）
      if (b.sessionEntry === true) {
        const s = b.sessions[0];
        if (s?.status !== "blocked") continue;
        items.push({
          key: `b:${r.id}:${b.branch}`,
          cardId: null,
          title: s.title ?? b.label,
          type: inferType(text),
          typeSource: "guess",
          module: inferModule(text, defs.length ? defs : undefined),
          moduleSource: "guess",
          state: "waiting",
          nextStep: `会话在等你回答${s.needsAction ? `：${s.needsAction}` : ""}（这是会话入口，真实改动可能在别的仓库）`,
          milestone: null,
          lastAt: s.lastActivityAt ?? b.lastCommitAt,
          repos: [r.label],
          bind: { repo: r.id, branch: b.branch },
          alsoMerged: false,
          behind: 0,
        });
        continue;
      }
      if (b.mergedState === "in_main") continue;
      items.push({
        key: `b:${r.id}:${b.branch}`,
        cardId: null,
        title: b.label,
        type: inferType(text),
        typeSource: "guess",
        module: inferModule(text, defs.length ? defs : undefined),
        moduleSource: "guess",
        state: "stray",
        nextStep: b.mergedState === "in_integration" ? "已进集成分支，但没有功能卡：要记进某一版，就在星图里拖到版本行星" : "还没有功能卡：在星图里拖到版本行星即可建卡并预约",
        milestone: null,
        lastAt: b.lastCommitAt,
        repos: [r.label],
        bind: { repo: r.id, branch: b.branch },
        alsoMerged: false,
