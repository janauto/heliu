/* ───────────── 设计令牌 ───────────── */
:root {
  --font-sans: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans CJK SC", system-ui, sans-serif;
  --font-display: "Avenir Next", "Avenir", "PingFang SC", -apple-system, sans-serif;
  --font-mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;

  --s1: 4px; --s2: 8px; --s3: 12px; --s4: 16px; --s5: 24px; --s6: 32px; --s7: 48px; --s8: 64px;
  --r-sm: 10px; --r-md: 14px; --r-lg: 20px; --r-xl: 28px;
  --gutter: 40px;

  --bg: #f3f4fa;
  --mesh:
    radial-gradient(60vw 45vw at 0% 0%, rgba(24, 182, 232, 0.14), transparent 60%),
    radial-gradient(55vw 40vw at 100% 0%, rgba(109, 91, 246, 0.14), transparent 60%),
    radial-gradient(60vw 45vw at 50% 110%, rgba(229, 95, 194, 0.10), transparent 60%);
  --surface: rgba(255, 255, 255, 0.74);
  --surface-solid: #ffffff;
  --surface-2: rgba(20, 22, 60, 0.04);
  --fg: #14162b;
  --fg-2: #3a3e5c;
  --muted: #6c7192;
  --faint: #9aa0bd;
  --line: rgba(20, 22, 60, 0.08);
  --line-strong: rgba(20, 22, 60, 0.15);
  --accent: #5b55f0;
  --accent-soft: rgba(91, 85, 240, 0.12);
  --brand: linear-gradient(120deg, #19b4e6 0%, #6a5af6 55%, #e35dc0 100%);
  --green: #11a065;  --green-bg: rgba(17, 160, 101, 0.10);
  --yellow: #b87500; --yellow-bg: rgba(214, 150, 20, 0.13);
  --red: #dc3c48;    --red-bg: rgba(220, 60, 72, 0.10);
  --purple: #7b4bd8; --purple-bg: rgba(123, 75, 216, 0.11);
  --gray: #8a8fa8;   --gray-bg: rgba(20, 22, 60, 0.05);
  --shadow-sm: 0 1px 2px rgba(20, 22, 60, 0.06);
  --shadow-md: 0 1px 2px rgba(20, 22, 60, 0.05), 0 12px 32px -16px rgba(30, 32, 90, 0.22);
  --shadow-lg: 0 24px 60px -20px rgba(30, 32, 90, 0.35);
  --glow: 0 8px 24px -8px rgba(106, 90, 246, 0.55);
  --ring: 0 0 0 3px rgba(91, 85, 240, 0.22);
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #070918;
    --mesh:
      radial-gradient(60vw 45vw at 0% 0%, rgba(24, 182, 232, 0.13), transparent 60%),
      radial-gradient(55vw 45vw at 100% 0%, rgba(120, 95, 255, 0.20), transparent 62%),
      radial-gradient(60vw 45vw at 50% 110%, rgba(229, 95, 194, 0.10), transparent 60%);
    --surface: rgba(22, 26, 56, 0.62);
    --surface-solid: #141834;
    --surface-2: rgba(255, 255, 255, 0.045);
    --fg: #eceefe;
    --fg-2: #c6cae8;
    --muted: #9096bd;
    --faint: #646a92;
    --line: rgba(255, 255, 255, 0.08);
    --line-strong: rgba(255, 255, 255, 0.15);
    --accent: #9a90ff;
    --accent-soft: rgba(154, 144, 255, 0.16);
    --green: #4cd68f;  --green-bg: rgba(76, 214, 143, 0.12);
    --yellow: #f2b84b; --yellow-bg: rgba(242, 184, 75, 0.13);
    --red: #ff6b78;    --red-bg: rgba(255, 107, 120, 0.12);
    --purple: #b795ff; --purple-bg: rgba(183, 149, 255, 0.13);
    --gray: #9096b5;   --gray-bg: rgba(255, 255, 255, 0.05);
    --shadow-sm: none;
    --shadow-md: 0 0 0 1px rgba(255, 255, 255, 0.02), 0 16px 40px -20px rgba(0, 0, 0, 0.7);
    --shadow-lg: 0 30px 70px -24px rgba(0, 0, 0, 0.8);
    --glow: 0 10px 30px -10px rgba(140, 120, 255, 0.7);
    --ring: 0 0 0 3px rgba(154, 144, 255, 0.28);
    color-scheme: dark;
  }
}

/* ───────────── 基础 ───────────── */
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0; min-height: 100vh; color: var(--fg); font-family: var(--font-sans); font-size: 15px; line-height: 1.7;
  background: var(--mesh), var(--bg); background-attachment: fixed;
  -webkit-font-smoothing: antialiased;
}
button, input, select { font: inherit; color: inherit; }
code, pre, .mono { font-family: var(--font-mono); font-size: 0.86em; }
code { background: var(--surface-2); border-radius: 6px; padding: 1px 6px; }
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }
.boot { padding: var(--s7) var(--gutter); color: var(--muted); }
h1, h2, h3 { font-family: var(--font-display); letter-spacing: -0.01em; }
h2 { font-size: 21px; font-weight: 650; margin: var(--s7) 0 var(--s4); }
main > div > h2:first-child, .start > .step:first-child h2 { margin-top: 0; }

