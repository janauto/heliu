 succeeded in 0ms:
/**
 * M4 CLI：heliu release preview|run|rehearse|rollback|set，以及中文别名
 *   heliu 合并 <版本> --预演   = release preview
 *   heliu 合并 <版本>          = release run（可加 --dry-run / --yes / --to-main）
 *   heliu 演练 <版本>          = release rehearse
 *   heliu 回滚 <版本>          = release rollback
 * 执行类命令无 --yes 时逐条确认（需要终端）；输出边执行边写（同步写 stdout），--json 时进度写 stderr、结果写 stdout。
 * 只在 src/cli/index.ts 里 import 并调用 registerReleaseCommands(program)。
 */
import type { Command } from "commander";
import { writeSync } from "node:fs";
import { heliuPaths } from "../core/paths.ts";
import { resolveProject, type ProjectConfig } from "../core/project.ts";
import { previewRelease, setPlanDecision } from "../core/release.ts";
import { rollbackRelease, runRelease, type AskFn } from "../core/release-run.ts";
import { rehearseRelease } from "../core/rehearse.ts";
import { SCHEMA_VERSION } from "../types.ts";
import { renderPreview, renderRehearsal, renderRollback, renderRunReport, renderSetDecision } from "./render-release.ts";

interface G {
  project?: string;
  cwd?: string;
  json?: boolean;
  timeout?: string;
}

function writeAll(fd: number, text: string): void {
  const buf = Buffer.from(text.endsWith("\n") ? text : `${text}\n`, "utf8");
  let off = 0;
  while (off < buf.length) {
    try {
      off += writeSync(fd, buf, off, buf.length - off);
    } catch (e) {
      if ((e as NodeJS.ErrnoException).code === "EAGAIN") {
        Bun.sleepSync(2);
        continue;
      }
      return;
    }
  }
}

function project(g: G): Promise<ProjectConfig> {
  return resolveProject(heliuPaths(), g.project, g.cwd ?? process.cwd());
}

function emitJson(command: string, p: ProjectConfig, data: unknown): void {
  writeAll(1, JSON.stringify({ schemaVersion: SCHEMA_VERSION, command, generatedAt: new Date().toISOString(), project: { name: p.name, source: p.source }, data }, null, 2));
}

/** 终端里逐条确认；非终端返回 undefined（执行类命令会要求 --yes） */
function terminalAsk(): AskFn | undefined {
  if (!process.stdin.isTTY) return undefined;
  const ask = (globalThis as { prompt?: (m?: string) => string | null }).prompt;
  if (!ask) return undefined;
  return async (q, choices, def) => {
    const keys = choices.map((c) => `[${c.key}] ${c.label}`).join(" / ");
    for (;;) {
      const a = ask(`${q}\n  ${keys}（回车 = ${def}）`);
      const k = (a ?? "").trim().toLowerCase() || def;
      if (choices.some((c) => c.key === k)) return k;
      writeAll(2, `  请输入 ${choices.map((c) => c.key).join(" / ")}`);
    }
  };
}

const progress = (g: G) => (line: string) => writeAll(g.json ? 2 : 1, line);
const budgetOf = (v?: string) => (v !== undefined && Number.isFinite(Number(v)) && Number(v) >= 0 ? Number(v) : undefined);

async function previewAction(ms: string, g: G): Promise<void> {
  const p = await project(g);
  const r = await previewRelease(p, heliuPaths(), ms, { timeoutMs: g.timeout ? Number(g.timeout) : undefined });
  if (g.json) emitJson("release.preview", p, { file: r.file, kept: r.kept, plan: r.plan });
  else writeAll(1, renderPreview(r, p));
}

interface RunOpts {
  dryRun?: boolean;
  yes?: boolean;
  toMain?: boolean;
  allowCheckedOut?: boolean;
  budget?: string;
}
async function runAction(ms: string, o: RunOpts, g: G): Promise<void> {
  const p = await project(g);
  const r = await runRelease(p, ms, {
    dryRun: !!o.dryRun,
    yes: !!o.yes,
    toMain: !!o.toMain,
    allowCheckedOut: !!o.allowCheckedOut,
    ask: terminalAsk(),
    log: progress(g),
    resolverBudgetUsd: budgetOf(o.budget),
  });
  if (g.json) emitJson("release.run", p, r);
  else writeAll(1, renderRunReport(r, p));
  if (r.aborted.length || r.failed.length) process.exitCode = 1;
}

async function rehearseAction(ms: string, o: { report?: string; budget?: string }, g: G): Promise<void> {
  const p = await project(g);
  const r = await rehearseRelease(p, heliuPaths(), ms, { log: progress(g), reportFile: o.report, resolverBudgetUsd: budgetOf(o.budget) });
  if (g.json) emitJson("release.rehearse", p, r);
  else writeAll(1, renderRehearsal(r));
  if (!r.zeroWrite || r.run.aborted.length) process.exitCode = 1;
}

async function rollbackAction(ms: string, o: { yes?: boolean; allowCheckedOut?: boolean }, g: G): Promise<void> {
  const p = await project(g);
  const r = await rollbackRelease(p, ms, { yes: !!o.yes, ask: terminalAsk(), log: progress(g), allowCheckedOut: !!o.allowCheckedOut });
  if (g.json) emitJson("release.rollback", p, r);
  else writeAll(1, renderRollback(r, p));
  if (!r.complete) process.exitCode = 1;
}

const globals = (cmd: Command): G => cmd.optsWithGlobals() as G;

function runOptions(c: Command): Command {
  return c
    .option("--dry-run", "只演示每一项会怎么处理，不移动任何引用")
    .option("--yes", "不逐条确认，按合并单执行")
    .option("--to-main", "发布后若主线能快进到集成分支，就快进主线（否则列出来问你）")
    .option("--allow-checked-out", "集成分支/主线在某个 worktree 里检出时仍继续（那个目录需你自己同步）")
    .option("--budget <美元>", "本次解冲突器总预算（默认 10；每次调用另有 --max-budget-usd 2）");
}

export function registerReleaseCommands(program: Command): void {
  const rel = program.command("release").description("按里程碑合并：preview 合并单 → run 执行 → rollback 回滚；rehearse 在克隆上演练（唯一会写被管理仓库的命令组）");
  rel
    .command("preview <版本>")
    .description("生成/刷新合并单草稿（只读仓库：试合在临时对象区）；保留你改过的决定")
    .action(async (ms: string, _o, cmd: Command) => previewAction(ms, globals(cmd)));
  runOptions(rel.command("run <版本>").description("按合并单合入集成分支 → tag → 顺延 → 发布说明；绝不 push")).action(async (ms: string, o: RunOpts, cmd: Command) =>
    runAction(ms, o, globals(cmd)),
  );
  rel
    .command("rehearse <版本>")
    .description("把主仓库 clone --mirror --shared 到 ~/.cache/heliu/rehearsal/，在克隆上完整跑 preview + run --yes，并对真仓库做零写入比对")
    .option("--report <文件>", "演练报告另存一份到这个文件")
    .option("--budget <美元>", "解冲突器总预算（默认 10）")
    .action(async (ms: string, o: { report?: string; budget?: string }, cmd: Command) => rehearseAction(ms, o, globals(cmd)));
  rel
    .command("rollback <版本>")
    .description("按合并单 refs_moved 逆序把引用指回旧值（只回退 heliu 自己移动过的），删 heliu 打的 tag，恢复功能卡")
    .option("--yes", "不再确认")
    .option("--allow-checked-out", "引用在某个 worktree 里检出时仍继续")
    .action(async (ms: string, o: { yes?: boolean; allowCheckedOut?: boolean }, cmd: Command) => rollbackAction(ms, o, globals(cmd)));
  rel
    .command("set <版本> <项> <决定>")
    .description("改合并单里某项的决定：<项> = 卡号（F-0003）或 #序号；<决定> = 并入 / 顺延 / 等它 / 不并")
    .option("--repo <id>", "卡片绑了多个分支时只改这个仓库的")
    .option("--branch <分支>", "只改这个分支")
    .action(async (ms: string, target: string, decision: string, o: { repo?: string; branch?: string }, cmd: Command) => {
      const g = globals(cmd);
      const p = await project(g);
      const r = setPlanDecision(p, ms, target, decision, o);
      if (g.json) emitJson("release.set", p, { file: r.plan.file, changed: r.changed });
      else writeAll(1, renderSetDecision(r, p));
    });

  runOptions(
    program
      .command("合并 <版本>")
      .description("= release run；加 --预演 = release preview（生成合并单）")
      .option("--预演", "只生成/刷新合并单（= release preview）"),
  ).action(async (ms: string, o: RunOpts & { 预演?: boolean }, cmd: Command) => {
    const g = globals(cmd);
    if (o.预演) return previewAction(ms, g);
    return runAction(ms, o, g);
  });
  program
    .command("演练 <版本>")
    .description("= release rehearse：在主仓库克隆上完整演练一遍合并")
    .option("--report <文件>", "演练报告另存一份到这个文件")
    .option("--budget <美元>", "解冲突器总预算（默认 10）")
    .action(async (ms: string, o: { report?: string; budget?: string }, cmd: Command) => rehearseAction(ms, o, globals(cmd)));
  program
    .command("回滚 <版本>")
    .description("= release rollback")
    .option("--yes", "不再确认")
    .option("--allow-checked-out", "引用在某个 worktree 里检出时仍继续")
    .action(async (ms: string, o: { yes?: boolean; allowCheckedOut?: boolean }, cmd: Command) => rollbackAction(ms, o, globals(cmd)));
}
/**
 * M4 合并单 / 执行 / 回滚 / 演练的中文终端渲染（事实与建议分开写）。
 */
import type { ProjectConfig } from "../core/project.ts";
import type { PreviewResult, SetDecisionResult } from "../core/release.ts";
import { conflictText, resultText, type PlanItem, type ReleasePlan } from "../core/release-plan.ts";
import type { RollbackReport, RunReport } from "../core/release-run.ts";
import { sec, type RehearseResult } from "../core/rehearse.ts";

const short = (s: string | null | undefined) => (s ? s.slice(0, 7) : "—");

function labelMap(plan: ReleasePlan): Map<string, string> {
  return new Map(plan.repos.map((r) => [r.repo, r.label]));
}

export function renderItemLine(i: PlanItem, k: number, labels: Map<string, string>): string {
  const box = i.decision === "并入" ? "[x]" : "[ ]";
  const changed = i.decision !== i.default_decision ? "（你改的）" : "";
  const where = i.repo && i.branch ? ` · ${labels.get(i.repo) ?? i.repo} ${i.branch}` : "";
  const state = i.state === "已进集成" ? "已进集成（跳过）" : i.state;
  const extra = [i.precheck?.conflicts.length ? conflictText(i) : null, i.detail, i.behind ? `落后集成 ${i.behind}` : null].filter(Boolean).join(" · ");
  const res = resultText(i);
  return `  #${String(k + 1).padEnd(3)} ${box} ${i.decision}${changed}  ${i.feature} ${i.title}${where} · ${state}${extra ? ` · ${extra}` : ""}${res ? `  ⇒ ${res}` : ""}`;
}

export function renderPlan(plan: ReleasePlan, project: ProjectConfig): string {
  const labels = labelMap(plan);
  const L: string[] = [];
  L.push(`合流 · ${project.name} · 合并单 ${plan.milestone}（${plan.status}）`);
  for (const r of plan.repos) L.push(`  ${r.label}：集成分支 ${r.integration_branch ?? "（未配置）"}${r.base_sha ? ` @${short(r.base_sha)}` : ""}`);
  const groups: Array<[string, PlanItem[]]> = [];
  for (const it of plan.items) {
    const key = it.state;
    const g = groups.find((x) => x[0] === key);
    if (g) g[1].push(it);
    else groups.push([key, [it]]);
  }
  let k = 0;
  for (const [state, items] of groups) {
    L.push("", `${state}（${items.length}）`);
    for (const it of items) L.push(renderItemLine(it, k++, labels));
  }
  const c = (d: string) => plan.items.filter((i) => i.decision === d).length;
  L.push("", `合计 ${plan.items.length} 项：并入 ${c("并入")} · 顺延 ${c("顺延")} · 等它 ${c("等它")} · 不并 ${c("不并")}`);
  return L.join("\n");
}

export function renderPreview(r: PreviewResult, project: ProjectConfig): string {
  const L = [renderPlan(r.plan, project), ""];
  L.push(`合并单：${r.file}`);
  if (r.kept) L.push(`保留了你改过的决定 ${r.kept} 项。`);
  L.push(`下一步（建议）：核对决定（改：heliu release set ${r.milestone.id} <卡号|#序号> 并入|顺延|等它|不并）→ heliu 合并 ${r.milestone.id} --dry-run → heliu 合并 ${r.milestone.id}`);
  return L.join("\n");
}

export function renderSetDecision(r: SetDecisionResult, project: ProjectConfig): string {
  const labels = labelMap(r.plan);
  const L = [r.changed.length ? `已改 ${r.changed.length} 项：` : "没有需要改的项（已是该决定，或已进集成/已合入）"];
  for (const it of r.changed) L.push(renderItemLine(it, r.plan.items.indexOf(it), labels));
  L.push(`合并单：${r.plan.file}`);
  void project;
  return L.join("\n");
}

export function renderRunReport(r: RunReport, project: ProjectConfig): string {
  const L: string[] = [];
  const labels = labelMap(r.plan);
  if (r.aborted.length) {
    L.push(`合流 · ${project.name} · 合并 ${r.milestone}：已中止，没有写任何东西`);
    for (const a of r.aborted) L.push(`  ✗ ${a}`);
    for (const w of r.warnings) L.push(`  ! ${w}`);
    return L.join("\n");
  }
  if (r.dryRun) {
    L.push(`合流 · ${project.name} · 合并 ${r.milestone}（--dry-run，只演示不执行）`);
    for (const l of r.dryRunLines) L.push(`  ${l}`);
    for (const w of r.warnings) L.push(`  ! ${w}`);
    return L.join("\n");
  }
  L.push(`合流 · ${project.name} · 合并 ${r.milestone}：${r.finalized ? "已发布" : "未收尾（待续）"} · 用时 ${(r.elapsedMs / 1000).toFixed(1)}s`);
  L.push(`  合入 ${r.merged.length} · 已在集成 ${r.alreadyIn.length} · 失败·待处理 ${r.failed.length} · 顺延 ${r.rolled.length} · 等它/未执行 ${r.waiting.length}${r.unrehearsed.length ? ` · 未演练 ${r.unrehearsed.length}` : ""}`);
  for (const i of r.merged) L.push(`  ✓ ${i.feature} ${i.title}（${labels.get(i.repo ?? "") ?? i.repo} ${i.branch}）→ ${short(i.new_sha)}${i.union_resolved?.length ? ` · union ${i.union_resolved.join("、")}` : ""}${i.resolver ? ` · 解冲突器 ${i.resolver.rounds} 轮 $${i.resolver.cost_usd.toFixed(2)}` : ""}`);
  for (const i of r.failed) L.push(`  ✗ ${i.feature} ${i.title}：${i.result_detail ?? ""}`);
  for (const x of r.rolled) L.push(`  → 顺延 ${x.feature} ${x.title} → ${x.to}（${x.reason}）`);
  for (const i of r.waiting) L.push(`  … ${i.feature} ${i.title}：${i.decision === "等它" ? "等它" : "未执行"}`);
  for (const t of r.tags) L.push(`  tag ${t.label} ${t.tag} → ${short(t.target)}`);
  for (const t of r.tagErrors) L.push(`  ✗ ${t}`);
  for (const mm of r.mainMoved) L.push(`  主线 ${mm.label}：${short(mm.from)} → ${short(mm.to)}（快进）`);
  for (const s of r.mainSkipped) L.push(`  主线未动 ${s.label}：${s.reason}`);
  if (r.costUsd > 0) L.push(`  解冲突器花费 $${r.costUsd.toFixed(2)}`);
  for (const w of r.warnings) L.push(`  ! ${w}`);
  L.push(`  合并单与发布说明：${r.plan.file}`);
  if (r.unpushed.length) {
    L.push("");
    L.push(`未推送：${r.unpushed.join("；")}（按仓库规矩，推送由你决定）`);
    L.push(`需要撤回：heliu 回滚 ${r.milestone}`);
  }
  return L.join("\n");
}

export function renderRollback(r: RollbackReport, project: ProjectConfig): string {
  if (r.nothing) return `合流 · ${project.name} · 回滚 ${r.milestone}：合并单里没有 heliu 移动过的引用，无需回滚`;
  const L = [`合流 · ${project.name} · 回滚 ${r.milestone}：${r.complete ? "完成" : "未完成"}`];
  for (const x of r.reverted) L.push(`  ✓ ${x.repo} ${x.ref}：${x.action}${x.to ? ` ${short(x.to)}` : ""}`);
  for (const x of r.skipped) L.push(`  - ${x.repo} ${x.ref}：${x.reason}`);
  for (const c of r.conflicts) L.push(`  ✗ ${c}`);
  if (r.ledgerRestored.length) L.push(`  台账恢复：${r.ledgerRestored.join("、")}`);
  for (const s of r.ledgerSkipped) L.push(`  ! ${s}`);
  if (r.milestoneStatus) L.push(`  里程碑状态恢复为「${r.milestoneStatus}」`);
  return L.join("\n");
}

export function renderRehearsal(r: RehearseResult): string {
  const L = [
    `演练完成：${r.milestone} · 合入 ${r.run.merged.length} · 失败 ${r.run.failed.length} · 顺延 ${r.run.rolled.length} · tag ${r.run.tags.length ? "已打" : "未打"} · 解冲突器 $${r.run.costUsd.toFixed(2)}`,
    `耗时：克隆 ${sec(r.cloneMs)} · 预演 ${sec(r.previewMs)} · 执行 ${sec(r.runMs)} · 合计 ${sec(r.totalMs)}`,
    `真仓库零写入：${r.zeroWrite ? "一致" : "有差异（见报告）"}（${r.snapshots.map((s) => `${s.label} ${s.items} 项`).join("、")}）`,
  ];
  if (r.run.aborted.length) L.push(`中止：${r.run.aborted.join("；")}`);
  L.push(`报告：${r.reportFiles.join("、")}`);
  return L.join("\n");
}
/**
 * 本机数据位置（ADR-3）。全部可用环境变量覆盖，测试用它指向 fixture。
 * - HELIU_HOME：heliu 注册表与缓存根目录
 * - HELIU_CLAUDE_APP_DIR：Claude 桌面应用数据目录（会话 JSON、git-worktrees.json）
 * - HELIU_CLAUDE_HOME：~/.claude（运行中会话 sessions/<pid>.json）
 */
import { existsSync, realpathSync } from "node:fs";
import { homedir } from "node:os";
import { join, resolve } from "node:path";

export interface HeliuPaths {
  heliuHome: string;
  projectsDir: string;
  claudeAppDir: string;
  desktopSessionsDir: string;
  gitWorktreesJson: string;
  claudeHome: string;
  runningSessionsDir: string;
}

export function heliuPaths(env: NodeJS.ProcessEnv = process.env): HeliuPaths {
  const home = homedir();
  const heliuHome = env.HELIU_HOME || join(home, "Library", "Application Support", "heliu");
  const claudeAppDir = env.HELIU_CLAUDE_APP_DIR || join(home, "Library", "Application Support", "Claude");
  const claudeHome = env.HELIU_CLAUDE_HOME || join(home, ".claude");
  return {
    heliuHome,
    projectsDir: join(heliuHome, "projects"),
    claudeAppDir,
    desktopSessionsDir: join(claudeAppDir, "claude-code-sessions"),
    gitWorktreesJson: join(claudeAppDir, "git-worktrees.json"),
    claudeHome,
    runningSessionsDir: join(claudeHome, "sessions"),
  };
}

/** 是否位于 iCloud Drive（按路径判断） */
export function looksLikeICloud(p: string): boolean {
  return p.includes("/Library/Mobile Documents/");
}

const realCache = new Map<string, string>();
/**
 * 规范化路径用于比较：realpath（不存在则 resolve）+ Unicode NFC。
 * realpath 只 stat 不读内容，不会触发 iCloud 下载。
 */
export function canonicalPath(p: string): string {
  const cached = realCache.get(p);
  if (cached !== undefined) return cached;
  let out: string;
  try {
    out = existsSync(p) ? realpathSync(p) : resolve(p);
  } catch {
    out = resolve(p);
  }
  out = out.normalize("NFC").replace(/\/+$/, "");
  realCache.set(p, out);
  return out;
}

/** child 是否等于 parent 或位于其下 */
export function isUnder(child: string, parent: string): boolean {
  return child === parent || child.startsWith(parent + "/");
}

/**
 * M4 合并执行的临时目录根（非 iCloud）：~/.cache/heliu（HELIU_CACHE_DIR 可覆盖，测试用）。
 * 下设 worktrees/<项目>/<里程碑>/<仓库>（解冲突用的临时 worktree）、rehearsal/<项目>/<时间>/（演练克隆）、tmp/。
 * 写模式 git 只允许在这里做 checkout / merge / reset 等会动工作区的操作。
 */
export function heliuCacheDir(env: NodeJS.ProcessEnv = process.env): string {
  return env.HELIU_CACHE_DIR || join(homedir(), ".cache", "heliu");
}
