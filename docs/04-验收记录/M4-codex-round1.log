function commit(repo: string, file: string, content: string, msg: string): void {
  mkdirSync(join(repo, file, ".."), { recursive: true });
  writeFileSync(join(repo, file), content);
  gitW(repo, "add", file);
  gitW(repo, "commit", "-q", "-m", msg);
}

