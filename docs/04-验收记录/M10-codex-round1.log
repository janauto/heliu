import type { FeatureView, TodoGroupKey } from "../src/types.ts";

/* ───────────── 语义 ───────────── */

export type Tone = "green" | "yellow" | "red" | "purple" | "gray" | "blue" | "accent";

/** 状态灯 → 人话 */
export const HUMAN: Record<Light | "blue", string> = {
  green: "能拼上",
  yellow: "要先对齐",
  red: "撞了",
  purple: "等你拍板",
  gray: "还在做",
  blue: "还没登记",
};
/** 待办分组 → 人话 / 颜色（顺序 = 处理优先级） */
