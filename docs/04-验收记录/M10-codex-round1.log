  { key: "blocked", human: "等你拍板", tone: "purple", hint: "会话停下来等你回答" },
  { key: "conflict", human: "撞了", tone: "red", hint: "试合有冲突文件，合并前要先解" },
  { key: "mergeable", human: "能拼上", tone: "green", hint: "试合无冲突，或已进集成分支" },
  { key: "behind", human: "要先对齐", tone: "yellow", hint: "分支落后基线，先同步再合" },
  { key: "active", human: "还在做", tone: "gray", hint: "开发中，或尚无提交" },
  { key: "stale", human: "没动静", tone: "gray", hint: "很久没有活动" },
  { key: "unbound", human: "还没绑分支", tone: "gray", hint: "卡片还没有绑定任何分支" },
];
export const toneOfGroup = (g: TodoGroupKey | null): Tone => GROUPS.find((x) => x.key === g)?.tone ?? "gray";
export const humanOfGroup = (g: TodoGroupKey | null): string => GROUPS.find((x) => x.key === g)?.human ?? "还在做";

export const MILESTONE_TONE: Record<string, Tone> = { 规划中: "accent", 冻结: "yellow", 合并中: "purple", 已发布: "green" };

/* ───────────── 方块数据模型 ───────────── */

export interface BlockChip {
  text: string;
  tone: Tone;
  title?: string;
}
export interface BlockModel {
  /** 唯一键：卡号，或「repo|branch」 */
  key: string;
  /** 卡号；没卡的分支为 null */
  id: string | null;
  title: string;
  type: string;
  typeGuess: boolean;
  module: string;
  light: Light | "blue";
  /** 人话 */
  human: string;
  /** 人话后面的小字事实 */
  fact: string | null;
  repoLabel: string | null;
  branch: string | null;
  /** 显示用的预约名；null = 未预约 */
  milestone: string | null;
  lastActivityAt: string | null;
  chips: BlockChip[];
  variant: "normal" | "merged-pending" | "done";
  needsAction: string | null;
}

const sumConflicts = (bs: CardBinding[]): number => bs.reduce((a, b) => a + (b.conflictFiles ?? 0), 0);
const maxBehind = (bs: CardBinding[]): { n: number; of: string } | null => {
  let best: { n: number; of: string } | null = null;
  for (const b of bs) {
    const vi = b.vsIntegration?.behind ?? null;
    const vm = b.vsMain?.behind ?? null;
    const n = vi ?? vm ?? 0;
    const of = vi !== null ? "集成分支" : "主线";
    if (n > 0 && (!best || n > best.n)) best = { n, of };
  }
  return best;
};

/** 功能卡 → 方块。next = 当前下一版的 id（卡里写的 next 字面量显示成它） */
export function modelOfCard(card: BoardCard, opts: { next?: string | null; milestoneTitle?: string | null } = {}): BlockModel {
  const chips: BlockChip[] = [];
  const behind = maxBehind(card.bindings);
  const conflicts = sumConflicts(card.bindings);
  const failed = card.bindings.some((b) => b.precheckState === "failed");
  if (!card.done) {
    if (behind) chips.push({ text: `落后 ${behind.n}`, tone: "yellow", title: `落后${behind.of} ${behind.n} 个提交，合并前要先同步` });
    if (conflicts > 0) chips.push({ text: `${conflicts} 个文件撞了`, tone: "red", title: "试合（merge-tree）发现的冲突文件数" });
    if (failed) chips.push({ text: "没试出来", tone: "yellow", title: "请求了试合但没得到结果：不算无冲突" });
    if (!card.bindings.length) chips.push({ text: "没绑分支", tone: "gray" });
    if (card.bindings.length && card.bindings.every((b) => !b.exists)) chips.push({ text: "分支不在本地", tone: "gray" });
  }
  if (card.rolledFrom.length) chips.push({ text: `从 ${card.rolledFrom[card.rolledFrom.length - 1]} 顺延`, tone: "gray" });
  if (card.acceptance !== "未") chips.push({ text: `验收 ${card.acceptance}`, tone: "green" });

  let human: string;
  let fact: string | null = null;
  if (card.done) {
    human = card.status === "已发布" ? "已发布" : card.status === "已进主线" ? "已进主线" : "已合入";
    fact = card.doneNote;
  } else if (card.variant === "merged-pending") {
    human = "已合入 · 等你确认台账";
    fact = card.mergedTo ? `分支已被${card.mergedTo === "已进主线" ? "主线" : "集成分支"}包含，台账还是「${card.status}」` : card.lightText;
  } else if (card.light === "purple") {
    human = "等你拍板";
    fact = card.needsAction?.trim() ? card.needsAction.trim().split("\n")[0]! : card.lightText;
  } else if (card.light === "gray") {
    if (card.group === "unbound") human = "还没绑分支";
    else if (card.group === "stale") {
      human = `没动静 ${card.idleDays ?? "?"} 天`;
    } else {
      human = "还在做";
      fact = card.note ?? (card.status === "想法" ? "还是个想法" : null);
    }
  } else {
    human = HUMAN[card.light];
    if (card.light === "green") fact = card.note ?? "试合无冲突";
    else if (card.light === "yellow") fact = behind ? `落后${behind.of} ${behind.n} 个提交，先同步再合` : card.lightText;
    else if (card.light === "red") fact = conflicts ? `合并前要先解 ${conflicts} 个文件` : card.lightText;
  }
  const repos = [...new Set(card.bindings.map((b) => b.repoLabel))];
  const first = card.bindings[0] ?? null;
  const ms = card.column === "__unreserved" ? null : card.milestone === "next" ? (opts.next ?? "下一版") : (opts.milestoneTitle ?? card.milestone);
  return {
    key: card.id,
    id: card.id,
    title: card.title,
    type: card.type,
    typeGuess: card.typeSource === "guess",
    module: card.module,
    light: card.light,
    human,
    fact,
    repoLabel: repos.length ? repos.join(" · ") : null,
    branch: first ? (first.label ?? first.branch) : null,
    milestone: ms,
    lastActivityAt: card.lastActivityAt,
    chips,
    variant: card.variant,
    needsAction: card.needsAction,
  };
}

/** 没卡的分支（/api/status 里的 FeatureView）→ 蓝色「还没登记」方块 */
export function modelOfBranch(f: FeatureView, repo: { id: string; label: string }, modules?: Array<{ name: string; keywords: string[] }>): BlockModel {
  const text = [f.label, f.branch, f.lastCommitSubject].filter(Boolean).join(" ");
  const chips: BlockChip[] = [];
  const vi = f.vsIntegration?.behind ?? null;
  const behind = vi ?? f.vsMain?.behind ?? 0;
  if (behind > 0) chips.push({ text: `落后 ${behind}`, tone: "yellow", title: `落后${vi !== null ? "集成分支" : "主线"} ${behind} 个提交` });
  const conflicts = f.precheck?.conflictFiles ?? 0;
  if (conflicts > 0) chips.push({ text: `${conflicts} 个文件撞了`, tone: "red" });
  if (f.sessionEntry) chips.push({ text: "会话入口 · 尚无提交", tone: "gray", title: "这条分支没有自己的提交，多半只是桌面会话的入口" });
  if (!f.pushed) chips.push({ text: "本地无远端引用", tone: "gray", title: "本地没有同名远端分支引用（heliu 从不 fetch，不等于远端一定没有）" });
  const s = f.sessions[0] ?? null;
  const fact =
    s?.status === "blocked" ? "会话等你拍板" : f.mergedState === "in_integration" ? "分支已进集成分支" : f.mergedState === "in_main" ? "分支已进主线" : s ? `会话：${s.title ?? s.sessionId.slice(0, 8)}` : null;
  const type: FeatureType = inferType(text);
  return {
    key: `${repo.id}|${f.branch}`,
    id: null,
    title: f.label || f.branch,
    type,
    typeGuess: true,
    module: inferModule(text, modules as never),
    light: "blue",
    human: "还没登记",
    fact,
    repoLabel: repo.label,
    branch: f.branch,
    milestone: null,
    lastActivityAt: s?.lastActivityAt && (!f.lastCommitAt || s.lastActivityAt > f.lastCommitAt) ? s.lastActivityAt : f.lastCommitAt,
    chips,
    variant: "normal",
    needsAction: s?.needsAction ?? null,
  };
}

export const glyphOf = (type: string): string => TYPE_GLYPH[type as FeatureType] ?? "○";

/** 搜索匹配：空关键词全部命中；否则任一字段包含（不分大小写） */
export function matchQuery(q: string, ...fields: Array<string | null | undefined>): boolean {
  const k = q.trim().toLowerCase();
  if (!k) return true;
  return fields.some((f) => !!f && f.toLowerCase().includes(k));
}
/**
 * 指针拖拽（M10）：鼠标、触控板、触屏统一走 Pointer Events，不用 HTML5 draggable（幽灵、文案、落点都自己画，跨浏览器一致）。
 * - 可放目标用 useDropTarget(spec) 登记（元素带 data-drop-id）。拖起时每个目标先回答 canDrop：
 *   返回 { ok, hint } 的加 drop-can / drop-no；返回 null 的表示对这种东西不感兴趣（不高亮）。
 * - 指针悬在目标上时加 drop-hot（不可放再加 drop-bad），并在指针旁显示文案（「放到这里：预约到 v1.2」/「已发布的版本不能再预约」）。
 * - 松手落在可放目标上 → onDrop(payload)；Esc 取消。拖拽本身不发请求，请求由 onDrop 决定（乐观更新 + 失败回滚由调用方负责）。
 * - 指针贴着可滚动容器（横向列容器、.main 工作台）的边缘时自动滚动，滚动后按当前指针位置重新找落点。
 */
import { useRef } from "preact/hooks";

export interface DragPayload<T = unknown> {
  /** card = 功能卡；branch = 没卡的分支；milestone = 版本；其他页面可自定义 */
  kind: "card" | "branch" | "milestone" | (string & {});
  id: string;
  /** 幽灵旁与 toast 里用的名字 */
  label: string;
  data: T;
}
export interface DropVerdict {
  ok: boolean;
  hint: string;
}
export interface DropSpec {
  /** null = 这个目标对这种东西不感兴趣 */
  canDrop(p: DragPayload): DropVerdict | null;
  onDrop(p: DragPayload): void | Promise<void>;
}

interface Target {
  el: HTMLElement;
  spec: DropSpec;
}
const targets = new Map<string, Target>();
let seq = 0;
let dragging = false;
export const isDragging = (): boolean => dragging;

export function registerDropTarget(el: HTMLElement, spec: DropSpec): () => void {
  const id = `dz${++seq}`;
  el.dataset.dropId = id;
  targets.set(id, { el, spec });
  return () => {
    targets.delete(id);
    if (el.dataset.dropId === id) delete el.dataset.dropId;
  };
}

/**
 * 在组件里把元素登记为可放目标：<div ref={useDropTarget(spec)}>。
 * 返回的 ref 回调是稳定的；spec 每次渲染可以换（闭包里拿最新的 props）。传 null = 暂时不接受任何拖放。
 */
export function useDropTarget(spec: DropSpec | null): (el: HTMLElement | null) => void {
  const specRef = useRef<DropSpec | null>(spec);
  specRef.current = spec;
  const cbRef = useRef<((el: HTMLElement | null) => void) | null>(null);
  if (!cbRef.current) {
    let unreg: (() => void) | null = null;
    const proxy: DropSpec = {
      canDrop: (p) => specRef.current?.canDrop(p) ?? null,
      onDrop: (p) => specRef.current?.onDrop(p),
    };
    cbRef.current = (el) => {
      unreg?.();
      unreg = null;
      if (el) unreg = registerDropTarget(el, proxy);
    };
  }
  return cbRef.current;
}

export interface DragOptions {
  /** 用来做幽灵的元素；缺省是 pointerdown 的 currentTarget */
  source?: HTMLElement | null;
  /** 移动多少像素才算拖（之前仍是点击） */
  threshold?: number;
  onStart?(): void;
  /** dropped = 是否落在可放目标上 */
  onEnd?(dropped: boolean): void;
}

/** 给方块用的 props：{...dragProps(payload)}；payload 可以是函数（拖起时才算） */
export function dragProps(payload: DragPayload | (() => DragPayload | null), opts: DragOptions = {}): { onPointerDown: (e: PointerEvent) => void } {
  return { onPointerDown: (e: PointerEvent) => beginDrag(e, payload, opts) };
}

export function beginDrag(e: PointerEvent, payloadOrFn: DragPayload | (() => DragPayload | null), opts: DragOptions = {}): void {
  if (dragging || e.button !== 0 || !e.isPrimary) return;
  const t = e.target as HTMLElement | null;
  if (t?.closest("button, a, input, select, textarea, [data-nodrag]")) return;
  const source = opts.source ?? (e.currentTarget as HTMLElement | null);
  if (!source) return;
  const sx = e.clientX;
  const sy = e.clientY;
  const rect = source.getBoundingClientRect();
  const offX = sx - rect.left;
  const offY = sy - rect.top;
  const threshold = opts.threshold ?? 6;
  let active = false;
  let payload: DragPayload | null = null;
  let ghost: HTMLElement | null = null;
  let hint: HTMLElement | null = null;
  let hot: { id: string; ok: boolean } | null = null;
  const verdicts = new Map<string, DropVerdict>();
  // 边缘自动滚动：拖起时收集源元素的可滚动祖先（横向列容器、.main 工作台…），指针贴边时滚它，滚完按当前指针重新找落点
  let scrollers: HTMLElement[] = [];
  let lastX = sx;
  let lastY = sy;
  let raf = 0;
  const EDGE = 56;
  const MAX_V = 16;
  const speed = (d: number) => Math.ceil(Math.min(MAX_V, (Math.max(0, d) / EDGE) * MAX_V));
  const collectScrollers = () => {
    const out: HTMLElement[] = [];
    let el: HTMLElement | null = source.parentElement;
    while (el && el !== document.body) {
      const cs = getComputedStyle(el);
      const sx_ = /(auto|scroll)/.test(cs.overflowX) && el.scrollWidth > el.clientWidth + 1;
      const sy_ = /(auto|scroll)/.test(cs.overflowY) && el.scrollHeight > el.clientHeight + 1;
      if (sx_ || sy_) out.push(el);
      el = el.parentElement;
    }
    return out;
  };
  const autoScroll = () => {
    raf = 0;
    if (!active) return;
    let moved = false;
    for (const el of scrollers) {
      const r = el.getBoundingClientRect();
      if (lastX < r.left - 8 || lastX > r.right + 8 || lastY < r.top - 8 || lastY > r.bottom + 8) continue;
      let vx = 0;
      let vy = 0;
      if (el.scrollWidth > el.clientWidth + 1) {
        if (lastX < r.left + EDGE) vx = -speed(r.left + EDGE - lastX);
        else if (lastX > r.right - EDGE) vx = speed(lastX - (r.right - EDGE));
      }
      if (el.scrollHeight > el.clientHeight + 1) {
        if (lastY < r.top + EDGE) vy = -speed(r.top + EDGE - lastY);
        else if (lastY > r.bottom - EDGE) vy = speed(lastY - (r.bottom - EDGE));
      }
      if (vx) {
        const b = el.scrollLeft;
        el.scrollLeft += vx;
        moved = moved || el.scrollLeft !== b;
      }
      if (vy) {
        const b = el.scrollTop;
        el.scrollTop += vy;
        moved = moved || el.scrollTop !== b;
      }
    }
    if (moved) {
      setHot(hitTest(lastX, lastY), lastX, lastY);
      raf = requestAnimationFrame(autoScroll);
    }
  };
  const onAnyScroll = () => {
    if (active) setHot(hitTest(lastX, lastY), lastX, lastY);
  };

  const start = (): boolean => {
    payload = typeof payloadOrFn === "function" ? payloadOrFn() : payloadOrFn;
    if (!payload) return false;
    dragging = true;
    active = true;
    document.body.classList.add("dragging");
    source.classList.add("is-dragging");
    ghost = source.cloneNode(true) as HTMLElement;
    ghost.classList.remove("is-dragging", "selected", "landed");
    ghost.classList.add("drag-ghost");
    ghost.style.width = `${rect.width}px`;
    ghost.style.height = `${rect.height}px`;
    ghost.style.transformOrigin = `${offX}px ${offY}px`;
    ghost.setAttribute("aria-hidden", "true");
    document.body.appendChild(ghost);
    hint = document.createElement("div");
    hint.className = "drag-hint";
    hint.hidden = true;
    document.body.appendChild(hint);
    for (const [id, tg] of targets) {
      const v = tg.spec.canDrop(payload);
      if (!v) continue;
      verdicts.set(id, v);
      tg.el.classList.add(v.ok ? "drop-can" : "drop-no");
    }
    scrollers = collectScrollers();
    document.addEventListener("scroll", onAnyScroll, { capture: true, passive: true });
    opts.onStart?.();
    return true;
  };

  const hitTest = (x: number, y: number): string | null => {
    for (const el of document.elementsFromPoint(x, y)) {
      const z = (el as HTMLElement).closest?.("[data-drop-id]") as HTMLElement | null;
      if (!z) continue;
      const id = z.dataset.dropId ?? "";
      if (verdicts.has(id)) return id;
      // 落在一个对此不感兴趣的目标上：继续往下找（可能嵌套）
    }
    return null;
  };

  const setHot = (id: string | null, x: number, y: number) => {
    if (hot && hot.id !== id) {
      targets.get(hot.id)?.el.classList.remove("drop-hot", "drop-bad");
      hot = null;
    }
    if (id && !hot) {
      const v = verdicts.get(id)!;
      const el = targets.get(id)!.el;
      el.classList.add("drop-hot");
      if (!v.ok) el.classList.add("drop-bad");
      hot = { id, ok: v.ok };
    }
    if (hint) {
      if (hot) {
        const v = verdicts.get(hot.id)!;
        hint.textContent = v.hint;
        hint.className = `drag-hint ${v.ok ? "ok" : "no"}`;
        hint.hidden = false;
      } else hint.hidden = true;
      hint.style.left = `${x}px`;
      hint.style.top = `${y}px`;
    }
  };

  const cleanup = () => {
    window.removeEventListener("pointermove", move);
    window.removeEventListener("pointerup", up);
    window.removeEventListener("pointercancel", cancel);
    window.removeEventListener("keydown", key);
    if (!active) return;
    document.removeEventListener("scroll", onAnyScroll, { capture: true });
    if (raf) cancelAnimationFrame(raf);
    raf = 0;
    for (const [id, v] of verdicts) targets.get(id)?.el.classList.remove(v.ok ? "drop-can" : "drop-no", "drop-hot", "drop-bad");
    ghost?.remove();
    hint?.remove();
    document.body.classList.remove("dragging");
    source.classList.remove("is-dragging");
    dragging = false;
  };

  const finish = (dropped: boolean) => {
    const target = dropped && hot?.ok ? targets.get(hot.id) : null;
    const p = payload;
    cleanup();
    if (active) {
      // 拖完同一位置会紧接着冒一个 click：吞掉它，免得顺手打开详情
      const swallow = (c: MouseEvent) => {
        c.stopPropagation();
        c.preventDefault();
      };
      window.addEventListener("click", swallow, { capture: true, once: true });
      setTimeout(() => window.removeEventListener("click", swallow, { capture: true }), 60);
      source.classList.add("landed");
      setTimeout(() => source.classList.remove("landed"), 400);
    }
    if (target && p) void target.spec.onDrop(p);
    if (active) opts.onEnd?.(!!target);
  };

  const move = (ev: PointerEvent) => {
    if (ev.pointerId !== e.pointerId) return;
    if (!active) {
      if (Math.hypot(ev.clientX - sx, ev.clientY - sy) < threshold) return;
      if (!start()) {
        cleanup();
        return;
      }
    }
    ev.preventDefault();
    lastX = ev.clientX;
    lastY = ev.clientY;
    if (ghost) ghost.style.transform = `translate(${ev.clientX - offX}px, ${ev.clientY - offY}px) rotate(1.2deg) scale(1.02)`;
    setHot(hitTest(ev.clientX, ev.clientY), ev.clientX, ev.clientY);
    if (!raf && scrollers.length) raf = requestAnimationFrame(autoScroll);
  };
  const up = (ev: PointerEvent) => {
    if (ev.pointerId !== e.pointerId) return;
    finish(true);
  };
  const cancel = () => finish(false);
  const key = (ev: KeyboardEvent) => {
    if (ev.key === "Escape") finish(false);
  };
  window.addEventListener("pointermove", move);
  window.addEventListener("pointerup", up);
  window.addEventListener("pointercancel", cancel);
  window.addEventListener("keydown", key);
}

