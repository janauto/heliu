export interface TLItem {
  /** 卡号，或「仓库 id|分支名」 */
  key: string;
  kind: "card" | "branch";
  card: BoardCard | null;
  branch: FeatureView | null;
  repo: string;
  repoLabel: string;
  /** 仓库主线 / 集成分支（选中没卡的分支时详情要用；没绑分支的卡为 null） */
  main: string | null;
  integration: string | null;
  module: string;
  title: string;
  tone: TLTone;
  start: Date | null;
  end: Date;
  /** created = 卡片创建时间（精确）；approx = 最早可见活动（近似，虚线）；none = 没有起点（画点） */
  startKind: "created" | "approx" | "none";
  /** activity = 有最后活动时间；none = 一点活动记录都没有，画在「现在」（空心点） */
  endKind: "activity" | "none";
  shape: "bar" | "dot";
  /** 像素（相对时间轴左边），已截到 [0, width] */
  x0: number;
  x1: number;
  /** 起点早于时间窗：从窗左边起画，加「←」 */
  clippedLeft: boolean;
  /** 整条都早于时间窗（最后活动在窗外） */
  outside: boolean;
}

