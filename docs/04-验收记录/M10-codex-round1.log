/**
 * 方块模型（M10，纯函数、不依赖 DOM / preact，可单测）：
 * 功能卡 / 没卡的分支 → 方块的人话、事实、芯片；待办分组 → 人话 / 颜色；全局搜索匹配。
 * 人话只从服务端的 light / group / variant / done 推，前端不自己判断 git 事实。
 */
import type { BoardCard, CardBinding, Light } from "../src/board/api-types.ts";
