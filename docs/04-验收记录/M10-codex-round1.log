    --line: #262b47;
    --line-strong: #353c62;
/* ───────────── 右侧详情（Inspector）：点任意方块滑入（M10） ───────────── */
.inspector {
  position: fixed; top: var(--titlebar-h); right: 0; bottom: var(--statusbar-h); width: var(--inspector-w); z-index: 40;
  display: flex; flex-direction: column; background: var(--surface); border-left: 1px solid var(--line); box-shadow: var(--shadow-lg);
  transform: translateX(16px); opacity: 0; pointer-events: none; transition: transform var(--t-slow) var(--ease), opacity var(--t);
}
.inspector.open { transform: none; opacity: 1; pointer-events: auto; }
.insp-head { display: flex; align-items: flex-start; gap: var(--s2); padding: var(--s4) var(--s4) var(--s3) var(--s5); border-bottom: 1px solid var(--line); }
.insp-head .block-type { font-size: 12px; }
.insp-head h2 { font-size: 16px; line-height: 1.4; word-break: break-word; margin-top: 4px; }
.insp-head h2 input { width: 100%; height: 32px; font-size: 15px; font-weight: 650; }
.insp-head .meta { font-size: 12px; color: var(--muted); margin-top: 4px; display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
.insp-head .x { flex: none; margin-left: auto; }
.insp-body { flex: 1; min-height: 0; overflow-y: auto; padding: var(--s3) var(--s5) var(--s6); }
.insp-section { padding: var(--s4) 0; border-bottom: 1px solid var(--line); }
.insp-section:last-child { border-bottom: none; }
.insp-section > h3 { font-size: 11.5px; letter-spacing: 0.08em; color: var(--faint); font-weight: 700; margin-bottom: var(--s3); display: flex; align-items: center; gap: 8px; }
.insp-section > h3 .right { margin-left: auto; letter-spacing: 0; font-weight: 500; color: var(--muted); font-size: 12px; }
.insp-human { display: flex; flex-direction: column; gap: 6px; padding: 10px 12px; border-radius: var(--r-sm); background: var(--tone-bg); }
.insp-human .h { font-size: 15px; font-weight: 700; color: var(--tone); display: flex; align-items: center; gap: 8px; }
.insp-human .f { font-size: 13px; color: var(--fg-2); white-space: pre-wrap; word-break: break-word; }
.kv2 { display: grid; grid-template-columns: 5.5em 1fr; gap: 8px 12px; font-size: 13px; align-items: center; }
.kv2 > span:nth-child(odd) { color: var(--muted); }
.kv2 select, .kv2 input[type="text"] { width: 100%; }
.kv2 .v { min-width: 0; word-break: break-word; }
.bind-card { border: 1px solid var(--line); border-radius: var(--r-md); padding: var(--s3) var(--s4); background: var(--surface-2); }
.bind-card + .bind-card { margin-top: var(--s2); }
.bind-card .br { display: flex; align-items: center; gap: 8px; font-size: 13px; flex-wrap: wrap; }
.bind-card .br code { background: transparent; padding: 0; color: var(--fg); font-weight: 600; }
.bind-card .facts { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.bind-card .path { font-size: 11.5px; color: var(--faint); word-break: break-all; margin-top: 6px; }
.bind-card .files { margin: 8px 0 0; padding-left: 16px; font-size: 12px; color: var(--fg-2); }
.bind-card .files li { word-break: break-all; }
.bind-card .actions { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
.insp-session { display: flex; flex-direction: column; gap: 6px; font-size: 13px; }
.insp-session .needs { background: var(--purple-bg); border-radius: var(--r-xs); padding: 8px 10px; white-space: pre-wrap; word-break: break-word; color: var(--fg-2); }
.insp-session .needs b { color: var(--purple); }
.insp-actions { display: flex; flex-direction: column; gap: 8px; }
.insp-actions .btn { justify-content: flex-start; height: 36px; }
.insp-actions .hint { font-size: 12px; color: var(--muted); line-height: 1.5; }
.insp-sugg { display: flex; flex-direction: column; gap: 8px; padding: 10px 12px; border-radius: var(--r-sm); background: var(--surface-2); border: 1px dashed var(--line-strong); font-size: 13px; }
.insp-sugg .btn { align-self: flex-start; }
.insp-foot { padding: var(--s3) var(--s5); border-top: 1px solid var(--line); font-size: 11.5px; color: var(--faint); word-break: break-all; }

