 succeeded in 0ms:
      app.toast(`没改成：${msg(e)}`, { kind: "err" });
    }
  };
  const reserve = (card: BoardCard, ms: LedgerMilestone) => {
    const name = milestoneLabel(ms.id, app.milestones, app.next);
    // 原值（撤销用）：与详情面板同一口径
    const back = card.milestone === "next" ? (app.next ?? null) : card.column === "__unreserved" ? null : card.milestone;
    const backName = back ? milestoneLabel(back, app.milestones, app.next) : "未预约";
    void patchCard(card, { milestone: ms.id }, { milestone: ms.id, column: ms.id }, `${card.id} → ${name}（已写入台账）`, { body: { milestone: back }, text: `改回${backName}` });
  };
  const register = async (b: BranchDrag, ms: LedgerMilestone) => {
    const name = milestoneLabel(ms.id, app.milestones, app.next);
    try {
      const r = await api<{ feature: { id: string; title: string }; milestoneCreated: string | null }>("/api/features", {
        body: { title: b.title, milestone: ms.id, bind: { repo: b.repo, branch: b.branch.branch }, type: b.type, module: b.module },
      });
      app.toast(`已登记 ${r.data.feature.id}「${r.data.feature.title}」，预约到 ${name}（已写入台账；可在详情里改预约）`);
      app.reloadFeatures();
      app.refresh();
    } catch (e) {
      app.toast(`没登记成：${msg(e)}`, { kind: "err" });
    }
  };
  const moveModule = (card: BoardCard, module: string) => {
    const back = card.moduleSource === "card" ? card.module : null;
    void patchCard(card, { module }, { module, moduleSource: "card" }, `${card.id} 模块 → ${module}（已写入台账）`, { body: { module: back }, text: `模块改回${back ?? "推测"}` });
  };

  /* ───────────── 渲染 ───────────── */

  const head = (
    <PageHead icon="timeline" title="时间线" desc="每一块什么时候在动、里程碑在哪；把条拖到上面的版本芯片 = 预约。">
      <Seg options={RANGES.map((r) => ({ value: r.value, label: r.label }))} value={range} onChange={setRange} />
      <button class="btn small" onClick={() => toToday(true)} title="把今天放回时间轴右侧">
        <Icon name="calendar" size={15} />
        回到今天
      </button>
    </PageHead>
  );

  if (!app.project) {
    return (
      <div class="page wide tl-page">
        {head}
        <Empty icon="start" title="还没有选项目" hint="先在「开始」里接入或选择一个项目。">
          <button class="btn primary" onClick={() => app.go("start")}>
            去「开始」
          </button>
        </Empty>
      </div>
    );
  }
  if (!app.features && app.featuresError) {
    return (
      <div class="page wide tl-page">
        {head}
        <div class="err">功能卡没拿到：{app.featuresError}</div>
      </div>
    );
  }
  if (!app.features) {
    return (
      <div class="page wide tl-page">
        {head}
        <div class="tl-skeleton" aria-busy="true" aria-label="正在加载时间线">
          {[0, 1, 2, 3, 4, 5].map((i) => (
            <div class="tl-sk-row">
              <span class="skeleton" style={`width:${i % 3 === 0 ? 140 : 200}px`} />
              <span class="skeleton" style={`margin-left:${60 + ((i * 97) % 300)}px;width:${120 + ((i * 53) % 220)}px`} />
            </div>
          ))}
        </div>
      </div>
    );
  }

  const chips = app.milestones.filter((m) => m.status !== "已发布");
  const inWindowMs = model.milestones.filter((m) => m.inWindow);
  const W = model.width;

  return (
    <div class="page wide tl-page">
      {head}

      <div class="tl-toolbar">
        <div class="fchips" role="group" aria-label="按状态筛选">
          {FILTERS.map((f) => {
            const n = f.key === "all" ? queried.length : (tones[f.key] ?? 0);
            return (
              <button class={`fchip${filter === f.key ? " on" : ""}${f.tone ? ` tone-${f.tone}` : ""}`} disabled={f.key !== "all" && !n && filter !== f.key} onClick={() => setFilter(f.key)} aria-pressed={filter === f.key}>
                {f.label} <b>{n}</b>
              </button>
            );
          })}
        </div>
        {!app.status ? (
          <span class="tl-note">{app.statusError ? `分支数据没拿到（${app.statusError}）：先只画功能卡` : "分支数据还在加载：先画功能卡"}</span>
        ) : null}
      </div>

      <div class="tl-ms-chips" aria-label="版本芯片：把条拖上来 = 预约">
        <span class="tl-ms-lead">
          <Icon name="arrow" size={14} />
          拖到版本上 = 预约
        </span>
        {chips.length ? (
          chips.map((m) => <VersionChip key={m.id} ms={m} onReserve={reserve} onRegister={register} onLocate={(x) => locate(bodyRef.current, x, leftW())} line={model.milestones.find((l) => l.id === m.id) ?? null} />)
        ) : (
          <span class="muted small">还没有未发布的版本：在看板里新建一个版本后就能拖上来预约。</span>
        )}
      </div>

      {nothing ? (
        <Empty icon="timeline" title="还没有可以画的方块" hint="登记一张功能卡，或在被管理的仓库里开一条分支，它就会出现在这里。" />
      ) : (
        <>
          <div class="tl-body" ref={bodyRef} onPointerLeave={() => setHover(null)}>
            <div class="tl-grid" style={`width:calc(var(--tl-left) + ${W}px)`}>
              <div class="tl-head">
                <div class="tl-corner" ref={cornerRef}>
                  <span>
                    WBS · <b>{flat.shown}</b> 块
                  </span>
                  <button
                    class="btn ghost xs"
                    onClick={() => setCollapsed((s) => (s.size ? new Set() : new Set(model.tree.map((n) => repoKey(n.repo)))))}
                    title={collapsed.size ? "全部展开" : "全部收起"}
                  >
                    {collapsed.size ? "全部展开" : "全部收起"}
                  </button>
                </div>
                <div class="tl-scale" style={`width:${W}px`}>
                  {model.ticks.map((t) =>
                    t.kind === "today" ? (
                      <span class="tl-tick today" style={`left:${t.x}px`}>
                        今天
                      </span>
                    ) : t.label ? (
                      <span class={`tl-tick${t.major ? " major" : ""}`} style={`left:${t.x}px`} title={mdhm(new Date(t.t).toISOString())}>
                        {t.label}
                      </span>
                    ) : null,
                  )}
                  {inWindowMs.map((m) => (
                    <span class="tl-ms-label" style={`left:${Math.max(36, Math.min(W - 36, m.x))}px`} title={`${m.id}${m.title !== m.id ? ` ${m.title}` : ""} · 目标日期 ${mmdd(m.date.getTime())} · ${m.status}`}>
                      <Pill tone={MILESTONE_TONE[m.status] ?? "accent"}>
                        {m.id} · {mmdd(m.date.getTime())}
                      </Pill>
                    </span>
                  ))}
                </div>
              </div>

              <div class="tl-rows" style={flat.rows.length ? `height:${flat.height}px` : undefined}>
                <div class="tl-lines" style={`width:${W}px;height:${Math.max(flat.height, 120)}px`} aria-hidden="true">
                  {model.ticks.map((t) => (t.kind === "today" ? null : <i class={`tl-gridline${t.major ? " major" : ""}`} style={`left:${t.x}px`} />))}
                  {inWindowMs.map((m) => (
                    <i class={`tl-ms tone-${MILESTONE_TONE[m.status] ?? "accent"}`} style={`left:${m.x}px`} />
                  ))}
                  {model.todayX >= 0 && model.todayX <= W ? <i class="tl-today" style={`left:${model.todayX}px`} /> : null}
                </div>
                {flat.rows.length ? (
                  flat.rows.map((r) => (
                    <Row
                      key={r.key}
                      r={r}
                      width={W}
                      hover={hover === r.key}
                      onHover={setHover}
                      selKey={selKey}
                      blocks={blocks}
                      onToggle={toggle}
                      onPick={pick}
                      payloadOf={payloadOf}
                      onModuleDrop={moveModule}
                      onSessions={() => app.go("sessions")}
                    />
                  ))
                ) : (
                  <div class="tl-none">
                    <Empty inline icon="filter" title="没有符合筛选的方块" hint={q ? `搜索「${q}」` : undefined}>
                      <button
                        class="btn small"
                        onClick={() => {
                          setFilter("all");
                          app.setQuery("");
                        }}
                      >
                        清除筛选
                      </button>
                    </Empty>
                  </div>
                )}
              </div>
            </div>
          </div>
          <p class="tl-legend">
            <span>
              <i class="lg-bar" />条 = 从最早到最后一次可见活动
            </span>
            <span>
              <i class="lg-bar approx" />虚线边 = 起点为近似（最早可见活动）
            </span>
            <span>
              <i class="lg-dot" />只有一个时间点
            </span>
            <span>
              <i class="lg-dot hollow" />还没有活动记录（画在现在）
            </span>
            <span>
              <b>←</b> 起点或最后活动早于时间窗
            </span>
            <span>
              <i class="lg-ms" />版本目标日期
            </span>
          </p>
        </>
      )}
    </div>
  );
}

/** 点版本芯片：把它的目标日期线滚进可视区 */
function locate(el: HTMLDivElement | null, x: number, left: number) {
  if (!el) return;
  el.scrollTo({ left: Math.max(0, x - (el.clientWidth - left) / 2), behavior: "smooth" });
}

/* ───────────── 版本芯片（落点） ───────────── */

const targetOf = (ms: LedgerMilestone): number | null => parseDay(ms.target_date);

function VersionChip({
  ms,
  line,
  onReserve,
  onRegister,
  onLocate,
}: {
  ms: LedgerMilestone;
  line: { x: number; inWindow: boolean } | null;
  onReserve: (c: BoardCard, ms: LedgerMilestone) => void;
  onRegister: (b: BranchDrag, ms: LedgerMilestone) => Promise<void>;
  onLocate: (x: number) => void;
}) {
  const app = useApp();
  const name = milestoneLabel(ms.id, app.milestones, app.next);
  const col = app.features?.columns.find((c) => c.key === ms.id) ?? null;
  const blocked = col && !col.droppable ? (col.dropHint ?? `${name} 现在不能再预约（${ms.status}）`) : null;
  const ref = useDropTarget({
    canDrop: (p) => {
      if (p.kind === "card") {
        const c = p.data as BoardCard;
        if (c.column === ms.id || (c.milestone === "next" && app.next === ms.id)) return { ok: false, hint: "已经在这一版" };
        if (c.done) return { ok: false, hint: "已完成的卡不再改预约" };
        if (blocked) return { ok: false, hint: blocked };
        return { ok: true, hint: `放到这里：预约到 ${name}` };
      }
      if (p.kind === "branch") {
        if (blocked) return { ok: false, hint: blocked };
        return { ok: true, hint: `放到这里：登记成功能卡并预约到 ${name}` };
      }
      return null;
    },
    onDrop: (p) => {
      if (p.kind === "card") onReserve(p.data as BoardCard, ms);
      else if (p.kind === "branch") return onRegister(p.data as BranchDrag, ms);
    },
  });
  const isNext = app.next === ms.id;
  return (
    <div
      class={`tl-chip${isNext ? " next" : ""}`}
      ref={ref}
      role="button"
      tabIndex={0}
      title={`${name} · ${ms.status}${ms.target_date ? ` · 目标日期 ${ms.target_date}` : " · 还没定目标日期"}${line && !line.inWindow ? "（不在当前时间窗里）" : ""}`}
      onClick={() => line && line.inWindow && onLocate(line.x)}
      onKeyDown={(e) => {
        if ((e.key === "Enter" || e.key === " ") && line && line.inWindow) {
          e.preventDefault();
          onLocate(line.x);
        }
      }}
    >
      <b class="name">{name}</b>
      <Pill tone={MILESTONE_TONE[ms.status] ?? "gray"}>{isNext ? "下一版" : ms.status}</Pill>
      <span class="meta">
        {targetOf(ms) !== null ? `目标 ${mmdd(targetOf(ms)!)}` : "没定日期"}
        {col ? ` · 还欠 ${col.owed}` : ""}
      </span>
/* ───────────── 今天（HomeView，M10）：下一版大方块 · 新点子 · 现在最该做的 · 最近动的 · 健康 ───────────── */
.hm-err { margin-bottom: var(--s4); }
.hm-proj { color: var(--fg-2); font-weight: 650; }

/* ① 下一版：一块大积木（顶上三颗品牌色钉），同时是拖放落点 */
.hm-next {
  position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--s6);
  margin-top: var(--s2); padding: var(--s6); border-radius: var(--r-xl);
  background: radial-gradient(120% 160% at 100% 0%, var(--accent-soft), transparent 60%), var(--surface);
  box-shadow: 0 3px 0 var(--edge), var(--shadow-md);
  transition: outline-color var(--t-fast), background-color var(--t-fast), box-shadow var(--t);
}
.hm-studs { position: absolute; top: -7px; left: var(--s6); display: flex; gap: var(--s2); pointer-events: none; }
.hm-studs i { display: block; width: 18px; height: 12px; border-radius: 6px 6px 3px 3px; background: var(--brand); box-shadow: 0 1px 0 var(--edge); }
.hm-next.none .hm-studs i { background: var(--line-strong); }
.hm-next.drop-can { box-shadow: 0 3px 0 var(--edge), var(--shadow-lg); }

.hm-next-main { min-width: 0; display: flex; flex-direction: column; gap: var(--s5); }
.hm-next-head { display: flex; align-items: center; gap: var(--s3); flex-wrap: wrap; }
.hm-next-id { font-family: var(--font-display); font-size: 30px; font-weight: 750; line-height: 1.1; letter-spacing: -0.02em; }
.hm-next-id.hm-none { font-size: 22px; color: var(--muted); }
.hm-next-title { font-size: 15px; font-weight: 600; color: var(--fg-2); }
.hm-next-date { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--muted); white-space: nowrap; }
.hm-none-hint { font-size: 14px; color: var(--muted); max-width: 560px; }

.hm-next-body { display: flex; align-items: center; gap: var(--s6); }
.hm-owed { flex: none; min-width: 132px; gap: var(--s1); }
.hm-owed .hm-owed-k { font-size: 14px; font-weight: 650; color: var(--fg-2); }
.hm-owed .v { font-size: 64px; }
.hm-owed .v small { font-family: var(--font-sans); font-size: 15px; font-weight: 600; color: var(--muted); letter-spacing: 0; margin-left: 6px; }
.hm-progress { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--s3); }
.hm-legend { gap: var(--s2) var(--s4); font-size: 13.5px; }
.hm-legend button {
  display: inline-flex; align-items: center; gap: 6px; margin: -4px -8px; padding: 4px 8px; border: none; border-radius: var(--r-xs);
  background: none; color: var(--fg-2); white-space: nowrap; transition: background var(--t-fast), color var(--t-fast);
}
.hm-legend button:hover { background: var(--surface-3); color: var(--fg); }
.hm-legend button b { font-family: var(--font-display); font-weight: 700; color: var(--fg); }
.hm-unk { font-size: 12.5px; font-weight: 600; color: var(--faint); }
.hm-facts { display: flex; flex-wrap: wrap; gap: var(--s1) var(--s4); font-size: 12.5px; color: var(--muted); }
.hm-drop-tip { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--faint); transition: color var(--t-fast); }
.hm-next.drop-can .hm-drop-tip { color: var(--accent); font-weight: 600; }

.hm-next-side { display: flex; flex-direction: column; gap: var(--s2); min-width: 176px; }
.hm-cta { height: 46px; padding: 0 var(--s5); font-size: 15px; border-radius: var(--r-md); }
.hm-cta2 { height: 38px; border-radius: var(--r-md); }

/* ② 我有个新点子…：一块虚线输入积木，聚焦变实线 */
.hm-idea {
  display: flex; align-items: center; gap: var(--s3); margin-top: var(--s5); padding: var(--s2) var(--s2) var(--s2) var(--s4);
  background: var(--surface); border: 1.5px dashed var(--line-strong); border-radius: var(--r-lg);
  transition: border-color var(--t-fast), box-shadow var(--t-fast);
}
.hm-idea:hover { border-color: var(--accent-line); }
.hm-idea:focus-within { border-style: solid; border-color: var(--accent); box-shadow: var(--ring); }
.hm-idea .hm-idea-icon { flex: none; color: var(--accent); }
.hm-idea input[type="text"] { flex: 1; min-width: 0; height: 46px; padding: 0 var(--s1); border: none; background: transparent; font-size: 16px; }
.hm-idea input[type="text"]:focus { border: none; box-shadow: none; }
.hm-idea .btn { flex: none; height: 44px; padding: 0 var(--s5); font-size: 14px; border-radius: var(--r-md); }
.hm-idea-note { margin: var(--s2) var(--s4) 0; font-size: 12.5px; color: var(--muted); }

/* ③ 现在最该做的：一句一个方块行 */
.hm-actions { display: flex; flex-direction: column; gap: var(--s3); margin: 0; padding: 0; list-style: none; }
.hm-action {
  display: flex; align-items: center; gap: var(--s4); padding: var(--s4) var(--s5);
  background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); box-shadow: 0 2px 0 var(--edge), var(--shadow-xs);
}
.hm-num {
  flex: none; display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%;
  background: var(--brand); color: #fff; box-shadow: var(--brand-shadow);
  font-family: var(--font-display); font-size: 16px; font-weight: 750; font-variant-numeric: tabular-nums;
}
.hm-action-text { flex: 1; min-width: 0; font-size: 15px; line-height: 1.6; color: var(--fg); word-break: break-word; }
.hm-arrow { margin: 0 var(--s2); color: var(--accent); font-weight: 700; }
.hm-sugg { color: var(--fg-2); }
.hm-action .btn { flex: none; }
.hm-note { margin-top: var(--s3); font-size: 12.5px; color: var(--muted); }

/* ④ 最近动的：一排 card 方块 */
.hm-recent { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: var(--s4); padding-top: var(--s1); align-items: start; }

/* ⑤ 健康小行 */
.hm-health { display: flex; flex-wrap: wrap; gap: var(--s3); }
.hm-hitem {
  display: inline-flex; align-items: center; gap: var(--s2); min-height: 40px; padding: var(--s2) var(--s4);
  border: 1px solid var(--line); border-radius: var(--r-md); background: var(--surface); color: var(--fg-2);
  font-size: 13.5px; line-height: 1.45; text-align: left; box-shadow: var(--shadow-xs);
}
.hm-hitem b { font-family: var(--font-display); font-weight: 700; color: var(--tone, var(--fg)); }
.hm-hitem.tone-gray b { color: var(--fg); }
.hm-hitem.tone-red, .hm-hitem.tone-purple, .hm-hitem.tone-yellow { background: var(--tone-bg); border-color: var(--tone-line); color: var(--fg); }
.hm-hitem .hm-sub { color: var(--muted); }
.hm-hitem .hm-chev { flex: none; color: var(--faint); margin-right: calc(-1 * var(--s1)); }
button.hm-hitem { cursor: pointer; transition: transform var(--t-fast) var(--ease), box-shadow var(--t-fast), border-color var(--t-fast); }
button.hm-hitem:hover { transform: translateY(-1px); box-shadow: var(--shadow-sm); border-color: var(--tone-line, var(--accent-line)); }

/* 骨架占位 */
.hm-sk-title { display: inline-block; width: 120px; height: 30px; }
.hm-sk-num { display: block; flex: none; width: 120px; height: 72px; border-radius: var(--r-md); }
.hm-sk-bar { display: block; height: 12px; border-radius: 999px; }
.hm-sk-line { display: block; width: 62%; height: 14px; }
.hm-sk-row { display: block; height: 70px; border-radius: var(--r-lg); }
.hm-sk-block { display: block; height: 160px; border-radius: var(--r-md); }
.hm-sk-pill { display: inline-block; width: 220px; height: 40px; border-radius: var(--r-md); }

/* 响应式：≤1100 下一版上下排；≤700 全部单列 */
@media (max-width: 1100px) {
  .hm-next { grid-template-columns: minmax(0, 1fr); gap: var(--s5); padding: var(--s5); }
  .hm-studs { left: var(--s5); }
  .hm-next-side { flex-direction: row; flex-wrap: wrap; min-width: 0; }
  .hm-next-side .btn { flex: 1 1 160px; }
}
@media (max-width: 700px) {
  .hm-next { padding: var(--s4); border-radius: var(--r-lg); }
  .hm-studs { left: var(--s4); }
  .hm-next-id { font-size: 24px; }
  .hm-next-body { flex-direction: column; align-items: stretch; gap: var(--s4); }
  .hm-owed .v { font-size: 52px; }
  .hm-idea { flex-wrap: wrap; padding: var(--s2) var(--s2) var(--s2) var(--s3); }
  .hm-idea .btn { width: 100%; }
  .hm-action { flex-wrap: wrap; gap: var(--s3); padding: var(--s4); }
  .hm-action-text { flex-basis: calc(100% - 36px - var(--s3)); }
  .hm-action .btn { margin-left: calc(36px + var(--s3)); }
  .hm-recent { grid-template-columns: minmax(0, 1fr); }
  .hm-health { flex-direction: column; }
  .hm-hitem { width: 100%; }
}
/* ───────────── 看板（M10）：一列一个版本，方块拖到别的列 = 预约（只写台账） ─────────────
 * 桌面：页面占满工作台高度，列横向排开（320px，列间 24px，scroll-snap），每列内部自己纵向滚动。
 * 手机（≤700px）：列改竖向堆叠、宽 100%，整页滚动。
 */
.kb-page { display: flex; flex-direction: column; height: 100%; min-height: 0; padding-bottom: var(--s4); }
.kb-page > .page-head { flex: none; margin-bottom: var(--s4); }
.kb-page > .empty { flex: none; }
.kb-filters { align-items: center; }
.kb-filters .fchip .dot { width: 7px; height: 7px; }
.kb-filters .fchip .icon { margin-right: -2px; opacity: 0.7; }

.kb-idea-wrap { position: relative; }
.kb-idea-pop { right: 0; top: calc(100% + var(--s2)); width: 360px; max-width: calc(100vw - 2 * var(--s4)); padding: var(--s3); }

.kb-note { flex: none; display: flex; align-items: center; gap: var(--s2); flex-wrap: wrap; margin: 0 0 var(--s3); font-size: 13px; color: var(--muted); }
.kb-note b { font-family: var(--font-display); font-weight: 700; color: var(--fg); }
.kb-note .icon { color: var(--faint); }
.kb-err { flex: none; margin-bottom: var(--s3); }
.kb-foot { flex: none; margin-top: var(--s2); font-size: 12px; color: var(--faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* 列容器 */
.kb-cols {
  flex: 1 1 auto; min-height: 0; display: flex; align-items: stretch; gap: var(--s5);
  overflow-x: auto; overflow-y: hidden; overscroll-behavior-x: contain;
  margin: 0 calc(-1 * var(--s1)); padding: var(--s2) var(--s1) var(--s3);
  scroll-snap-type: x proximity; scroll-padding-left: var(--s1);
}

/* 一列 = 一块托盘 */
.kb-col {
  position: relative; flex: 1 1 320px; min-width: 320px; max-width: 420px; min-height: 0; display: flex; flex-direction: column;
  background: color-mix(in srgb, var(--surface) 62%, transparent);
  border: 1px solid var(--line); border-radius: var(--r-lg);
  scroll-snap-align: start;
  transition: opacity var(--t), background-color var(--t-fast);
}
.kb-col.is-next { border-color: var(--accent-line); }
.kb-col.is-next::before { content: ""; position: absolute; left: var(--s4); right: var(--s4); top: -1px; height: 3px; border-radius: 0 0 3px 3px; background: var(--brand); }
.kb-col.kind-unreserved { border-style: dashed; border-color: var(--line-strong); }
.kb-col.kind-released { background: color-mix(in srgb, var(--surface) 38%, transparent); }

/* 列头 */
.kb-col-head { flex: none; display: flex; flex-direction: column; gap: var(--s2); padding: var(--s4) var(--s4) var(--s3); border-bottom: 1px solid var(--line); }
.kb-col-title { display: flex; align-items: center; gap: var(--s2); min-height: 32px; }
.kb-col-title h2 { min-width: 0; font-family: var(--font-display); font-size: 17px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.kb-col-tools { display: flex; align-items: center; gap: 2px; flex: none; margin-left: auto; margin-right: calc(-1 * var(--s1)); }
.kb-col-tools .icon-btn { width: 30px; height: 30px; }
.kb-menu-wrap { position: relative; }
.kb-menu { right: 0; top: calc(100% + 6px); min-width: 252px; }
.kb-col-sub { margin-top: calc(-1 * var(--s1)); font-size: 12.5px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.kb-owed { display: flex; align-items: baseline; gap: var(--s2); }
.kb-owed .num { font-size: 30px; line-height: 1; color: var(--fg); }
.kb-owed .k { font-size: 13px; color: var(--muted); }
.kb-col-facts { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 6px; font-size: 12.5px; color: var(--muted); }
.kb-col-facts b { font-family: var(--font-display); font-weight: 700; color: var(--fg); font-variant-numeric: tabular-nums; }
.kb-col-facts .sep { color: var(--faint); }
.kb-col-facts .warn b { color: inherit; }

/* 列身：自己滚动；上留 16px 给方块的积木钉，左右留 12px 给选中光圈 */
.kb-col-body { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; overflow-x: hidden; overflow-y: auto; overscroll-behavior: contain; padding: var(--s4) var(--s3) var(--s3); }
.kb-empty { padding: var(--s4) var(--s2) 0; text-align: center; font-size: 13px; color: var(--muted); }

/* 列底落点：撑满剩余高度，空列时常显虚线框；拖起时才提示文字 */
.kb-drop-pad {
  flex: 1 0 80px; min-height: 80px; margin-top: var(--s3); padding: var(--s3);
  display: flex; align-items: center; justify-content: center; text-align: center;
  border: 1.5px dashed transparent; border-radius: var(--r-md); color: var(--faint); font-size: 12.5px; line-height: 1.5;
  transition: border-color var(--t-fast), background-color var(--t-fast), color var(--t-fast);
}
.kb-drop-pad span { opacity: 0; transition: opacity var(--t-fast); }
.kb-drop-pad.empty { border-color: var(--line-strong); }
.kb-drop-pad.empty span { opacity: 1; }
.kb-col.drop-can .kb-drop-pad { border-color: var(--accent-line); color: var(--accent); }
.kb-col.drop-can .kb-drop-pad span { opacity: 1; }
.kb-col.drop-hot .kb-drop-pad { border-color: var(--accent); background-color: var(--accent-soft); }
.kb-col.locked.drop-no .kb-drop-pad { border-color: var(--line-strong); }
.kb-col.locked.drop-no .kb-drop-pad span { opacity: 1; }
.kb-col.drop-hot.drop-bad .kb-drop-pad { border-color: var(--red); color: var(--red); background-color: var(--red-bg); }

/* 内联登记 */
.kb-new { display: flex; flex-direction: column; gap: var(--s2); }
.kb-new input[type="text"] { width: 100%; }
.kb-new-foot { display: flex; align-items: center; gap: var(--s2); }
.kb-new-foot .hint { flex: 1; min-width: 0; font-size: 12px; color: var(--muted); }
.kb-col-body > .kb-new { flex: none; margin-bottom: var(--s4); padding: var(--s3); background: var(--surface); border: 1px solid var(--accent-line); border-radius: var(--r-md); box-shadow: var(--shadow-sm); }

/* 骨架 */
.kb-skel .kb-col-head { gap: var(--s3); }
.kb-skel .kb-col-body { gap: var(--s3); }
.kb-skel-title { width: 45%; height: 20px; }
.kb-skel-num { width: 30%; height: 28px; }
.kb-skel-bar { width: 100%; height: 5px; border-radius: 999px; }
.kb-skel-card { height: 116px; border-radius: var(--r-md); }

/* 手机：列竖向堆叠、宽 100%，整页滚动 */
@media (max-width: 700px) {
  .kb-page { height: auto; }
  .kb-cols { flex-direction: column; gap: var(--s4); overflow: visible; margin: 0; padding: var(--s1) 0 0; scroll-snap-type: none; }
  .kb-col { width: 100%; }
  .kb-col-body { overflow: visible; }
  .kb-drop-pad { flex: none; }
  .kb-foot { white-space: normal; }
}

