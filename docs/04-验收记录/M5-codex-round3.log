## 5. 看板启动诊断
- `runBoard` 第一行无条件同步写 stderr：「合流看板启动中…（HELIU_DEBUG=1 可看详细阶段）」——桌面 launch.json 预览下至少能确认进程活着、卡在哪一步之前（M3 的 HELIU_DEBUG 打点照旧）。
- `.claude/launch.json`：`runtimeExecutable: "bin/heliu"`、`runtimeArgs: ["board","--project","磁吸背夹","--port","7788","--no-open"]`（不再经 `bun run`）；桌面预览验证由 Fable 做。

## 6. 测试
`bun test` **222** 个全绿（15 个文件；含 M4 合入的 release 测试）；`tests/onboard.test.ts` 9 个：无候选时不设集成分支、包含数候选与「叠在之上」降级、名字候选优先、参数优先、`--yes` 建台账（数据目录、仓库零写入、建完能直接 `待办`）、无终端无 `--yes` 只登记、`--json`、install/uninstall `--dry-run`、marketplace.json 结构、看板启动行。`bun run typecheck` 通过。

## 7. 已知限制
- 安装脚本未在本机真装（按派单只跑 `--dry-run`）；`claude mcp add` / `plugin install` 的真实输出与「已装过」时的返回码由 Fable 真装时确认。
- user 级 MCP 与插件自带的 MCP 同名并存时，会话里 heliu 工具会出现两份（`mcp__heliu__*` 与插件那份）；`--no-mcp` 可只留插件那份。是否默认去掉 user 级注册，留给真装后决定。
- 安装脚本不把 `heliu` 放进 PATH（README 给了 `ln -s` 写法），避免改系统目录。
- 向导的「名字像」规则会把 `release/*` 产品线当成集成分支候选第一名（固件仓即如此）；交互模式会列候选让你选，`--yes` 时请配合 `--integration`/`--main`。
- 注册表有了第二个项目（patent-figure-kit）后，在任何项目目录之外不带 `--project` 运行命令会提示「请用 --project 指定」（以前只有一个项目时会默认用它）。
- 交互提问用 Bun 的 `prompt()`，只在 TTY 下出现。

 succeeded in 0ms:
/**
 * 本机数据位置（ADR-3）。全部可用环境变量覆盖，测试用它指向 fixture。
 * - HELIU_HOME：heliu 注册表与缓存根目录
 * - HELIU_CLAUDE_APP_DIR：Claude 桌面应用数据目录（会话 JSON、git-worktrees.json）
 * - HELIU_CLAUDE_HOME：~/.claude（运行中会话 sessions/<pid>.json）
 */
import { existsSync, realpathSync } from "node:fs";
import { homedir } from "node:os";
import { join, resolve } from "node:path";

export interface HeliuPaths {
  heliuHome: string;
  projectsDir: string;
  claudeAppDir: string;
  desktopSessionsDir: string;
  gitWorktreesJson: string;
  claudeHome: string;
  runningSessionsDir: string;
}

export function heliuPaths(env: NodeJS.ProcessEnv = process.env): HeliuPaths {
  const home = homedir();
  const heliuHome = env.HELIU_HOME || join(home, "Library", "Application Support", "heliu");
  const claudeAppDir = env.HELIU_CLAUDE_APP_DIR || join(home, "Library", "Application Support", "Claude");
  const claudeHome = env.HELIU_CLAUDE_HOME || join(home, ".claude");
  return {
    heliuHome,
    projectsDir: join(heliuHome, "projects"),
    claudeAppDir,
    desktopSessionsDir: join(claudeAppDir, "claude-code-sessions"),
    gitWorktreesJson: join(claudeAppDir, "git-worktrees.json"),
    claudeHome,
    runningSessionsDir: join(claudeHome, "sessions"),
  };
}

/** 是否位于 iCloud Drive（按路径判断） */
export function looksLikeICloud(p: string): boolean {
  return p.includes("/Library/Mobile Documents/");
}

const realCache = new Map<string, string>();
/**
 * 规范化路径用于比较：realpath（不存在则 resolve）+ Unicode NFC。
 * realpath 只 stat 不读内容，不会触发 iCloud 下载。
 */
export function canonicalPath(p: string): string {
  const cached = realCache.get(p);
  if (cached !== undefined) return cached;
  let out: string;
  try {
    out = existsSync(p) ? realpathSync(p) : resolve(p);
  } catch {
    out = resolve(p);
  }
  out = out.normalize("NFC").replace(/\/+$/, "");
  realCache.set(p, out);
  return out;
}

/** child 是否等于 parent 或位于其下 */
export function isUnder(child: string, parent: string): boolean {
  return child === parent || child.startsWith(parent + "/");
}

/**
 * M4 合并执行的临时目录根（非 iCloud）：~/.cache/heliu（HELIU_CACHE_DIR 可覆盖，测试用）。
 * 下设 worktrees/<项目>/<里程碑>/<仓库>（解冲突用的临时 worktree）、rehearsal/<项目>/<时间>/（演练克隆）、tmp/。
 * 写模式 git 只允许在这里做 checkout / merge / reset 等会动工作区的操作。
 */
export function heliuCacheDir(env: NodeJS.ProcessEnv = process.env): string {
  return env.HELIU_CACHE_DIR || join(homedir(), ".cache", "heliu");
}
/**
 * 「同步基线（预演）」：把主线 / 集成分支合入某个功能分支会冲突哪些文件——只试合、不执行。
 * 复用 M1 的只读层：runGit 白名单 + precheckMerge（merge-tree --write-tree，对象隔离区 + 沙箱）。
 * merge-tree 的冲突文件集合与合并方向无关，所以「主线合入本分支」与「本分支合入主线」冲突文件相同。
 */
import type { LedgerFeature } from "../types.ts";
import { aheadBehind, precheckMerge, refExists } from "../core/branches.ts";
import { createObjectQuarantine, lines, runGit, type RunGitOptions } from "../core/git.ts";
import { canonicalPath } from "../core/paths.ts";
import type { ProjectConfig } from "../core/project.ts";
import type { BaselineBinding, BaselineCheck, BaselineData } from "./api-types.ts";

export async function baselinePreview(project: ProjectConfig, feature: LedgerFeature, timeoutMs = 8000): Promise<BaselineData> {
  const started = performance.now();
  const bindings: BaselineBinding[] = [];
  for (const b of feature.bindings) {
    const cfg = project.repos.find((r) => r.id === b.repo);
    const out: BaselineBinding = { repo: b.repo, repoLabel: cfg?.label ?? b.repo, branch: b.branch, exists: false, checks: [] };
    bindings.push(out);
    if (!cfg) continue;
    const root = canonicalPath(cfg.path);
    const opts: RunGitOptions = { timeoutMs, limitKey: root, protect: [root] };
    const rp = await runGit(root, ["rev-parse", "--path-format=absolute", "--git-common-dir"], opts);
    if (!rp.ok) continue;
    const common = canonicalPath(lines(rp.stdout)[0] ?? `${root}/.git`);
    opts.protect = [root, common];
    const ref = `refs/heads/${b.branch}`;
    out.exists = await refExists(root, ref, opts);
    if (!out.exists) continue;
    const bases: Array<{ base: BaselineCheck["base"]; branch: string }> = [{ base: "main", branch: cfg.main }];
    if (cfg.integration && cfg.integration !== b.branch) bases.push({ base: "integration", branch: cfg.integration });
    const quarantine = createObjectQuarantine(common);
    try {
      for (const base of bases) {
        if (base.branch === b.branch) continue;
        const baseRef = `refs/heads/${base.branch}`;
        if (!(await refExists(root, baseRef, opts))) {
          out.checks.push({ base: base.base, baseBranch: base.branch, behind: null, conflictFiles: null, conflicts: [], error: "该分支在本地不存在" });
          continue;
        }
        const [ab, pc] = await Promise.all([aheadBehind(root, baseRef, ref, opts), precheckMerge(root, base.branch, baseRef, null, ref, quarantine, opts)]);
        out.checks.push({
          base: base.base,
          baseBranch: base.branch,
          behind: ab?.behind ?? null,
          conflictFiles: pc.conflictFiles,
          conflicts: pc.conflicts,
          error: pc.timedOut ? "试合超时" : pc.error,
        });
      }
    } finally {
      quarantine.dispose();
    }
  }
  return { id: feature.id, title: feature.title, bindings, elapsedMs: Math.round(performance.now() - started) };
}
/**
 * heliu board：本机看板服务（Hono on Bun，只监听 127.0.0.1）。
 *
 * - /api/*：JSON，外壳 = JsonEnvelope + meta（数据时间/用时/是否命中缓存）。
 * - 写接口只动台账（features/*.md、milestones.yaml、releases/*.md 草稿），绝不动被管理仓库；
 *   合并只预演（merge-tree 在对象隔离区 + 沙箱里试合），执行留给 M4。
 * - 防 DNS rebinding：Host 必须是 127.0.0.1 / localhost / [::1]；写接口必须是 application/json（浏览器跨站表单发不出来）。
 * - createBoardApp 不监听端口，测试直接用 app.request()；runBoard 才起服务。
 */
import { existsSync, writeSync } from "node:fs";
import { join } from "node:path";
import { Hono, type Context } from "hono";
import { SCHEMA_VERSION } from "../types.ts";
import type { HeliuPaths } from "../core/paths.ts";
import { Ledger } from "../core/ledger.ts";
import { ProjectError, resolveProject, type ProjectConfig } from "../core/project.ts";
import type { BoardEnvelope, BoardMeta } from "./api-types.ts";
import { DIST_DIR, ensureWebBuild } from "./build.ts";
import { BoardService } from "./data.ts";

export const DEFAULT_PORT = 7788;
const LOCAL_HOSTS = new Set(["127.0.0.1", "localhost", "[::1]", "::1"]);

export interface BoardAppOptions {
  paths: HeliuPaths;
  project: ProjectConfig;
  ttlMs?: number;
  now?: () => Date;
  distDir?: string;
}

function hostAllowed(host: string | undefined): boolean {
  if (!host) return true; // 非浏览器客户端（curl 总会带 Host；app.request 测试可能不带）
  const name = host.startsWith("[") ? host.slice(0, host.indexOf("]") + 1) : (host.split(":")[0] ?? "");
  return LOCAL_HOSTS.has(name.toLowerCase());
}

const truthy = (v: string | undefined) => v === "1" || v === "true" || v === "yes";

export function createBoardApp(opts: BoardAppOptions): { app: Hono; service: BoardService } {
  const service = new BoardService({ paths: opts.paths, project: opts.project, ttlMs: opts.ttlMs, now: opts.now });
  const dist = opts.distDir ?? DIST_DIR;
  const app = new Hono();

  const send = <T>(c: Context, command: string, data: T, meta: BoardMeta | null = null, status: 200 | 201 = 200) => {
    const p = service.project;
    const body: BoardEnvelope<T> = {
      schemaVersion: SCHEMA_VERSION,
      command,
      generatedAt: new Date().toISOString(),
      project: { name: p.name, source: p.source },
      data,
      meta,
    };
    c.header("Cache-Control", "no-store");
    return c.json(body, status);
  };

  const body = async (c: Context): Promise<Record<string, unknown>> => {
    const text = await c.req.text();
    if (!text.trim()) return {};
    try {
      const v = JSON.parse(text) as unknown;
      if (v && typeof v === "object" && !Array.isArray(v)) return v as Record<string, unknown>;
    } catch {
      /* 落到下面的报错 */
    }
    throw new ProjectError("请求体必须是 JSON 对象");
  };

  app.use("*", async (c, next) => {
    if (!hostAllowed(c.req.header("host"))) return c.json({ error: "只接受本机访问（Host 必须是 127.0.0.1 / localhost）" }, 403);
    if (c.req.method !== "GET" && c.req.method !== "HEAD") {
      const ct = c.req.header("content-type") ?? "";
      if (!ct.toLowerCase().startsWith("application/json")) return c.json({ error: "写接口只接受 Content-Type: application/json" }, 415);
    }
    await next();
  });

  app.onError((err, c) => {
    const status = err instanceof ProjectError ? 400 : 500;
    if (status === 500) console.error(`heliu board：${err.stack ?? err}`);
    return c.json({ error: err.message }, status);
  });

  /* ───────────── 只读 ───────────── */

  app.get("/api/status", async (c) => {
    const r = await service.status(truthy(c.req.query("precheck")), truthy(c.req.query("fresh")));
    return send(c, "status", r.data, r.meta);
  });
  app.get("/api/sessions", async (c) => {
    const r = await service.sessions();
    return send(c, "sessions", r.data, r.meta);
  });
  app.get("/api/hygiene", async (c) => {
    const r = await service.hygiene();
    return send(c, "hygiene", r.data, r.meta);
  });
  app.get("/api/milestones", (c) => send(c, "milestone.list", service.milestones()));
  app.get("/api/features", async (c) => {
    // 版本列默认试合（灯色要分出「有冲突」）；precheck=0 时冲突「未检查」
    const pc = c.req.query("precheck");
    const r = await service.features(c.req.query("milestone") ?? null, pc === undefined ? true : truthy(pc));
    return send(c, "feature.list", r.data, r.meta);
  });
  app.get("/api/features/:id/baseline", async (c) => send(c, "feature.baseline", await service.baseline(c.req.param("id"))));
  app.get("/api/todo", async (c) => {
    const r = await service.todo(c.req.query("milestone") ?? "下一版", truthy(c.req.query("precheck")));
    return send(c, "milestone.todo", r.data, r.meta);
  });
  app.get("/api/overview", async (c) => {
    const r = await service.overview(truthy(c.req.query("precheck")));
    return send(c, "overview", r.data, r.meta);
  });
  app.get("/api/release/preview", async (c) => {
    const r = await service.releasePreview(c.req.query("milestone") ?? "下一版");
    return send(c, "release.preview", r.data, r.meta);
  });

  /* ───────────── 写台账 ───────────── */

  app.post("/api/features", async (c) => send(c, "feature.add", service.addFeature(await body(c)), null, 201));
  app.patch("/api/features/:id", async (c) => send(c, "feature.update", service.patchFeature(c.req.param("id"), await body(c))));
  app.post("/api/sync", async (c) => {
    const b = await body(c);
    const dry = b.dry_run ?? b.dryRun;
    return send(c, "sync", await service.sync(dry === true || dry === "true" || dry === 1));
  });
  app.post("/api/release/plan", async (c) => {
    const b = await body(c);
    const ms = typeof b.milestone === "string" && b.milestone.trim() ? b.milestone : "下一版";
    return send(c, "release.plan", await service.releasePlan(ms), null, 201);
  });

  app.all("/api/*", (c) => c.json({ error: `没有这个接口：${c.req.method} ${c.req.path}` }, 404));

  /* ───────────── 前端静态文件 ───────────── */

  const file = (name: string, type: string) => (c: Context) => {
    const p = join(dist, name);
    if (!existsSync(p)) return c.text("看板前端还没有打包：请用 heliu board 启动（会自动打包）", 503);
    return new Response(Bun.file(p), { headers: { "Content-Type": type, "Cache-Control": "no-cache" } });
  };
  app.get("/", file("index.html", "text/html; charset=utf-8"));
  app.get("/index.html", file("index.html", "text/html; charset=utf-8"));
  app.get("/app.js", file("app.js", "text/javascript; charset=utf-8"));
  app.get("/app.css", file("app.css", "text/css; charset=utf-8"));

  return { app, service };
}

export interface RunBoardOptions {
  paths: HeliuPaths;
  projectName?: string;
  cwd: string;
  port?: number;
  open?: boolean;
  log?: (line: string) => void;
}

/**
 * HELIU_DEBUG=1 时逐步往 stderr 打点（同步写，进程卡住也能看到最后一步）：
 * 用来定位桌面应用 launch.json 启动时「进程在、端口没监听、连横幅都没打」的挂起（M5 排查）。
 */
export function debugLogger(env: NodeJS.ProcessEnv = process.env): (step: string) => void {
  if (env.HELIU_DEBUG !== "1") return () => undefined;
  const t0 = performance.now();
  return (step: string) => {
    try {
      writeSync(2, `[heliu board +${Math.round(performance.now() - t0)}ms] ${step}\n`);
    } catch {
      /* stderr 不可写就算了 */
    }
  };
}

/** 起服务并一直运行到 Ctrl+C（main.ts 在 main() 返回后会 process.exit，所以这里不能提前返回） */
export async function runBoard(opts: RunBoardOptions): Promise<void> {
  // 无论是否 HELIU_DEBUG，先往 stderr 打一行：桌面 launch.json 预览下至少能看到进程活着（M5）
  try {
    writeSync(2, "合流看板启动中…（HELIU_DEBUG=1 可看详细阶段）\n");
  } catch {
    /* stderr 不可写就算了 */
  }
  const dbg = debugLogger();
  dbg(`开始：pid=${process.pid} cwd=${opts.cwd} bun=${Bun.version} HELIU_HOME=${opts.paths.heliuHome}`);
  const log = opts.log ?? ((l: string) => console.log(l));
  dbg(`加载项目…（--project=${opts.projectName ?? "未指定，按目录识别"}）`);
  const project = await resolveProject(opts.paths, opts.projectName, opts.cwd);
  dbg(`项目已加载：${project.name}（${project.repos.length} 个仓库，${project.source}）`);
  dbg("读台账…");
  try {
    const ledger = Ledger.of(project);
    const ms = ledger.listMilestones().length;
    const n = ledger.load().features.length;
    dbg(`台账可读：${ledger.dir}（${ms} 个里程碑、${n} 张卡）`);
  } catch (e) {
    dbg(`台账读取失败（不影响启动，页面里会报错）：${(e as Error).message}`);
  }
  dbg("检查前端打包…");
  const build = await ensureWebBuild();
  dbg(`前端${build.built ? `已重新打包（${build.ms} ms）` : "沿用已有打包"}：${build.dir}`);
  const { app, service } = createBoardApp({ paths: opts.paths, project });
  const port = opts.port ?? DEFAULT_PORT;
  dbg(`监听 127.0.0.1:${port}…`);
  let server: ReturnType<typeof Bun.serve>;
  try {
    server = Bun.serve({ hostname: "127.0.0.1", port, fetch: app.fetch, idleTimeout: 120 });
  } catch (e) {
    const msg = String((e as Error).message ?? e);
    dbg(`监听失败：${msg}`);
    if (/EADDRINUSE|in use/i.test(msg)) throw new ProjectError(`端口 ${port} 已被占用：换一个端口（heliu board --port ${port + 1}），或先关掉占用它的程序`);
    throw e;
  }
  dbg(`已监听 127.0.0.1:${server.port}`);
  dbg("预热开始（后台扫描：不预检 + 预检）");
  service.warm();
  const url = `http://127.0.0.1:${server.port}/`;
  const kb = (n: number) => `${(n / 1024).toFixed(1)} KB`;
  log(`合流看板 · ${project.name}`);
  log(`  地址：${url}（只监听本机）`);
  log(`  前端：${build.built ? `已重新打包（${build.ms} ms）` : "沿用已有打包"} · app.js ${kb(build.sizes["app.js"] ?? 0)} · app.css ${kb(build.sizes["app.css"] ?? 0)}`);
  log("  只读为主：改预约/改名/放弃只写台账；合并只预演，不执行（M4）。按 Ctrl+C 退出。");
  if (opts.open !== false) {
    try {
      Bun.spawn({ cmd: ["open", url], stdout: "ignore", stderr: "ignore" });
    } catch {
      log(`  （没能自动打开浏览器，请手动打开 ${url}）`);
    }
  }
  await new Promise<void>((resolve) => {
    const stop = () => {
      server.stop(true);
      resolve();
    };
    process.once("SIGINT", stop);
    process.once("SIGTERM", stop);
  });
}
#!/usr/bin/env bun
/**
 * MCP 冒烟：在临时 fixture 上起 `bin/heliu mcp` 子进程，按 JSON-RPC 依次发
 *   initialize → notifications/initialized → tools/list → tools/call heliu_feature_add → tools/call heliu_milestone_todo
 * 打印每一步的结果。不碰任何真实项目：HELIU_HOME / 桌面会话目录全部指向临时目录。
 *
 * 用法：bun run scripts/mcp-smoke.ts        （--keep 保留临时目录便于查看台账文件）
 */
import { join } from "node:path";
import { buildFixture } from "../tests/helpers/fixture.ts";

const BIN = join(import.meta.dir, "..", "bin", "heliu");
const keep = process.argv.includes("--keep");
const fx = buildFixture();
const env = { ...process.env, ...fx.env };

// 1) 注册项目（只写临时 HELIU_HOME）
const reg = Bun.spawnSync({ cmd: [process.execPath, "run", BIN, "project", "add", fx.repo, "--name", "演示", "--integration", "integ"], env, stdout: "pipe", stderr: "pipe" });
if (reg.exitCode !== 0) {
  console.error("注册 fixture 项目失败：", reg.stderr.toString());
  process.exit(1);
}

// 2) 起 MCP 子进程
const child = Bun.spawn({ cmd: [process.execPath, "run", BIN, "mcp"], cwd: fx.repo, env, stdin: "pipe", stdout: "pipe", stderr: "pipe" });
const killer = setTimeout(() => {
  console.error("超时：MCP 30 秒内没有完成全部请求");
  child.kill();
  process.exit(1);
}, 30_000);

const pending = new Map<number, (v: unknown) => void>();
let buf = "";
(async () => {
  const reader = (child.stdout as ReadableStream<Uint8Array>).getReader();
  const dec = new TextDecoder();
  for (;;) {
    const { value, done } = await reader.read();
    if (done) break;
    buf += dec.decode(value, { stream: true });
    let i: number;
    while ((i = buf.indexOf("\n")) >= 0) {
      const line = buf.slice(0, i).trim();
      buf = buf.slice(i + 1);
      if (!line) continue;
      const msg = JSON.parse(line) as { id?: number };
      if (typeof msg.id === "number") pending.get(msg.id)?.(msg);
    }
  }
})();

let seq = 0;
function send(method: string, params?: unknown, notify = false): Promise<unknown> {
  const msg: Record<string, unknown> = { jsonrpc: "2.0", method };
  if (params !== undefined) msg.params = params;
  if (notify) {
    child.stdin.write(JSON.stringify(msg) + "\n");
    child.stdin.flush();
    return Promise.resolve(null);
  }
  const id = ++seq;
  msg.id = id;
  const p = new Promise((resolve) => pending.set(id, resolve));
  child.stdin.write(JSON.stringify(msg) + "\n");
  child.stdin.flush();
  return p;
}

type CallResult = { result?: { content?: Array<{ text?: string }>; isError?: boolean }; error?: unknown };
const textOf = (r: unknown) => ((r as CallResult).result?.content ?? []).map((c) => c.text ?? "").join("\n");

let failed = false;
try {
  const init = (await send("initialize", { protocolVersion: "2025-06-18", capabilities: {}, clientInfo: { name: "heliu-smoke", version: "1" } })) as {
    result?: { serverInfo?: { name: string; version: string }; instructions?: string };
  };
  console.log("① initialize →", JSON.stringify(init.result?.serverInfo));
  await send("notifications/initialized", undefined, true);

  const list = (await send("tools/list")) as { result?: { tools?: Array<{ name: string; description: string; inputSchema: { properties?: Record<string, unknown> } }> } };
  const tools = list.result?.tools ?? [];
  console.log(`② tools/list → ${tools.length} 个工具`);
  for (const t of tools) console.log(`   - ${t.name}：${t.description.slice(0, 60)}…（参数：${Object.keys(t.inputSchema.properties ?? {}).join(", ")}）`);

  const add = await send("tools/call", { name: "heliu_feature_add", arguments: { title: "让背夹支持闹钟", cwd: fx.wt.standalone } });
  console.log("③ tools/call heliu_feature_add →");
  console.log(textOf(add).replace(/^/gm, "   "));
  if ((add as CallResult).result?.isError || !textOf(add).includes("已登记 F-0001")) failed = true;

  const todo = await send("tools/call", { name: "heliu_milestone_todo", arguments: { milestone: "下一版", cwd: fx.wt.standalone } });
  console.log("④ tools/call heliu_milestone_todo（下一版）→");
  console.log(textOf(todo).replace(/^/gm, "   "));
  if (!textOf(todo).includes("让背夹支持闹钟")) failed = true;
} catch (e) {
  console.error("冒烟失败：", e);
  failed = true;
} finally {
  clearTimeout(killer);
  child.stdin.end();
  await Promise.race([child.exited, Bun.sleep(2000)]);
  child.kill();
  if (keep) console.log(`临时目录保留：${fx.root}`);
  else fx.cleanup();
}
console.log(failed ? "结论：失败" : "结论：通过");
process.exit(failed ? 1 : 0);
#!/usr/bin/env bash
# 合流（heliu）安装脚本：bun → 依赖 → user 级 MCP → 本地 marketplace + 插件。
#   scripts/install.sh            安装
#   scripts/install.sh --dry-run  只打印每一步要执行的命令，什么都不改
#   --with-mcp   额外注册 user 级 MCP（默认只装插件；插件已自带同名 MCP，装两份会在会话里出现重复工具）
#   --no-mcp     （默认行为，保留以兼容）
#   --no-plugin  不装插件（只注册 MCP）
# 只改 Claude Code 的用户配置（~/.claude.json、插件设置）与本仓库的 node_modules；不碰任何被管理的仓库。
# 兼容 macOS 自带 bash 3.2。
set -euo pipefail

DRY=0
SKIP_MCP=1
SKIP_PLUGIN=0
usage() { sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; }
for a in "$@"; do
  case "${a}" in
    --dry-run | -n) DRY=1 ;;
    --no-mcp) SKIP_MCP=1 ;;
    --with-mcp) SKIP_MCP=0 ;;
    --no-plugin) SKIP_PLUGIN=1 ;;
    -h | --help) usage; exit 0 ;;
    *) echo "未知参数：${a}（--help 看用法）" >&2; exit 2 ;;
  esac
done

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MARKETPLACE="heliu-local" # 与 .claude-plugin/marketplace.json 的 name 一致
PLUGIN="heliu"

# 打印命令；非 dry-run 时执行。失败只警告不中断（例如已经注册过）。
# 打印用的引号：含空格/特殊字符时用双引号包起来（中文原样显示，可直接复制到终端）
q() {
  case "$1" in
    *[[:space:]\"\'\$\`\\\(\)\;\&\|\<\>\*\?\!]* | "") printf '"%s"' "$(printf '%s' "$1" | sed 's/[\\"$`]/\\&/g')" ;;
    *) printf '%s' "$1" ;;
  esac
}
run() {
  printf '  $'
  for x in "$@"; do printf ' %s' "$(q "${x}")"; done
  printf '\n'
  if [ "${DRY}" = 0 ]; then
    if ! "$@"; then echo "  ！上面这条没成功（可能已经装过）；继续下一步" >&2; fi
  fi
}
step() { printf '\n【%s】%s\n' "$1" "$2"; }

[ "${DRY}" = 1 ] && echo "合流安装 · 演练模式（--dry-run）：只打印命令，不执行" || echo "合流安装：${ROOT}"

step "1/5" "检查 bun"
BUN=""
for c in "$(command -v bun 2>/dev/null || true)" "${HOME}/.bun/bin/bun" /opt/homebrew/bin/bun /usr/local/bin/bun "${BUN_BIN:-}"; do
  if [ -n "${c}" ] && [ -x "${c}" ]; then BUN="${c}"; break; fi
done
if [ -z "${BUN}" ]; then
  echo "  没找到 bun。先安装：curl -fsSL https://bun.sh/install | bash   （或 brew install oven-sh/bun/bun），再重跑本脚本。"
  if [ "${DRY}" = 0 ]; then exit 1; fi
  BUN="bun"
else
  echo "  bun：${BUN}（$("${BUN}" --version 2>/dev/null || echo 版本未知)）"
fi

step "2/5" "安装依赖（node_modules → node_modules.nosync 软链，iCloud 不同步）"
if [ -L "${ROOT}/node_modules" ]; then
  echo "  node_modules 已是软链 → $(readlink "${ROOT}/node_modules")"
elif [ -e "${ROOT}/node_modules" ]; then
  echo "  node_modules 是普通目录（仓库不在 iCloud 时没关系；在 iCloud 里建议改成软链）"
else
  run mkdir -p "${ROOT}/node_modules.nosync"
  run ln -s node_modules.nosync "${ROOT}/node_modules"
fi
run "${BUN}" install --cwd "${ROOT}"

step "3/5" "找 Claude Code CLI（优先桌面应用内置的最高版本，其次 PATH 里的 claude）"
CLAUDE=""
DESKTOP="$(ls -d "${HOME}/Library/Application Support/Claude/claude-code/"*/*/claude.app/Contents/MacOS/claude 2>/dev/null | sort -V | tail -1 || true)"
if [ -n "${DESKTOP}" ] && [ -x "${DESKTOP}" ]; then
  CLAUDE="${DESKTOP}"
  echo "  桌面内置：${CLAUDE}"
elif command -v claude >/dev/null 2>&1; then
  CLAUDE="$(command -v claude)"
  echo "  PATH：${CLAUDE}"
else
  echo "  没找到 claude CLI：装好 Claude 桌面应用或 Claude Code 后重跑；下面的命令先用 claude 占位"
  if [ "${DRY}" = 0 ]; then SKIP_MCP=1; SKIP_PLUGIN=1; fi
  CLAUDE="claude"
fi

step "4/5" "注册 user 级 MCP（任何会话都能用 heliu_* 工具）"
if [ "${SKIP_MCP}" = 1 ]; then
  echo "  跳过（默认只装插件；需要 user 级 MCP 请加 --with-mcp）"
else
  run "${CLAUDE}" mcp add -s user heliu -- "${ROOT}/bin/heliu" mcp
fi

step "5/5" "本地 marketplace + 插件（/heliu Skill、hooks、插件自带 MCP）"
if [ "${SKIP_PLUGIN}" = 1 ]; then
  echo "  跳过（--no-plugin 或没有 claude CLI）"
else
  # 本仓库根就是 marketplace 根（.claude-plugin/marketplace.json，插件 source "./"），原地加载，改代码不用重装
  run "${CLAUDE}" plugin marketplace add "${ROOT}"
  run "${CLAUDE}" plugin install "${PLUGIN}@${MARKETPLACE}"
fi

printf '\n完成%s。验证：\n' "$([ "${DRY}" = 1 ] && echo "（演练，未执行）" || true)"
printf '  %s mcp list       # 应看到 heliu ✔ Connected\n' "$(q "${CLAUDE}")"
printf '  %s plugin list    # 应看到 %s\n' "$(q "${CLAUDE}")" "${PLUGIN}@${MARKETPLACE}"
printf '  %s doctor         # 环境自检\n' "$(q "${ROOT}/bin/heliu")"
printf '打开看板：\n  %s board --project <项目名>\n' "$(q "${ROOT}/bin/heliu")"
printf '接入新项目：\n  %s project add <仓库路径>\n' "$(q "${ROOT}/bin/heliu")"
if [ "${SKIP_MCP}" = 0 ] && [ "${SKIP_PLUGIN}" = 0 ]; then
  echo "说明：heliu 工具由插件自带的 MCP（plugin:heliu:heliu）提供；若另加了 --with-mcp，会话里会出现两份同名工具。"
fi

mcp: cua_repl/js started
mcp: cua_repl/js (completed)
exec
/bin/zsh -lc "curl -fsS http://127.0.0.1:7797/api/overview -o /tmp/heliu-r3-overview.json; python3 - <<'PY'
import json
x=json.load(open('/tmp/heliu-r3-overview.json'));print(json.dumps(x,ensure_ascii=False)[:16000])
PY
cat src/board/baseline.ts; cat src/hooks/handler.ts; command -v bun; ls ../M5-r3-7ec4392-heliu-home/projects" in /var/folders/bw/xbf2cw9s1bz8_nc3h2wlz6yc0000gn/T/heliu-accept/M5-r3-7ec4392
