  standalone: "claude/bold-shaw-cccccc",
  behind: "claude/behind-dddddd",
  conflict: "claude/conflict-ffffff",
  atTip: "claude/at-tip-999999",
} as const;

export function buildFixture(): Fixture {
  tick = 0;
