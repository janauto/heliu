  const repo = join(root, "磁吸 仓库");
  mkdirSync(repo);
  gitW(repo, "init", "-q", "-b", "main");
  gitW(repo, "config", "commit.gpgsign", "false");

  // 主线 c1..c3
  const c1 = commit(repo, "README.md", "# 项目\n\n第一版\n", "c1: 初始化");
